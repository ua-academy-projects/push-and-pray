# Host-local defaults use loopback. In Vagrant or production, use the History
# and Redis addresses reachable from the UI process.
HISTORY_SERVICE_URL=http://127.0.0.1:8002
HISTORY_CONNECT_TIMEOUT_SECONDS=3
HISTORY_READ_TIMEOUT_SECONDS=5
HISTORY_WRITE_TIMEOUT_SECONDS=5
HISTORY_POOL_TIMEOUT_SECONDS=3
HISTORY_OPERATION_TIMEOUT_SECONDS=10

REDIS_HOST=192.168.100.14
REDIS_PORT=6379
REDIS_DB=0
# Leave credentials empty only for a trusted local Redis without ACLs.
# Use a restricted Redis user and secret supplied at runtime in production.
REDIS_USERNAME=aegis_ui
REDIS_PASSWORD=replace-with-ui-redis-password
REDIS_CONNECTION_TIMEOUT_SECONDS=3

# Redis contains only expiring anonymous UI theme state.
REDIS_THEME_PREFIX=theme
REDIS_THEME_TTL_SECONDS=2592000
UI_SESSION_COOKIE_NAME=theme_session
# false is suitable for host-local HTTP and the current HTTP-only Vagrant setup.
# Set true whenever production cookies must travel only over HTTPS.
UI_SESSION_COOKIE_SECURE=false

# The implemented default theme is dark and is not environment-configurable.
