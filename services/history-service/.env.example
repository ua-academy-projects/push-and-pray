# Host-local defaults use loopback. In Vagrant or production, use the MariaDB,
# Provider, and RabbitMQ addresses reachable from History API and consumer.
MARIADB_HOST=192.168.100.14
MARIADB_PORT=3306
MARIADB_DATABASE=aegis_history
MARIADB_USER=aegis_history
MARIADB_PASSWORD=replace-with-history-database-password

# Synchronous manual lookups only.
PROVIDER_SERVICE_URL=http://127.0.0.1:8001
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=10
PROVIDER_WRITE_TIMEOUT_SECONDS=5
PROVIDER_POOL_TIMEOUT_SECONDS=5

# Asynchronous blacklist snapshot consumption. Enable in the single deployed
# History container; keep disabled for ordinary unit tests.
BLACKLIST_CONSUMER_ENABLED=false
# Local RabbitMQ may use "/"; production should use a dedicated virtual host
# and a consumer account distinct from Provider's publisher account.
RABBITMQ_HOST=192.168.100.14
RABBITMQ_PORT=5672
RABBITMQ_VIRTUAL_HOST=/aegis
RABBITMQ_USERNAME=aegis_history
RABBITMQ_PASSWORD=replace-with-history-consumer-password
RABBITMQ_EXCHANGE_NAME=aegis.blacklist
RABBITMQ_QUEUE_NAME=aegis.history.blacklist.snapshots
RABBITMQ_ROUTING_KEY=blacklist.snapshot.complete
RABBITMQ_RETRY_EXCHANGE_NAME=aegis.blacklist.retry
RABBITMQ_DEAD_LETTER_EXCHANGE_NAME=aegis.blacklist.dead
RABBITMQ_DEAD_LETTER_QUEUE_NAME=aegis.history.blacklist.snapshots.dead
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_SHUTDOWN_TIMEOUT_SECONDS=30

# Consumer retry delays are currently fixed at 300, 900, 1800, and 3600
# seconds; only the topology names and RabbitMQ timeouts are configurable.
BLACKLIST_STALE_AFTER_SECONDS=43200
