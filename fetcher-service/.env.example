# Weather Fetcher Service configuration.
# Copy to .env and adjust for local development.
# Never commit a real .env file.

# --- External dependencies ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
BACKEND_INTERNAL_BASE_URL=http://localhost:8000
HTTP_TIMEOUT_SECONDS=10

# --- RabbitMQ (async push of completed/failed syncs to the Backend) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_SYNC_QUEUE=weather.sync
RABBITMQ_SYNC_FAILURE_QUEUE=weather.sync_failure
RABBITMQ_DEAD_LETTER_EXCHANGE=weather.dlx

# --- Fixed location (Ivano-Frankivsk) ---
WEATHER_LOCATION_NAME=Ivano-Frankivsk
WEATHER_COUNTRY=Ukraine
WEATHER_LATITUDE=48.9226
WEATHER_LONGITUDE=24.7111
WEATHER_TIMEZONE=Europe/Kyiv

# --- Open-Meteo request window ---
WEATHER_PAST_DAYS=10
WEATHER_FORECAST_DAYS=10

# --- Synchronization ---
WEATHER_SYNC_ENABLED=true
WEATHER_SYNC_INTERVAL_MINUTES=60
WEATHER_SYNC_ON_STARTUP=true
WEATHER_SYNC_STARTUP_FRESHNESS_MINUTES=60

# --- Web server ---
FETCHER_PORT=8002
