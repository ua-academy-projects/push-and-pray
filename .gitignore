# Python creates these folders when it imports modules.
__pycache__/
*.py[cod]

# Local virtual environments and editor settings.
.venv/
.venv-1/
.vagrant/
.ssh/
.vscode/
.idea/

# Local deployment secrets. Commit deploy.env.example, never deploy.env.
deploy.env

# Caddy exports this public local-CA certificate after UI provisioning.
tls/*.crt

# Public half of the collector key is generated by Logging VM provisioning.
logging/wildlife-log-collector.pub

# Test and OS artefacts.
.pytest_cache/
.DS_Store
Thumbs.db
