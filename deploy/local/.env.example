# Local Linux smoke-test values only. Copy this file to deploy/local/.env.
# Replace the AbuseIPDB key before enabling the Provider worker.

MARIADB_DATABASE=aegis_history
MARIADB_USER=aegis_history
MARIADB_PASSWORD=local-history-database-password
MARIADB_ROOT_PASSWORD=local-mariadb-root-password
MARIADB_USER_HOST=%

ABUSEIPDB_BASE_URL=https://api.abuseipdb.com
ABUSEIPDB_API_KEY=replace-with-abuseipdb-api-key
ABUSEIPDB_CONNECT_TIMEOUT_SECONDS=5
ABUSEIPDB_READ_TIMEOUT_SECONDS=10
ABUSEIPDB_WRITE_TIMEOUT_SECONDS=5
ABUSEIPDB_POOL_TIMEOUT_SECONDS=5
ABUSEIPDB_OPERATION_TIMEOUT_SECONDS=20
BLACKLIST_POLLING_ENABLED=true
BLACKLIST_POLL_INTERVAL_SECONDS=21600
BLACKLIST_CONFIDENCE_MINIMUM=90

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VIRTUAL_HOST=/aegis
RABBITMQ_USERNAME=aegis_provider
RABBITMQ_PASSWORD=local-provider-rabbitmq-password
RABBITMQ_EXCHANGE_NAME=aegis.blacklist
RABBITMQ_ROUTING_KEY=blacklist.snapshot.complete
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_PUBLISH_RETRY_INITIAL_SECONDS=30
RABBITMQ_PUBLISH_RETRY_MAXIMUM_SECONDS=900
RABBITMQ_PUBLISH_MAX_ATTEMPTS=5

HISTORY_RABBITMQ_USERNAME=aegis_history
HISTORY_RABBITMQ_PASSWORD=local-history-rabbitmq-password
RABBITMQ_QUEUE_NAME=aegis.history.blacklist.snapshots
RABBITMQ_RETRY_EXCHANGE_NAME=aegis.blacklist.retry
RABBITMQ_DEAD_LETTER_EXCHANGE_NAME=aegis.blacklist.dead
RABBITMQ_DEAD_LETTER_QUEUE_NAME=aegis.history.blacklist.snapshots.dead
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_SHUTDOWN_TIMEOUT_SECONDS=30
BLACKLIST_STALE_AFTER_SECONDS=43200

PROVIDER_SERVICE_URL=http://provider-api:8001
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=10
PROVIDER_WRITE_TIMEOUT_SECONDS=5
PROVIDER_POOL_TIMEOUT_SECONDS=5

HISTORY_SERVICE_URL=http://history-api:8002
HISTORY_CONNECT_TIMEOUT_SECONDS=3
HISTORY_READ_TIMEOUT_SECONDS=5
HISTORY_WRITE_TIMEOUT_SECONDS=5
HISTORY_POOL_TIMEOUT_SECONDS=3
HISTORY_OPERATION_TIMEOUT_SECONDS=10

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=aegis_ui
REDIS_PASSWORD=local-ui-redis-password
REDIS_CONNECTION_TIMEOUT_SECONDS=3
REDIS_THEME_PREFIX=theme
REDIS_THEME_TTL_SECONDS=2592000
UI_SESSION_COOKIE_NAME=theme_session
UI_SESSION_COOKIE_SECURE=false

AEGIS_UI_IMAGE=aegis/ui-service:local
AEGIS_HISTORY_IMAGE=aegis/history-service:local
AEGIS_PROVIDER_IMAGE=aegis/provider-service:local
