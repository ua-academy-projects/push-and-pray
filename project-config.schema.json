{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for the non-secret project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "deployment_mode",
    "default_cloud",
    "default_location",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "database",
    "network",
    "service_ports",
    "bastion",
    "vms",
    "locations",
    "machine_types",
    "images",
    "disk_types"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./project-config.schema.json"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "deployment_mode": {
      "description": "Selects direct Docker Compose workloads or a K3s cluster.",
      "type": "string",
      "enum": ["compose", "k3s"]
    },
    "default_cloud": {
      "type": "string",
      "enum": ["gcp", "aws", "azure"]
    },
    "default_location": {
      "type": "string",
      "enum": ["west-europe", "stockholm", "ohio", "mexico"]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "username", "image_tag"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_tag": {
          "description": "OCI image tag used for all application images.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        }
      }
    },
    "database": {
      "$ref": "#/$defs/database"
    },
    "k3s": {
      "$ref": "#/$defs/k3s"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vpc_cidr",
        "public_subnet_cidr",
        "private_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "vpc_cidr": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "public_subnet_cidr": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "private_subnet_cidr": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "managed_database": {
          "$ref": "#/$defs/managed_database_network"
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [80, 443]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_api", "postgresql"],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "rabbitmq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "redis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "technitium_admin": {
          "description": "Private Technitium DNS administration port on the bastion.",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "monitoring": {
      "$ref": "#/$defs/monitoring"
    },
    "dns": {
      "$ref": "#/$defs/dns"
    },
    "bastion": {
      "$ref": "#/$defs/bastion"
    },
    "vms": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "not": {
        "required": ["bastion"]
      },
      "properties": {
        "infrastructure": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "tags": {
                  "contains": {
                    "const": "infrastructure"
                  }
                }
              },
              "required": ["tags"]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    },
    "cloud_settings": {
      "$ref": "#/$defs/cloud_settings"
    },
    "locations": {
      "$ref": "#/$defs/locations"
    },
    "machine_types": {
      "$ref": "#/$defs/machine_types"
    },
    "images": {
      "$ref": "#/$defs/images"
    },
    "disk_types": {
      "$ref": "#/$defs/disk_types"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "deployment_mode": { "const": "compose" } }, "required": ["deployment_mode"] },
      "then": {
        "required": ["monitoring"],
        "properties": {
          "service_ports": {
            "required": ["rabbitmq", "redis"]
          },
          "vms": {
            "required": ["infrastructure"],
            "additionalProperties": {
              "properties": {
                "tags": {
                  "items": {
                    "enum": ["infrastructure", "history", "fetcher", "ui"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "deployment_mode": { "const": "k3s" } }, "required": ["deployment_mode"] },
      "then": {
        "required": ["k3s"],
        "properties": {
          "default_cloud": { "const": "gcp" },
          "database": {
            "properties": {
              "mode": { "const": "self_managed" }
            }
          },
          "service_ports": {
            "required": ["technitium_admin"],
            "properties": {
              "postgresql": { "const": 5432 }
            }
          },
          "vms": {
            "minProperties": 5,
            "additionalProperties": {
              "properties": {
                "tags": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "enum": ["k3s-server", "k3s-agent"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "default_cloud": { "const": "gcp" } }, "required": ["default_cloud"] },
      "then": {
        "required": ["cloud_settings"],
        "properties": {
          "cloud_settings": { "required": ["gcp"] },
          "monitoring": { "required": ["gcp"] },
          "locations": { "properties": { "west-europe": { "required": ["gcp"] }, "stockholm": { "required": ["gcp"] }, "ohio": { "required": ["gcp"] }, "mexico": { "required": ["gcp"] } } },
          "machine_types": { "properties": { "micro": { "required": ["gcp"] }, "small": { "required": ["gcp"] }, "medium": { "required": ["gcp"] } } },
          "images": { "properties": { "ubuntu_2404": { "required": ["gcp"] }, "ubuntu_2604": { "required": ["gcp"] } } },
          "disk_types": { "properties": { "general_purpose": { "required": ["gcp"] }, "performance": { "required": ["gcp"] } } }
        }
      }
    },
    {
      "if": { "properties": { "default_cloud": { "const": "aws" } }, "required": ["default_cloud"] },
      "then": {
        "properties": {
          "monitoring": { "required": ["aws"] },
          "locations": { "properties": { "west-europe": { "required": ["aws"] }, "stockholm": { "required": ["aws"] }, "ohio": { "required": ["aws"] }, "mexico": { "required": ["aws"] } } },
          "machine_types": { "properties": { "micro": { "required": ["aws"] }, "small": { "required": ["aws"] }, "medium": { "required": ["aws"] } } },
          "images": { "properties": { "ubuntu_2404": { "required": ["aws"] }, "ubuntu_2604": { "required": ["aws"] } } },
          "disk_types": { "properties": { "general_purpose": { "required": ["aws"] }, "performance": { "required": ["aws"] } } }
        }
      }
    },
    {
      "if": { "properties": { "default_cloud": { "const": "azure" } }, "required": ["default_cloud"] },
      "then": {
        "required": ["cloud_settings"],
        "properties": {
          "cloud_settings": { "required": ["azure"] },
          "monitoring": { "required": ["azure"] },
          "locations": { "properties": { "west-europe": { "required": ["azure"] }, "stockholm": { "required": ["azure"] }, "ohio": { "required": ["azure"] }, "mexico": { "required": ["azure"] } } },
          "machine_types": { "properties": { "micro": { "required": ["azure"] }, "small": { "required": ["azure"] }, "medium": { "required": ["azure"] } } },
          "images": { "properties": { "ubuntu_2404": { "required": ["azure"] }, "ubuntu_2604": { "required": ["azure"] } } },
          "disk_types": { "properties": { "general_purpose": { "required": ["azure"] }, "performance": { "required": ["azure"] } } }
        }
      }
    },
    {
      "if": { "properties": { "default_cloud": { "const": "gcp" }, "database": { "properties": { "mode": { "const": "managed" } }, "required": ["mode"] } }, "required": ["default_cloud", "database"] },
      "then": { "properties": { "network": { "properties": { "managed_database": { "required": ["gcp_private_service_cidr"] } } } } }
    },
    {
      "if": { "properties": { "default_cloud": { "const": "aws" }, "database": { "properties": { "mode": { "const": "managed" } }, "required": ["mode"] } }, "required": ["default_cloud", "database"] },
      "then": { "properties": { "network": { "properties": { "managed_database": { "required": ["aws_private_subnet_cidrs"] } } } } }
    },
    {
      "if": { "properties": { "default_cloud": { "const": "azure" }, "database": { "properties": { "mode": { "const": "managed" } }, "required": ["mode"] } }, "required": ["default_cloud", "database"] },
      "then": {
        "properties": {
          "database": { "properties": { "storage_gb": { "minimum": 32 } } },
          "network": { "properties": { "managed_database": { "required": ["azure_delegated_subnet_cidr"] } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "database": {
            "properties": {
              "mode": {
                "const": "managed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "network": { "required": ["managed_database"] },
          "vms": {
            "properties": {
              "infrastructure": {
                "properties": {
                  "secret_mappings": {
                    "required": ["RABBITMQ_PASSWORD", "REDIS_PASSWORD"]
                  }
                }
              },
              "history": {
                "properties": {
                  "secret_mappings": {
                    "required": ["RABBITMQ_PASSWORD"]
                  }
                }
              },
              "fetcher": {
                "properties": {
                  "secret_mappings": {
                    "required": ["RABBITMQ_PASSWORD"]
                  }
                }
              },
              "ui": {
                "properties": {
                  "secret_mappings": {
                    "required": ["REDIS_PASSWORD"]
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "vms": {
            "additionalProperties": {
              "properties": {
                "secret_mappings": {
                  "not": {
                    "anyOf": [
                      {
                        "required": ["RABBITMQ_PASSWORD"]
                      },
                      {
                        "required": ["REDIS_PASSWORD"]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "bastion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_type",
        "image",
        "internal_ip",
        "boot_disk",
        "ssh_port",
        "allowed_cidrs"
      ],
      "properties": {
        "cloud": {
          "type": "string",
          "enum": ["gcp", "aws", "azure"]
        },
        "location": {
          "type": "string",
          "enum": ["west-europe", "stockholm", "ohio", "mexico"]
        },
        "machine_type": {
          "type": "string",
          "enum": ["micro", "small", "medium"]
        },
        "image": {
          "type": "string",
          "enum": ["ubuntu_2404", "ubuntu_2604"]
        },
        "internal_ip": {
          "$ref": "#/$defs/ipv4_address"
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ipv4_cidr"
          }
        }
      }
    },
    "database": {
      "description": "Selects the PostgreSQL deployment architecture and its non-secret settings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["self_managed", "managed"]
        },
        "version": {
          "description": "PostgreSQL major version for a provider-managed database.",
          "type": "string",
          "const": "18"
        },
        "size": {
          "description": "Compute size for a provider-managed database.",
          "type": "string",
          "enum": ["micro", "small", "medium"]
        },
        "storage_gb": {
          "description": "Provider-managed PostgreSQL storage allocation in GB; the shared minimum accommodates RDS PostgreSQL gp3.",
          "type": "integer",
          "minimum": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "managed"
              }
            }
          },
          "then": {
            "required": ["version", "size", "storage_gb"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["version"]
                },
                {
                  "required": ["size"]
                },
                {
                  "required": ["storage_gb"]
                }
              ]
            }
          }
        }
      ]
    },
    "k3s": {
      "description": "K3s cluster networking shared by Terraform and Ansible.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "api_server",
        "cluster_cidr",
        "service_cidr",
        "cluster_dns",
        "flannel_backend",
        "application",
        "private_services",
        "data_services",
        "secret_mappings"
      ],
      "properties": {
        "version": {
          "description": "Pinned K3s release installed by Ansible.",
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$"
        },
        "api_server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["internal_ip", "port"],
          "properties": {
            "internal_ip": { "$ref": "#/$defs/ipv4_address" },
            "port": { "type": "integer", "const": 6443 }
          }
        },
        "cluster_cidr": { "$ref": "#/$defs/ipv4_cidr" },
        "service_cidr": { "$ref": "#/$defs/ipv4_cidr" },
        "cluster_dns": { "$ref": "#/$defs/ipv4_address" },
        "flannel_backend": {
          "description": "K3s pod-network backend; Terraform opens only the corresponding node-to-node traffic.",
          "type": "string",
          "enum": ["vxlan"]
        },
        "application": {
          "description": "Cluster-local namespace and public endpoint for the OilScope application.",
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "hostname", "acme_email"],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        },
        "private_services": {
          "description": "Private web endpoints resolved by the tailnet's split DNS service.",
          "type": "object",
          "additionalProperties": false,
          "required": ["headlamp", "homepage", "technitium"],
          "properties": {
            "headlamp": {
              "$ref": "#/$defs/private_web_service"
            },
            "homepage": {
              "$ref": "#/$defs/private_web_service"
            },
            "technitium": {
              "$ref": "#/$defs/private_web_service"
            }
          }
        },
        "data_services": {
          "description": "Persistent data-service sizing for the K3s application deployment.",
          "type": "object",
          "additionalProperties": false,
          "required": ["postgresql"],
          "properties": {
            "postgresql": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instances", "storage_gb"],
              "properties": {
                "instances": { "type": "integer", "minimum": 2 },
                "storage_gb": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings",
          "required": [
            "POSTGRES_PASSWORD",
            "OILPRICEAPI_KEY",
            "GHCR_TOKEN"
          ]
        }
      }
    },
    "private_web_service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname"],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
        }
      }
    },
    "managed_database_network": {
      "description": "Private address space reserved for provider-managed PostgreSQL.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp_private_service_cidr": {
          "allOf": [
            {
              "$ref": "#/$defs/ipv4_cidr"
            },
            {
              "pattern": "/24$"
            }
          ]
        },
        "aws_private_subnet_cidrs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ipv4_cidr"
          }
        },
        "azure_delegated_subnet_cidr": {
          "description": "Dedicated Azure subnet delegated to PostgreSQL Flexible Server; Azure requires at least a /28.",
          "allOf": [
            {
              "$ref": "#/$defs/ipv4_cidr"
            },
            {
              "pattern": "/(?:[0-9]|1[0-9]|2[0-8])$"
            }
          ]
        }
      }
    },
    "ipv4_address": {
      "type": "string",
      "format": "ipv4"
    },
    "ipv4_cidr": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])$"
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["log_retention_days", "notification_topic_arns"],
          "properties": {
            "log_retention_days": {
              "type": "integer",
              "enum": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653]
            },
            "notification_topic_arns": {
              "description": "Existing SNS topic ARNs keyed by AWS region. Subscribe the same operator email to every topic used by this deployment.",
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^arn:(aws|aws-us-gov|aws-cn):sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["notification_channel_id"],
          "properties": {
            "notification_channel_id": {
              "description": "Existing Cloud Monitoring notification channel resource name, or null to create policies without notifications.",
              "type": ["string", "null"],
              "pattern": "^projects/[^/]+/notificationChannels/[^/]+$"
            }
          }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["log_retention_days", "daily_ingestion_limit_gb", "notification_email"],
          "properties": {
            "log_retention_days": {
              "type": "integer",
              "minimum": 30,
              "maximum": 730
            },
            "daily_ingestion_limit_gb": {
              "description": "Daily Log Analytics ingestion cap in GB; use -1 to disable the cap.",
              "type": "number",
              "minimum": -1
            },
            "notification_email": {
              "description": "Email receiver for the Terraform-managed Azure Monitor action group, or null for alerts without notification actions.",
              "type": ["string", "null"],
              "format": "email"
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloudflare"],
      "properties": {
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone_id"],
          "properties": {
            "zone_id": {
              "description": "Non-secret identifier of the Cloudflare zone containing the public UI hostname.",
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        }
      }
    },
    "cloud_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id"],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            }
          }
        },
        "azure": {
          "description": "Non-secret Azure deployment target.",
          "type": "object",
          "additionalProperties": false,
          "required": ["subscription_id"],
          "properties": {
            "subscription_id": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    "provider_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "zone"],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "zone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "azure_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "zone": { "type": "string", "enum": ["1", "2", "3"] }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "$ref": "#/$defs/provider_location"
        },
        "aws": {
          "$ref": "#/$defs/provider_location"
        },
        "azure": {
          "$ref": "#/$defs/azure_location"
        }
      }
    },
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "west-europe": {
          "$ref": "#/$defs/location"
        },
        "stockholm": {
          "$ref": "#/$defs/location"
        },
        "ohio": {
          "$ref": "#/$defs/location"
        },
        "mexico": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "cloud_string_values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "string",
          "minLength": 1
        },
        "aws": {
          "type": "string",
          "minLength": 1
        },
        "azure": {
          "type": "string",
          "pattern": "^Standard_[A-Za-z0-9_]+$"
        }
      }
    },
    "machine_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["micro", "small", "medium"],
      "properties": {
        "micro": {
          "$ref": "#/$defs/cloud_string_values"
        },
        "small": {
          "$ref": "#/$defs/cloud_string_values"
        },
        "medium": {
          "$ref": "#/$defs/cloud_string_values"
        }
      }
    },
    "gcp_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "family"],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aws_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssm_parameter"],
      "properties": {
        "ssm_parameter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "azure_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "offer", "sku", "version"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "offer": { "type": "string", "minLength": 1 },
        "sku": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "$ref": "#/$defs/gcp_image"
        },
        "aws": {
          "$ref": "#/$defs/aws_image"
        },
        "azure": {
          "$ref": "#/$defs/azure_image"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ubuntu_2404", "ubuntu_2604"],
      "properties": {
        "ubuntu_2404": {
          "$ref": "#/$defs/image"
        },
        "ubuntu_2604": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "gcp_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["pd-balanced", "pd-ssd"]
        }
      }
    },
    "aws_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["gp3", "io2"]
        },
        "iops": {
          "type": "integer",
          "minimum": 100,
          "maximum": 256000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "io2"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["iops"]
          }
        }
      ]
    },
    "azure_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["StandardSSD_LRS", "Premium_LRS"] }
      }
    },
    "disk_type": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "$ref": "#/$defs/gcp_disk"
        },
        "aws": {
          "$ref": "#/$defs/aws_disk"
        },
        "azure": {
          "$ref": "#/$defs/azure_disk"
        }
      }
    },
    "disk_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["general_purpose", "performance"],
      "properties": {
        "general_purpose": {
          "$ref": "#/$defs/disk_type"
        },
        "performance": {
          "$ref": "#/$defs/disk_type"
        }
      }
    },
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_gb", "disk_type"],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "disk_type": {
          "type": "string",
          "enum": ["general_purpose", "performance"]
        },
        "iops": {
          "description": "Optional per-VM IOPS override for disk types that support provisioned IOPS.",
          "type": "integer",
          "minimum": 100,
          "maximum": 256000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disk_type": {
                "const": "general_purpose"
              }
            },
            "required": ["disk_type"]
          },
          "then": {
            "not": {
              "required": ["iops"]
            }
          }
        }
      ]
    },
    "data_disks": {
      "description": "Optional additional persistent disks keyed by a stable logical device name.",
      "type": "object",
      "maxProperties": 11,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/boot_disk"
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_tags": {
      "description": "Functional VM classifications used for network policy and Ansible inventory groups.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["infrastructure", "history", "fetcher", "ui", "k3s-server", "k3s-agent"]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_type",
        "image",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "tags",
        "secret_mappings"
      ],
      "properties": {
        "cloud": {
          "type": "string",
          "enum": ["gcp", "aws", "azure"]
        },
        "location": {
          "type": "string",
          "enum": ["west-europe", "stockholm", "ohio", "mexico"]
        },
        "machine_type": {
          "type": "string",
          "enum": ["micro", "small", "medium"]
        },
        "image": {
          "type": "string",
          "enum": ["ubuntu_2404", "ubuntu_2604"]
        },
        "internal_ip": {
          "$ref": "#/$defs/ipv4_address"
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "data_disks": {
          "$ref": "#/$defs/data_disks"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/vm_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "acme_email"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tags": {
                "contains": {
                  "const": "ui"
                }
              }
            },
            "required": ["tags"]
          },
          "then": {
            "required": ["public_endpoint"]
          }
        }
      ]
    }
  }
}
