{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for the non-secret project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "default_cloud",
    "default_location",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "service_ports",
    "monitoring",
    "vms",
    "cloud_settings",
    "locations",
    "machine_types",
    "images",
    "disk_types"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./project-config.schema.json"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "default_cloud": {
      "type": "string",
      "enum": ["gcp", "aws"]
    },
    "default_location": {
      "type": "string",
      "enum": ["stockholm", "ohio", "mexico"]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "username", "image_tag"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_tag": {
          "description": "OCI image tag containing the Git commit SHA used to build the images.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vpc_cidr",
        "public_subnet_cidr",
        "private_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "vpc_cidr": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "public_subnet_cidr": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "private_subnet_cidr": {
          "$ref": "#/$defs/ipv4_cidr"
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [80, 443]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_api", "postgresql"],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "monitoring": {
      "$ref": "#/$defs/monitoring"
    },
    "dns": {
      "$ref": "#/$defs/dns"
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": ["bastion"],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "tags": {
                  "contains": {
                    "const": "bastion"
                  }
                }
              },
              "required": ["tags"]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    },
    "cloud_settings": {
      "$ref": "#/$defs/cloud_settings"
    },
    "locations": {
      "$ref": "#/$defs/locations"
    },
    "machine_types": {
      "$ref": "#/$defs/machine_types"
    },
    "images": {
      "$ref": "#/$defs/images"
    },
    "disk_types": {
      "$ref": "#/$defs/disk_types"
    }
  },
  "$defs": {
    "ipv4_address": {
      "type": "string",
      "format": "ipv4"
    },
    "ipv4_cidr": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])$"
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aws", "gcp"],
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["log_retention_days", "notification_topic_arns"],
          "properties": {
            "log_retention_days": {
              "type": "integer",
              "enum": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653]
            },
            "notification_topic_arns": {
              "description": "Existing SNS topic ARNs keyed by AWS region. Subscribe the same operator email to every topic used by this deployment.",
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^arn:(aws|aws-us-gov|aws-cn):sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["notification_channel_id"],
          "properties": {
            "notification_channel_id": {
              "description": "Existing Cloud Monitoring notification channel resource name, or null to create policies without notifications.",
              "type": ["string", "null"],
              "pattern": "^projects/[^/]+/notificationChannels/[^/]+$"
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloudflare"],
      "properties": {
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone_id"],
          "properties": {
            "zone_id": {
              "description": "Non-secret identifier of the Cloudflare zone containing the public UI hostname.",
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        }
      }
    },
    "cloud_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp"],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id"],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            }
          }
        }
      }
    },
    "provider_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "zone"],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "zone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "$ref": "#/$defs/provider_location"
        },
        "aws": {
          "$ref": "#/$defs/provider_location"
        }
      }
    },
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stockholm", "ohio", "mexico"],
      "properties": {
        "stockholm": {
          "$ref": "#/$defs/location"
        },
        "ohio": {
          "$ref": "#/$defs/location"
        },
        "mexico": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "cloud_string_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "type": "string",
          "minLength": 1
        },
        "aws": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "machine_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["micro", "small", "medium"],
      "properties": {
        "micro": {
          "$ref": "#/$defs/cloud_string_values"
        },
        "small": {
          "$ref": "#/$defs/cloud_string_values"
        },
        "medium": {
          "$ref": "#/$defs/cloud_string_values"
        }
      }
    },
    "gcp_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "family"],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aws_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssm_parameter"],
      "properties": {
        "ssm_parameter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "$ref": "#/$defs/gcp_image"
        },
        "aws": {
          "$ref": "#/$defs/aws_image"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ubuntu_2404", "ubuntu_2604"],
      "properties": {
        "ubuntu_2404": {
          "$ref": "#/$defs/image"
        },
        "ubuntu_2604": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "gcp_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["pd-balanced", "pd-ssd"]
        }
      }
    },
    "aws_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["gp3", "io2"]
        },
        "iops": {
          "type": "integer",
          "minimum": 100,
          "maximum": 256000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "io2"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["iops"]
          }
        }
      ]
    },
    "disk_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "$ref": "#/$defs/gcp_disk"
        },
        "aws": {
          "$ref": "#/$defs/aws_disk"
        }
      }
    },
    "disk_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["general_purpose", "performance"],
      "properties": {
        "general_purpose": {
          "$ref": "#/$defs/disk_type"
        },
        "performance": {
          "$ref": "#/$defs/disk_type"
        }
      }
    },
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_gb", "disk_type"],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "disk_type": {
          "type": "string",
          "enum": ["general_purpose", "performance"]
        },
        "iops": {
          "description": "Optional per-VM IOPS override for disk types that support provisioned IOPS.",
          "type": "integer",
          "minimum": 100,
          "maximum": 256000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disk_type": {
                "const": "general_purpose"
              }
            },
            "required": ["disk_type"]
          },
          "then": {
            "not": {
              "required": ["iops"]
            }
          }
        }
      ]
    },
    "data_disks": {
      "description": "Optional additional persistent disks keyed by a stable logical device name.",
      "type": "object",
      "maxProperties": 11,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/boot_disk"
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_tags": {
      "description": "Functional VM classifications used for network policy and Ansible inventory groups.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bastion", "database", "history", "fetcher", "ui"]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_type",
        "image",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "tags",
        "secret_mappings"
      ],
      "properties": {
        "cloud": {
          "type": "string",
          "enum": ["gcp", "aws"]
        },
        "location": {
          "type": "string",
          "enum": ["stockholm", "ohio", "mexico"]
        },
        "machine_type": {
          "type": "string",
          "enum": ["micro", "small", "medium"]
        },
        "image": {
          "type": "string",
          "enum": ["ubuntu_2404", "ubuntu_2604"]
        },
        "internal_ip": {
          "$ref": "#/$defs/ipv4_address"
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "data_disks": {
          "$ref": "#/$defs/data_disks"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/vm_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ipv4_cidr"
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "acme_email"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": {
              "tags": {
                "contains": {
                  "enum": ["bastion", "ui"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tags": {
                "contains": {
                  "const": "bastion"
                }
              }
            },
            "required": ["tags"]
          },
          "then": {
            "required": ["ssh_port", "allowed_cidrs"],
            "properties": {
              "assign_public_ip": {
                "const": true
              },
              "secret_mappings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["ssh_port"]
                },
                {
                  "required": ["allowed_cidrs"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tags": {
                "contains": {
                  "const": "ui"
                }
              }
            },
            "required": ["tags"]
          },
          "then": {
            "required": ["public_endpoint"]
          }
        }
      ]
    }
  }
}
