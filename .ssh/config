# ==============================================================================
# SSH Configuration File
# Project: Weather App Infrastructure VMs
# ==============================================================================

# ------------------------------------------------------------------------------
# Global SSH settings
# ------------------------------------------------------------------------------
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3

    ControlMaster auto
    ControlPersist 10m

    PubkeyAuthentication yes
    IdentitiesOnly no
    ForwardAgent no

# ------------------------------------------------------------------------------
# Database VM
# ------------------------------------------------------------------------------
Host database db database.local
    HostName database.local
    User admin

    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

# ------------------------------------------------------------------------------
# Provider Service VM
# ------------------------------------------------------------------------------
Host provider-service provider provider-service.local
    HostName provider-service.local
    User admin

    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

# ------------------------------------------------------------------------------
# Backend Service VM
# ------------------------------------------------------------------------------
Host backend-service backend backend-service.local
    HostName backend-service.local
    User admin

    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

# ------------------------------------------------------------------------------
# UI Service VM
# ------------------------------------------------------------------------------
Host ui-service ui ui-service.local
    HostName ui-service.local
    User admin

    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR