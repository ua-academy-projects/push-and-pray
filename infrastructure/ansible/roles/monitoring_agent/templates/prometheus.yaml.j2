global:
  scrape_interval: {{ monitoring_agent_interval_seconds }}s
  scrape_timeout: 10s

scrape_configs:
  - job_name: rabbitmq
    static_configs:
      - targets:
          - 127.0.0.1:{{ oilscope_config.services.rabbitmq.metrics_port }}
  - job_name: redis
    static_configs:
      - targets:
          - 127.0.0.1:{{ oilscope_config.services.redis.metrics_port }}
