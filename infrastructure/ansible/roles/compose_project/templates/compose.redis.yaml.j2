name: oilscope-redis

services:
  redis:
    image: "{{ oilscope_config.services.redis.image }}"
    restart: unless-stopped
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
    command:
      - sh
      - -ec
      - exec redis-server --appendonly yes --requirepass "$${REDIS_PASSWORD}"
    ports:
      - "${REDIS_BIND_ADDRESS:-0.0.0.0}:{{ oilscope_config.services.redis.port }}:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$${REDIS_PASSWORD}\" ping | grep -qx PONG"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 10s
    stop_grace_period: 20s
    logging:
      driver: journald
      options:
        tag: oilscope/redis

  redis-exporter:
    image: "{{ oilscope_config.services.redis.exporter_image }}"
    restart: unless-stopped
    environment:
      REDIS_ADDR: redis://redis:6379
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
    ports:
      - "127.0.0.1:{{ oilscope_config.services.redis.metrics_port }}:9121"
    depends_on:
      redis:
        condition: service_healthy
    read_only: true
    security_opt:
      - no-new-privileges:true
    logging:
      driver: journald
      options:
        tag: oilscope/redis-exporter

volumes:
  redis_data:
    name: oilscope-redis-data
