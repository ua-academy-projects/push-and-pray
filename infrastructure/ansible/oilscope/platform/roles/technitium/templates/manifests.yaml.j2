---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ technitium_namespace }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ technitium_name }}
  namespace: {{ technitium_namespace }}
  labels:
    app.kubernetes.io/name: {{ technitium_name }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ technitium_name }}
  ports:
    - name: dns-udp
      port: 53
      protocol: UDP
      targetPort: dns-udp
    - name: dns-tcp
      port: 53
      protocol: TCP
      targetPort: dns-tcp
    - name: http
      port: 5380
      protocol: TCP
      targetPort: http
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ technitium_name }}
  namespace: {{ technitium_namespace }}
  labels:
    app.kubernetes.io/name: {{ technitium_name }}
spec:
  serviceName: {{ technitium_name }}
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ technitium_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ technitium_name }}
    spec:
      containers:
        - name: technitium
          image: {{ technitium_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: DNS_SERVER_DOMAIN
              value: {{ technitium_domain | quote }}
            - name: DNS_SERVER_ADMIN_PASSWORD_FILE
              value: /run/technitium-secrets/admin-password
            - name: DNS_SERVER_RECURSION
              value: UseSpecifiedNetworkACL
            - name: DNS_SERVER_RECURSION_NETWORK_ACL
              value: {{ technitium_recursion_network_acl | quote }}
            - name: DNS_SERVER_LOG_MAX_LOG_FILE_DAYS
              value: "7"
            - name: DNS_SERVER_STATS_MAX_STAT_FILE_DAYS
              value: "30"
          ports:
            - name: dns-udp
              containerPort: 53
              protocol: UDP
            - name: dns-tcp
              containerPort: 53
              protocol: TCP
            - name: http
              containerPort: 5380
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /api/status
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /api/status
              port: http
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          resources:
            requests:
              cpu: {{ technitium_cpu_request }}
              memory: {{ technitium_memory_request }}
            limits:
              cpu: {{ technitium_cpu_limit }}
              memory: {{ technitium_memory_limit }}
          volumeMounts:
            - name: data
              mountPath: /etc/dns
            - name: admin-credentials
              mountPath: /run/technitium-secrets
              readOnly: true
      volumes:
        - name: admin-credentials
          secret:
            secretName: {{ technitium_admin_secret_name }}
            items:
              - key: admin-password
                path: admin-password
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes:
          - ReadWriteOnce
        storageClassName: {{ technitium_storage_class }}
        resources:
          requests:
            storage: {{ technitium_storage_size }}
