apiVersion: v1
kind: Namespace
metadata:
  name: {{ kubernetes_platform_config.kubernetes.namespace | default('oilscope') }}
---
apiVersion: v1
kind: Secret
metadata:
  name: oilscope-application
  namespace: {{ kubernetes_platform_config.kubernetes.namespace | default('oilscope') }}
type: Opaque
stringData:
{% for result in kubernetes_platform_secret_values.results %}
  {{ result.item.key }}: {{ result.stdout | trim | to_json }}
{% endfor %}
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-app-credentials
  namespace: {{ kubernetes_platform_config.kubernetes.namespace | default('oilscope') }}
type: kubernetes.io/basic-auth
stringData:
  username: {{ kubernetes_platform_config.database.user | to_json }}
  password: {{ (kubernetes_platform_secret_values.results | selectattr('item.key', 'equalto', 'POSTGRES_PASSWORD') | map(attribute='stdout') | first | trim) | to_json }}
---
apiVersion: v1
kind: Namespace
metadata:
  name: cert-manager
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: {{ (kubernetes_platform_secret_values.results | selectattr('item.key', 'equalto', 'CLOUDFLARE_API_TOKEN') | map(attribute='stdout') | first | trim) | to_json }}
