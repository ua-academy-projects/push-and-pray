apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-cloudflare
spec:
  acme:
    email: {{ kubernetes_platform_config.vms[groups.k3s_server[0] | regex_replace('^' ~ kubernetes_platform_config.name_prefix ~ '-' ~ kubernetes_platform_config.environment ~ '-', '')].public_endpoint.acme_email }}
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-cloudflare-account
    solvers:
      - dns01:
          cloudflare:
            apiTokenSecretRef:
              name: cloudflare-api-token
              key: api-token
