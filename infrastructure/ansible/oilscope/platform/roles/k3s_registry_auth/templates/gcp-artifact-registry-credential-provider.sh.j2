#!/usr/bin/env bash
set -euo pipefail

# Kubelet invokes this only for images matching the configured Artifact Registry
# hostname. The VM's own service account supplies a short-lived metadata token.
token="$(curl --fail --silent --show-error \
  --header 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token \
  | sed -nE 's/.*"access_token"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p')"

test -n "$token"
cat <<EOF
{"apiVersion":"credentialprovider.kubelet.k8s.io/v1","kind":"CredentialProviderResponse","cacheKeyType":"Registry","cacheDuration":"45m","auth":{"{{ k3s_registry_host }}":{"username":"oauth2accesstoken","password":"$token"}}}
EOF
