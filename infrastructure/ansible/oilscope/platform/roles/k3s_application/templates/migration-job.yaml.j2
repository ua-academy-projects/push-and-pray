apiVersion: batch/v1
kind: Job
metadata:
  name: oilscope-migrate
  namespace: {{ k3s_application_namespace }}
  labels:
    app.kubernetes.io/name: migration
    app.kubernetes.io/part-of: oilscope
spec:
  backoffLimit: 4
  ttlSecondsAfterFinished: 3600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: migration
    spec:
      restartPolicy: Never
      serviceAccountName: oilscope-workload
      containers:
        - name: migrate
          image: {{ k3s_application_registry_repository }}/database:{{ k3s_application_image_tag }}
          imagePullPolicy: Always
          command: ["petroscope-migrate"]
          env:
            - name: PGHOST
              valueFrom:
                configMapKeyRef:
                  name: oilscope-config
                  key: DATABASE_HOST
            - name: PGPORT
              valueFrom:
                configMapKeyRef:
                  name: oilscope-config
                  key: DATABASE_PORT
            - name: PGUSER
              valueFrom:
                configMapKeyRef:
                  name: oilscope-config
                  key: DATABASE_USER
            - name: PGDATABASE
              valueFrom:
                configMapKeyRef:
                  name: oilscope-config
                  key: DATABASE_NAME
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: oilscope-runtime
                  key: POSTGRES_PASSWORD
            - name: PGSSLMODE
              valueFrom:
                configMapKeyRef:
                  name: oilscope-config
                  key: DATABASE_SSLMODE
            - name: DATABASE_MODE
              valueFrom:
                configMapKeyRef:
                  name: oilscope-config
                  key: DATABASE_MODE
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 250m
              memory: 256Mi
