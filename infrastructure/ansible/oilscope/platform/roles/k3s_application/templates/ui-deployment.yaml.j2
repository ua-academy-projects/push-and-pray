apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ k3s_application_ui_name }}
  namespace: {{ k3s_application_namespace }}
  labels:
    app.kubernetes.io/name: {{ k3s_application_ui_name }}
    app.kubernetes.io/instance: {{ k3s_application_config.name_prefix }}
    app.kubernetes.io/part-of: {{ k3s_application_config.name_prefix }}
    app.kubernetes.io/managed-by: Ansible
spec:
  replicas: {{ k3s_application_ui_replicas }}
  revisionHistoryLimit: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ k3s_application_ui_name }}
      app.kubernetes.io/instance: {{ k3s_application_config.name_prefix }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ k3s_application_ui_name }}
        app.kubernetes.io/instance: {{ k3s_application_config.name_prefix }}
        app.kubernetes.io/part-of: {{ k3s_application_config.name_prefix }}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      imagePullSecrets:
        - name: {{ k3s_application_registry_secret_name }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: ui
          image: "{{ k3s_application_image_repository }}/ui:{{ k3s_application_image_tag }}"
          imagePullPolicy: {{ k3s_application_image_pull_policy }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          ports:
            - name: http
              containerPort: {{ k3s_application_ui_port }}
              protocol: TCP
          env:
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ k3s_application_secret_name }}
                  key: POSTGRES_PASSWORD
            - name: HISTORY_SERVICE_URL
              value: >-
                http://{{ k3s_application_history_name }}:{{ k3s_application_history_service_port }}
            - name: DATABASE_URL
              value: >-
                postgresql+psycopg://{{ k3s_application_postgresql_user }}:$(POSTGRES_PASSWORD)@{{ k3s_application_postgresql_host }}:{{ k3s_application_postgresql_port }}/{{ k3s_application_postgresql_database }}?sslmode={{ k3s_application_postgresql_sslmode }}
            - name: SESSION_BACKEND
              value: postgresql
            - name: SESSION_TTL_SECONDS
              value: "{{ k3s_application_session_ttl_seconds }}"
            - name: SESSION_COOKIE_SECURE
              value: "{{ k3s_application_session_cookie_secure }}"
            - name: LOG_LEVEL
              value: {{ k3s_application_log_level }}
            - name: TZ
              value: UTC
          startupProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            tcpSocket:
              port: http
            periodSeconds: 20
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 300m
              memory: 256Mi
