apiVersion: v1
kind: Service
metadata:
  name: history
  namespace: {{ k3s_application_namespace }}
  labels:
    app.kubernetes.io/name: history
    app.kubernetes.io/part-of: oilscope
spec:
  selector:
    app.kubernetes.io/name: history
  ports:
    - name: http
      port: 8001
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: history
  namespace: {{ k3s_application_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: history
  template:
    metadata:
      labels:
        app.kubernetes.io/name: history
        app.kubernetes.io/part-of: oilscope
    spec:
      serviceAccountName: oilscope-workload
      containers:
        - name: history
          image: {{ k3s_application_registry_repository }}/history:{{ k3s_application_image_tag }}
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 8001
          envFrom:
            - configMapRef:
                name: oilscope-config
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: oilscope-runtime
                  key: HISTORY_DATABASE_URL
            - name: RABBITMQ_URL
              valueFrom:
                secretKeyRef:
                  name: oilscope-runtime
                  key: RABBITMQ_URL
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
            timeoutSeconds: 5
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
