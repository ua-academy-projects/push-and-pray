apiVersion: v1
kind: Service
metadata:
  name: fetcher
  namespace: {{ k3s_application_namespace }}
  labels:
    app.kubernetes.io/name: fetcher
    app.kubernetes.io/part-of: oilscope
spec:
  selector:
    app.kubernetes.io/name: fetcher
  ports:
    - name: http
      port: 8002
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fetcher
  namespace: {{ k3s_application_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: fetcher
  template:
    metadata:
      labels:
        app.kubernetes.io/name: fetcher
        app.kubernetes.io/part-of: oilscope
    spec:
      serviceAccountName: oilscope-workload
      containers:
        - name: fetcher
          image: {{ k3s_application_registry_repository }}/fetcher:{{ k3s_application_image_tag }}
          imagePullPolicy: Always
          ports:
            - name: http
              containerPort: 8002
          envFrom:
            - configMapRef:
                name: oilscope-config
          env:
            - name: DATA_PROVIDER
              value: oilpriceapi
            - name: OILPRICEAPI_KEY
              valueFrom:
                secretKeyRef:
                  name: oilscope-runtime
                  key: OILPRICEAPI_KEY
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: oilscope-runtime
                  key: FETCHER_DATABASE_URL
            - name: RABBITMQ_URL
              valueFrom:
                secretKeyRef:
                  name: oilscope-runtime
                  key: RABBITMQ_URL
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 20
            timeoutSeconds: 5
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 250m
              memory: 256Mi
