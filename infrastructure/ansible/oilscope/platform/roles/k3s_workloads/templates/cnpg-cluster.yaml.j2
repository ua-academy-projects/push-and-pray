apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: oilscope-db
  namespace: oilscope
spec:
  instances: 2
  imageName: {{ (k3s_workloads_registry.images['database-cnpg'] ~ ':18-' ~ k3s_workloads_image_tag) | to_json }}
  imagePullSecrets:
    - name: oilscope-registry
  postgresUID: 999
  postgresGID: 999
  enableSuperuserAccess: false
  bootstrap:
    initdb:
      database: {{ k3s_workloads_config.database.name | to_json }}
      owner: {{ k3s_workloads_config.database.admin_user | to_json }}
      secret:
        name: oilscope-db-owner
  managed:
    roles:
      - name: {{ k3s_workloads_config.database.admin_user | to_json }}
        ensure: present
        login: true
        superuser: false
        passwordSecret:
          name: oilscope-db-owner
{% for account in ['history', 'fetcher', 'ui'] %}
      - name: {{ (k3s_workloads_config.database.admin_user ~ '_' ~ account) | to_json }}
        ensure: present
        login: true
        superuser: false
        inherit: true
        inRoles:
          - {{ k3s_workloads_config.database.admin_user | to_json }}
        passwordSecret:
          name: oilscope-db-{{ account }}
{% endfor %}
  postgresql:
    shared_preload_libraries:
      - pg_cron
    parameters:
      cron.database_name: {{ k3s_workloads_config.database.name | to_json }}
      cron.use_background_workers: "on"
      cron.max_running_jobs: "2"
      shared_buffers: 128MB
      max_connections: "50"
      max_worker_processes: "8"
      max_parallel_workers: "2"
      max_wal_size: 512MB
      wal_keep_size: 128MB
  affinity:
    enablePodAntiAffinity: true
    podAntiAffinityType: required
    topologyKey: kubernetes.io/hostname
  storage:
    storageClass: local-path
    size: 2Gi
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: "1"
      memory: 512Mi
