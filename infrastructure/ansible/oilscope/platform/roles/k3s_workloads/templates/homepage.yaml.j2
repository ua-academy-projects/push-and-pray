apiVersion: v1
kind: ServiceAccount
metadata:
  name: homepage
  namespace: homepage
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: homepage-overview
rules:
  - apiGroups: [""]
    resources: [nodes, pods]
    verbs: [get, list]
  - apiGroups: [metrics.k8s.io]
    resources: [nodes, pods]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: homepage-overview
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: homepage-overview
subjects:
  - kind: ServiceAccount
    name: homepage
    namespace: homepage
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage-config
  namespace: homepage
data:
  kubernetes.yaml: |
    mode: cluster
  settings.yaml: |
    title: OilScope
  services.yaml: |
    - OilScope:
        - Application:
            href: {{ ('https://' ~ k3s_workloads_config.cloudflare.hostname if k3s_workloads_config.cloudflare.enabled | default(false) | bool else 'http://' ~ hostvars[groups['k3s_primary'][0]].internal_ip) | to_json }}
            description: OilScope web application
            namespace: oilscope
            app: ui
            podSelector: app=ui
            siteMonitor: http://ui.oilscope.svc.cluster.local:8080/health
        - Headlamp:
            href: http://headlamp.oilscope.internal:30081
            description: Kubernetes cluster management
            siteMonitor: http://headlamp.headlamp.svc.cluster.local/
  bookmarks.yaml: |
    - Project:
        - Source code:
            - abbr: GH
              href: https://github.com/ua-academy-projects/push-and-pray
              description: OilScope repository
        - K3s guide:
            - abbr: K3
              href: https://github.com/ua-academy-projects/push-and-pray/blob/main/docs/k3s-platform.md
              description: Deployment and dashboard access
  widgets.yaml: |
    - kubernetes:
        cluster:
          show: true
          cpu: true
          memory: true
          showLabel: true
          label: Cluster
        nodes:
          show: true
          cpu: true
          memory: true
          showLabel: true
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: homepage
spec:
  replicas: 1
  selector:
    matchLabels: {app: homepage}
  template:
    metadata:
      labels: {app: homepage}
      annotations:
        checksum/config: {{ (lookup('ansible.builtin.file', role_path ~ '/templates/homepage.yaml.j2') ~ (k3s_workloads_config.cloudflare.hostname | default('')) ~ hostvars[groups['k3s_primary'][0]].internal_ip) | hash('sha256') }}
    spec:
      serviceAccountName: homepage
      containers:
        - name: homepage
          image: ghcr.io/gethomepage/homepage:v2.4.0
          env:
            - name: MY_POD_IP
              valueFrom:
                fieldRef: {fieldPath: status.podIP}
            - name: HOMEPAGE_ALLOWED_HOSTS
              value: "$(MY_POD_IP):3000,homepage.oilscope.internal:30082"
          ports:
            - {name: http, containerPort: 3000}
          readinessProbe:
            httpGet: {path: /api/healthcheck, port: http}
            initialDelaySeconds: 5
            periodSeconds: 15
          resources:
            requests: {cpu: 25m, memory: 64Mi}
            limits: {cpu: 250m, memory: 256Mi}
          volumeMounts:
            - {name: config, mountPath: /app/config/kubernetes.yaml, subPath: kubernetes.yaml}
            - {name: config, mountPath: /app/config/settings.yaml, subPath: settings.yaml}
            - {name: config, mountPath: /app/config/services.yaml, subPath: services.yaml}
            - {name: config, mountPath: /app/config/bookmarks.yaml, subPath: bookmarks.yaml}
            - {name: config, mountPath: /app/config/widgets.yaml, subPath: widgets.yaml}
            - {name: logs, mountPath: /app/config/logs}
      volumes:
        - name: config
          configMap: {name: homepage-config}
        - name: logs
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: homepage
  namespace: homepage
spec:
  type: NodePort
  selector: {app: homepage}
  ports:
    - {name: http, port: 3000, targetPort: http, nodePort: 30082}
