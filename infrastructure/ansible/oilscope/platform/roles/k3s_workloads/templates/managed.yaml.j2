apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: rabbitmq-data
  namespace: oilscope
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 2Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rabbitmq
  namespace: oilscope
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels: {app: rabbitmq}
  template:
    metadata:
      labels: {app: rabbitmq}
    spec:
      hostname: oil-rabbitmq
      containers:
        - name: rabbitmq
          image: rabbitmq:4.3.4-management
          envFrom:
            - secretRef: {name: rabbitmq-env}
          env:
            - {name: RABBITMQ_DEFAULT_USER, value: "oil_tracker"}
            - {name: RABBITMQ_DEFAULT_VHOST, value: "oil_tracker"}
          ports:
            - {name: amqp, containerPort: 5672}
          readinessProbe:
            exec:
              command: [rabbitmq-diagnostics, -q, ping]
            initialDelaySeconds: 20
            periodSeconds: 10
          volumeMounts:
            - {name: data, mountPath: /var/lib/rabbitmq}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: rabbitmq-data}
---
apiVersion: v1
kind: Service
metadata:
  name: rabbitmq
  namespace: oilscope
spec:
  selector: {app: rabbitmq}
  ports:
    - {name: amqp, port: 5672, targetPort: amqp}
