apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: homepage-private
  namespace: homepage
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: private
spec:
  ingressClassName: traefik
  rules:
    - host: homepage.{{ k3s_workloads_private_dns_domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: homepage
                port: {number: 3000}
