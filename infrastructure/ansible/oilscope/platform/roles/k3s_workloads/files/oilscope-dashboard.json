{
  "uid": "oilscope-services",
  "title": "OilScope services",
  "tags": ["oilscope"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Scraped application pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (app) (up{job=\"oilscope\"})", "legendFormat": "{{app}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (app) (rate(http_requests_total{job=\"oilscope\"}[5m]))", "legendFormat": "{{app}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0}
    },
    {
      "id": 3,
      "title": "Requests since pod start",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (app) (http_requests_total{job=\"oilscope\"})", "legendFormat": "{{app}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 6}
    },
    {
      "id": 4,
      "title": "95th percentile request latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (app, le) (rate(http_request_duration_seconds_bucket{job=\"oilscope\"}[5m])))", "legendFormat": "{{app}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8}
    },
    {
      "id": 5,
      "title": "HTTP responses by status",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (app, status) (rate(http_requests_total{job=\"oilscope\"}[5m]))", "legendFormat": "{{app}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "title": "5xx responses per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (app) (rate(http_requests_total{job=\"oilscope\",status=~\"5..\"}[5m]))", "legendFormat": "{{app}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "id": 7,
      "title": "Application process CPU",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (app) (rate(process_cpu_seconds_total{job=\"oilscope\"}[5m]))", "legendFormat": "{{app}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
    },
    {
      "id": 8,
      "title": "Application process memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (app) (process_resident_memory_bytes{job=\"oilscope\"})", "legendFormat": "{{app}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
    },
    {
      "id": 9,
      "title": "Fetcher collection results",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (result) (increase(fetcher_collection_runs_total{job=\"oilscope\"}[1h]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}
    },
    {
      "id": 10,
      "title": "Managed cluster ready nodes",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 40}
    },
    {
      "id": 11,
      "title": "Managed cluster running pods",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(kube_pod_status_phase{phase=\"Running\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 40}
    },
    {
      "id": 12,
      "title": "Managed cluster unavailable deployments",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(clamp_min(kube_deployment_spec_replicas - on(namespace,deployment) kube_deployment_status_replicas_available, 0))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 40}
    },
    {
      "id": 13,
      "title": "Managed node CPU usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (node) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode!=\"idle\"}[5m]))", "legendFormat": "{{node}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 46}
    },
    {
      "id": 14,
      "title": "Managed node memory usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (node) (node_memory_MemTotal_bytes{job=\"node-exporter\"} - node_memory_MemAvailable_bytes{job=\"node-exporter\"})", "legendFormat": "{{node}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 46}
    },
    {
      "id": 15,
      "title": "Managed container CPU usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container!=\"\",namespace=\"oilscope\"}[5m]))", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "cores", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 54}
    },
    {
      "id": 16,
      "title": "Managed container memory usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (namespace, pod) (container_memory_working_set_bytes{job=\"cadvisor\",container!=\"\",namespace=\"oilscope\"})", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 54}
    }
  ]
}
