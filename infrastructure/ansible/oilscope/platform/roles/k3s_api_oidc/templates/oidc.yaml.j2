kube-apiserver-arg:
  - "oidc-issuer-url={{ k3s_api_oidc_issuer_url }}"
  - "oidc-client-id={{ k3s_api_oidc_client_id }}"
  - "oidc-username-claim={{ k3s_api_oidc_username_claim }}"
  - "oidc-username-prefix={{ k3s_api_oidc_username_prefix }}"
{% if k3s_api_oidc_groups_claim %}
  - "oidc-groups-claim={{ k3s_api_oidc_groups_claim }}"
  - "oidc-groups-prefix={{ k3s_api_oidc_groups_prefix }}"
{% endif %}
