{
  "agent": {
    "metrics_collection_interval": {{ aws_cloudwatch_agent_collection_interval }},
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait",
          "cpu_usage_system",
          "cpu_usage_user"
        ],
        "metrics_collection_interval": {{ aws_cloudwatch_agent_collection_interval }},
        "totalcpu": true
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": {{ aws_cloudwatch_agent_collection_interval }},
        "resources": [
          "/"
        ]
      },
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": {{ aws_cloudwatch_agent_collection_interval }}
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": {{ aws_cloudwatch_agent_collection_interval }}
      }
    }
  }
}
