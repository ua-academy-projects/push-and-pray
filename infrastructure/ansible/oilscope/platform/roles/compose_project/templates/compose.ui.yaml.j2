name: petroscope

services:
  redis:
    image: ${REDIS_IMAGE:-redis:8.2.8-bookworm}
    restart: unless-stopped
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
      TZ: UTC
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --appendfsync
      - everysec
      - --maxmemory-policy
      - noeviction
      - --requirepass
      - ${REDIS_PASSWORD}
    volumes:
      - redis_data:/data
    healthcheck:
      # yamllint disable rule:line-length
      test: ["CMD-SHELL", 'redis-cli --no-auth-warning -a "$${REDIS_PASSWORD}" ping | grep -q PONG']
      # yamllint enable rule:line-length
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 10s
    stop_grace_period: 20s
    networks:
      - oilscope-edge

  ui:
    image: "{{ compose_project_config.registry.repository }}/ui:{{ compose_project_config.registry.image_sha }}"
    platform: ${APPLICATION_PLATFORM:-linux/amd64}
    pull_policy: ${APPLICATION_PULL_POLICY:-always}
    restart: unless-stopped
    init: true
    environment:
      HISTORY_SERVICE_URL: ${HISTORY_SERVICE_URL:?HISTORY_SERVICE_URL is required}
      REDIS_URL: redis://:${REDIS_PASSWORD_URLENCODED:?REDIS_PASSWORD_URLENCODED is required}@redis:6379/0
      SESSION_TTL_SECONDS: ${SESSION_TTL_SECONDS:-2592000}
      SESSION_COOKIE_SECURE: "true"
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      TZ: UTC
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 20s
    stop_grace_period: 20s
    security_opt:
      - no-new-privileges:true
    networks:
      - oilscope-edge

volumes:
  redis_data:
    name: petroscope-redis-data

networks:
  oilscope-edge:
    external: true
