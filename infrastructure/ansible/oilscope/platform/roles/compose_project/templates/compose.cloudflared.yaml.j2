name: oilscope-cloudflared

services:
  cloudflared:
    image: "{{ cloudflared_image | default('cloudflare/cloudflared:2024.12.2') }}"
    restart: unless-stopped
    init: true
    command: ["tunnel", "--no-autoupdate", "run"]
    environment:
      TUNNEL_TOKEN: ${CLOUDFLARE_TUNNEL_TOKEN:?CLOUDFLARE_TUNNEL_TOKEN is required}
      TZ: UTC
    security_opt:
      - no-new-privileges:true
    networks:
      - oilscope-edge
networks:
  oilscope-edge:
    external: true
