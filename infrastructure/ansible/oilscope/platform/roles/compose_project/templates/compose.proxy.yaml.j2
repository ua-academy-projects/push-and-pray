name: oilscope-proxy

services:
  traefik:
    image: traefik:v3.7.12
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: unless-stopped
    init: true
    command:
      - "--entrypoints.websecure.address=:443"
      - "--providers.file.directory=/etc/traefik/dynamic"
      - "--providers.file.watch=false"
      - "--certificatesresolvers.letsencrypt.acme.tlschallenge=true"
      - >-
        --certificatesresolvers.letsencrypt.acme.email={{
          compose_project_config.vms.ui.public_endpoint.acme_email }}
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
      - "--ping=true"
      - "--log.level=INFO"
{% if compose_project_config.monitoring.logs_enabled | default(false) %}
      - "--accesslog=true"
      - "--accesslog.format=json"
      - "--accesslog.filepath=/var/log/oilscope/traefik-access.log"
      - "--accesslog.fields.defaultmode=drop"
      - "--accesslog.fields.names.StartUTC=keep"
      - "--accesslog.fields.names.DownstreamStatus=keep"
      - "--accesslog.fields.names.Duration=keep"
      - "--accesslog.fields.headers.defaultmode=drop"
{% endif %}
    ports:
      - "443:443"
    volumes:
      - "{{ compose_project_dir }}/dynamic:/etc/traefik/dynamic:ro"
      - "{{ compose_project_dir }}/acme.json:/letsencrypt/acme.json"
{% if compose_project_config.monitoring.logs_enabled | default(false) %}
      - "/var/log/oilscope:/var/log/oilscope"
{% endif %}
    networks:
      - oilscope-edge
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 10s
    stop_grace_period: 20s
    security_opt:
      - no-new-privileges:true

networks:
  oilscope-edge:
    external: true
