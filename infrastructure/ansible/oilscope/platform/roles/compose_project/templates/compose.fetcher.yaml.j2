name: petroscope

services:
  fetcher:
    image: "{{ compose_project_config.registry.repository }}/fetcher:{{ compose_project_config.registry.image_sha }}"
    platform: ${APPLICATION_PLATFORM:-linux/amd64}
    pull_policy: ${APPLICATION_PULL_POLICY:-always}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: unless-stopped
    init: true
    environment:
      OILPRICEAPI_KEY: ${OILPRICEAPI_KEY:?OILPRICEAPI_KEY is required}
      DATA_PROVIDER: ${DATA_PROVIDER:-oilpriceapi}
      # yamllint disable rule:line-length
      DATABASE_URL: postgres://${POSTGRES_USER:?POSTGRES_USER is required}:${POSTGRES_PASSWORD_URL:?POSTGRES_PASSWORD_URL is required}@${DATABASE_HOST:?DATABASE_HOST is required}:${DATABASE_PORT:?DATABASE_PORT is required}/${POSTGRES_DB:?POSTGRES_DB is required}?sslmode=${DATABASE_SSLMODE:?DATABASE_SSLMODE is required}{{ '&sslrootcert=${DATABASE_SSLROOTCERT:?DATABASE_SSLROOTCERT is required}' if oilscope_database_mode == 'cloud' else '' }}
      # yamllint enable rule:line-length
      FETCH_CRON_HOURS: ${FETCH_CRON_HOURS:-0,6,12,18}
      FETCH_TIMEZONE: ${FETCH_TIMEZONE:-UTC}
      FETCH_ON_STARTUP: ${FETCH_ON_STARTUP:-true}
      REQUEST_TIMEOUT_SECONDS: ${REQUEST_TIMEOUT_SECONDS:-15}
      LISTEN_ADDRESS: ${FETCHER_LISTEN_ADDRESS:-0.0.0.0:8002}
      RABBITMQ_URL: ${RABBITMQ_URL:?required}
      RABBITMQ_CA_FILE: ${RABBITMQ_CA_FILE:?required}
      RABBITMQ_EXCHANGE: ${RABBITMQ_EXCHANGE:?required}
      RABBITMQ_ROUTING_KEY: ${RABBITMQ_ROUTING_KEY:?required}
      RABBITMQ_QUEUE: ${RABBITMQ_QUEUE:?required}
      RABBITMQ_TIMEOUT_SECONDS: ${RABBITMQ_TIMEOUT_SECONDS:?required}
      RABBITMQ_RECONNECT_SECONDS: ${RABBITMQ_RECONNECT_SECONDS:?required}
      RABBITMQ_MAX_ATTEMPTS: ${RABBITMQ_MAX_ATTEMPTS:?required}
      OUTBOX_POLL_SECONDS: ${OUTBOX_POLL_SECONDS:?required}
      OUTBOX_BATCH_SIZE: ${OUTBOX_BATCH_SIZE:?required}
      TZ: UTC
    ports:
      - "${FETCHER_BIND_ADDRESS:-0.0.0.0}:${FETCHER_HOST_PORT:-8002}:8002"
    labels:
      oilscope.broker-ca: "{{ oilscope_broker_ca.content | hash('sha256') }}"
{% if oilscope_database_mode == 'cloud' %}
      oilscope.database-ca-sha256: "{{ oilscope_database_ca.stat.checksum }}"
{% endif %}
    volumes:
      - type: bind
        source: /etc/oilscope/rabbitmq
        target: /run/oilscope/rabbitmq
        read_only: true
        bind:
          create_host_path: false
{% if oilscope_database_mode == 'cloud' %}
      - type: bind
        source: "{{ database_connection_ca_dir }}"
        target: "{{ database_connection_container_ca_dir }}"
        read_only: true
        bind:
          create_host_path: false
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8002/health"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 10s
    stop_grace_period: 20s
    security_opt:
      - no-new-privileges:true
