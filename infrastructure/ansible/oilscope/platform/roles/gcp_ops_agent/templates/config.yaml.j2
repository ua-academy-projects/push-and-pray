logging:
  receivers:
    docker_json:
      type: files
      include_paths:
        - /var/lib/docker/containers/*/*-json.log
      record_log_file_path: true
  processors:
    parse_docker_json:
      type: parse_json
  service:
    pipelines:
      docker:
        receivers:
          - docker_json
        processors:
          - parse_docker_json
