{% macro operator_subjects() %}
{% if k3s_headlamp_service_account %}
      - kind: ServiceAccount
        name: {{ k3s_headlamp_service_account }}
        namespace: {{ k3s_headlamp_namespace }}
{% endif %}
{% for group in k3s_headlamp_allowed_groups %}
      - apiGroup: rbac.authorization.k8s.io
        kind: Group
        name: {{ (k3s_headlamp_groups_prefix ~ group) | to_json }}
{% endfor %}
{% for user in k3s_headlamp_allowed_users %}
      - apiGroup: rbac.authorization.k8s.io
        kind: User
        name: {{ (k3s_headlamp_username_prefix ~ user) | to_json }}
{% endfor %}
{% endmacro %}
apiVersion: v1
kind: List
items:
  - apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: {{ k3s_headlamp_operator_cluster_role }}
      labels:
        app.kubernetes.io/part-of: headlamp
        app.kubernetes.io/component: operator-rbac
    rules:
      - apiGroups: [""]
        resources:
          - pods
          - pods/log
          - pods/status
          - services
          - endpoints
          - configmaps
          - persistentvolumeclaims
          - persistentvolumes
          - namespaces
          - nodes
          - nodes/status
          - events
          - serviceaccounts
          - replicationcontrollers
          - limitranges
          - resourcequotas
        verbs: [get, list, watch]
      - apiGroups: [apps]
        resources:
          - deployments
          - statefulsets
          - daemonsets
          - replicasets
          - controllerrevisions
        verbs: [get, list, watch]
      - apiGroups: [batch]
        resources: [jobs, cronjobs]
        verbs: [get, list, watch]
      - apiGroups: [networking.k8s.io]
        resources: [ingresses, ingressclasses, networkpolicies]
        verbs: [get, list, watch]
      - apiGroups: [discovery.k8s.io]
        resources: [endpointslices]
        verbs: [get, list, watch]
      - apiGroups: [storage.k8s.io]
        resources: [storageclasses, csidrivers, csinodes, volumeattachments]
        verbs: [get, list, watch]
      - apiGroups: [autoscaling]
        resources: [horizontalpodautoscalers]
        verbs: [get, list, watch]
      - apiGroups: [policy]
        resources: [poddisruptionbudgets]
        verbs: [get, list, watch]
      - apiGroups: [coordination.k8s.io]
        resources: [leases]
        verbs: [get, list, watch]
      - apiGroups: [apiextensions.k8s.io]
        resources: [customresourcedefinitions]
        verbs: [get, list, watch]
      - apiGroups: [cert-manager.io]
        resources: [certificates, certificaterequests, issuers, clusterissuers]
        verbs: [get, list, watch]
      - apiGroups: [metrics.k8s.io]
        resources: [nodes, pods]
        verbs: [get, list]
      - apiGroups: [authorization.k8s.io]
        resources: [selfsubjectrulesreviews, selfsubjectaccessreviews]
        verbs: [create]
      - apiGroups: [authentication.k8s.io]
        resources: [selfsubjectreviews]
        verbs: [create]

  - apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: {{ k3s_headlamp_operator_cluster_role }}
      labels:
        app.kubernetes.io/part-of: headlamp
        app.kubernetes.io/component: operator-rbac
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: {{ k3s_headlamp_operator_cluster_role }}
    subjects:
{{ operator_subjects() }}

  - apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      name: {{ k3s_headlamp_operator_role }}
      namespace: {{ k3s_headlamp_application_namespace }}
      labels:
        app.kubernetes.io/part-of: headlamp
        app.kubernetes.io/component: operator-rbac
    rules:
      - apiGroups: [""]
        resources: [services/proxy]
        resourceNames:
          - {{ k3s_headlamp_fetcher_service | to_json }}
          - {{ (k3s_headlamp_fetcher_service ~ ':'
                ~ k3s_headlamp_fetcher_port) | to_json }}
          - {{ ('http:' ~ k3s_headlamp_fetcher_service ~ ':'
                ~ k3s_headlamp_fetcher_port) | to_json }}
        verbs: [get]

  - apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      name: {{ k3s_headlamp_operator_role }}
      namespace: {{ k3s_headlamp_application_namespace }}
      labels:
        app.kubernetes.io/part-of: headlamp
        app.kubernetes.io/component: operator-rbac
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: {{ k3s_headlamp_operator_role }}
    subjects:
{{ operator_subjects() }}
