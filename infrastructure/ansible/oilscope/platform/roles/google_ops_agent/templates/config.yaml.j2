logging:
  receivers:
    oilscope_application:
      type: files
      include_paths:
        - /var/log/oilscope/*.jsonl
    oilscope_deploy:
      type: systemd_journald
  service:
    pipelines:
      oilscope_application:
        receivers:
          - oilscope_application
        processors:
          - oilscope_json
      oilscope_deploy:
        receivers:
          - oilscope_deploy
        processors:
          - oilscope_deploy_only
  processors:
    oilscope_json:
      type: parse_json
    # systemd_journald receivers cannot filter by unit, so drop other units here.
    oilscope_deploy_only:
      type: exclude_logs
      match_any:
        - 'jsonPayload._SYSTEMD_UNIT != "oilscope-deploy.service"'
metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      collection_interval: 60s
