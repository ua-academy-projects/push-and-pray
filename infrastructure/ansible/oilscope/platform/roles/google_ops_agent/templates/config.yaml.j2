logging:
  receivers:
    oilscope_application:
      type: files
      include_paths:
        - /var/log/oilscope/*.jsonl
    oilscope_deploy:
      type: systemd_journald
      include_units:
        - oilscope-deploy.service
  service:
    pipelines:
      oilscope_application:
        receivers:
          - oilscope_application
        processors:
          - oilscope_json
      oilscope_deploy:
        receivers:
          - oilscope_deploy
  processors:
    oilscope_json:
      type: parse_json
metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      collection_interval: 60s
