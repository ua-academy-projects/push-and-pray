ARG CNPG_IMAGE=ghcr.io/cloudnative-pg/postgresql:17-standard-trixie
FROM ${CNPG_IMAGE}

ARG PG_MAJOR=17
ARG PGMQ_VERSION=1.12.0

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends "postgresql-${PG_MAJOR}-cron" \
    && rm -rf /var/lib/apt/lists/*

ADD --chmod=0644 \
    "https://raw.githubusercontent.com/pgmq/pgmq/v${PGMQ_VERSION}/pgmq-extension/pgmq.control" \
    "/usr/share/postgresql/${PG_MAJOR}/extension/pgmq.control"
ADD --chmod=0644 \
    "https://raw.githubusercontent.com/pgmq/pgmq/v${PGMQ_VERSION}/pgmq-extension/sql/pgmq.sql" \
    "/usr/share/postgresql/${PG_MAJOR}/extension/pgmq--${PGMQ_VERSION}.sql"

COPY --chown=26:26 database/migrations /opt/petroscope/migrations
COPY --chmod=0755 infrastructure/docker/migrate.sh /usr/local/bin/petroscope-migrate

USER 26
