ARG GO_IMAGE=golang:1.25-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM ${GO_IMAGE} AS builder

WORKDIR /src

COPY services/fetcher/go.mod services/fetcher/go.sum ./
RUN go mod download

COPY services/fetcher ./
RUN CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/oil-price-fetcher \
    ./cmd/fetcher

FROM ${RUNTIME_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

COPY --from=builder /out/oil-price-fetcher /usr/local/bin/oil-price-fetcher

USER app

EXPOSE 8002

ENTRYPOINT ["/usr/local/bin/oil-price-fetcher"]
