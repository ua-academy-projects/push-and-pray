{
  "default_cloud": "gcp",
  "manage_db": false,
  "defaults": {
    "location_profile": "primary",
    "machine_profile": "micro",
    "image_profile": "ubuntu",
    "disk_profile": "balanced"
  },
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345",
      "locations": {
        "primary": {
          "region": "europe-west1",
          "zone": "europe-west1-b"
        }
      },
      "machine_types": {
        "micro": "e2-micro",
        "small": "e2-small"
      },
      "disk_types": {
        "balanced": "pd-balanced",
        "standard": "pd-standard",
        "ssd": "pd-ssd"
      },
      "images": {
        "ubuntu": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
      }
    },
    "aws": {
      "locations": {
        "primary": {
          "region": "eu-west-1",
          "zone": "eu-west-1a"
        }
      },
      "machine_types": {
        "micro": "t3.micro",
        "small": "t3.small"
      },
      "disk_types": {
        "balanced": "gp3",
        "standard": "gp2",
        "ssd": "io2"
      },
      "images": {
        "ubuntu": "ami-0123456789abcdef0"
      },
      "bastion_nat": true,
      "free_tier_guardrails": true
    }
  },
  "environment": "dev",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "public_subnet_cidr": "10.0.2.0/28",
    "ui_public_ports": [
      80,
      443
    ]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432,
    "rabbitmq": 5672,
    "redis": 6379
  },
  "secrets_by_role": {
    "database": {
      "POSTGRES_PASSWORD": "example-db-password",
      "GHCR_TOKEN": "example-ghcr-token"
    },
    "history": {
      "POSTGRES_PASSWORD": "example-db-password",
      "GHCR_TOKEN": "example-ghcr-token"
    },
    "fetcher": {
      "POSTGRES_PASSWORD": "example-db-password",
      "OILPRICEAPI_KEY": "example-api-key",
      "GHCR_TOKEN": "example-ghcr-token"
    },
    "ui": {
      "POSTGRES_PASSWORD": "example-db-password",
      "GHCR_TOKEN": "example-ghcr-token"
    }
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "internal_ip": "10.0.0.4",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": true,
      "network_tags": [
        "bastion"
      ],
      "ssh_port": 8787,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ]
    },
    "infra": {
      "role": "database",
      "internal_ip": "10.0.1.4",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": false,
      "network_tags": [
        "infra"
      ]
    },
    "history": {
      "role": "history",
      "machine_profile": "missing",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": false,
      "network_tags": [
        "history"
      ]
    },
    "fetcher": {
      "role": "fetcher",
      "internal_ip": "10.0.1.6",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": false,
      "network_tags": [
        "fetcher"
      ]
    },
    "ui": {
      "role": "ui",
      "internal_ip": "10.0.1.7",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": true,
      "network_tags": [
        "ui"
      ],
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
