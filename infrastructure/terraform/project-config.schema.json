{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for the provider-neutral, non-secret project configuration shared by Terraform and Ansible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "location",
    "environment",
    "secret_version_managers",
    "gcp",
    "regions",
    "zones",
    "sizes",
    "disk_types",
    "images",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "ansible",
    "registry",
    "monitoring",
    "network",
    "services",
    "vms"
  ],
  "properties": {
    "secret_version_managers": {
      "description": "GCP IAM members allowed to add versions to application secrets.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(user|group|serviceAccount|principal|principalSet):.+$"
      }
    },
    "default_cloud": {
      "$ref": "#/$defs/cloud"
    },
    "location": {
      "$comment": "Provider-neutral label resolved through the regions map by each cloud module.",
      "$ref": "#/$defs/abstract_label"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "gcp": {
      "$ref": "#/$defs/gcp_settings"
    },
    "regions": {
      "$comment": "Maps abstract location labels to provider region identifiers.",
      "$ref": "#/$defs/provider_string_catalog"
    },
    "zones": {
      "$comment": "Maps location labels to explicit provider availability zones.",
      "$ref": "#/$defs/provider_string_catalog"
    },
    "sizes": {
      "$comment": "Maps abstract machine_type labels to provider machine types.",
      "$ref": "#/$defs/provider_string_catalog"
    },
    "disk_types": {
      "$comment": "Maps abstract boot_disk.type labels to provider disk types.",
      "$ref": "#/$defs/provider_string_catalog"
    },
    "images": {
      "$comment": "Maps abstract image labels to provider-specific image selectors.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/abstract_label"
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider_image_map"
      }
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "ansible": {
      "$ref": "#/$defs/ansible_settings"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "username", "image_sha"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "monitoring": {
      "description": "Shared settings for host metrics and centralized system/application logs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "metrics_interval_seconds",
        "log_retention_days",
        "alert_email",
        "ui_health_path",
        "thresholds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metrics_interval_seconds": {
          "description": "Host metric collection interval. Values below 60 seconds would create high-resolution AWS metrics.",
          "type": "integer",
          "minimum": 60,
          "maximum": 300
        },
        "log_retention_days": {
          "description": "Retention supported by both CloudWatch Logs and Cloud Logging.",
          "type": "integer",
          "enum": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1827, 2192, 2557, 2922, 3288, 3653]
        },
        "alert_email": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "ui_health_path": {
          "type": "string",
          "pattern": "^/[^ ]*$"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_percent", "memory_percent", "disk_percent"],
          "properties": {
            "cpu_percent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "memory_percent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "disk_percent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vpc_cidr",
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "database_connectivity",
        "ui_public_ports"
      ],
      "properties": {
        "vpc_cidr": {
          "type": "string",
          "minLength": 1
        },
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "database_connectivity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aws", "gcp"],
          "properties": {
            "aws": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/abstract_label"
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["availability_zone", "cidr"],
                  "properties": {
                    "availability_zone": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cidr": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "gcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["private_service_cidr"],
              "properties": {
                "private_service_cidr": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [80, 443]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history", "database", "rabbitmq", "redis"],
      "properties": {
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": {
              "$ref": "#/$defs/port"
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "name",
            "username",
            "password_secret_id",
            "ssl_mode",
            "aws",
            "gcp"
          ],
          "properties": {
            "port": {
              "$ref": "#/$defs/port"
            },
            "name": {
              "$ref": "#/$defs/service_identifier"
            },
            "username": {
              "$ref": "#/$defs/service_identifier"
            },
            "password_secret_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "ssl_mode": {
              "type": "string",
              "enum": ["disable", "require", "verify-ca", "verify-full"]
            },
            "aws": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "engine_version",
                "instance_class",
                "allocated_storage_gb",
                "storage_type",
                "multi_az",
                "backup_retention_days"
              ],
              "properties": {
                "engine_version": {
                  "type": "string",
                  "minLength": 1
                },
                "instance_class": {
                  "type": "string",
                  "minLength": 1
                },
                "allocated_storage_gb": {
                  "type": "integer",
                  "minimum": 20
                },
                "storage_type": {
                  "type": "string",
                  "enum": ["gp2", "gp3", "io1", "io2"]
                },
                "multi_az": {
                  "type": "boolean"
                },
                "backup_retention_days": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 35
                }
              }
            },
            "gcp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "database_version",
                "tier",
                "disk_size_gb",
                "availability_type",
                "backup_enabled"
              ],
              "properties": {
                "database_version": {
                  "type": "string",
                  "pattern": "^POSTGRES_[0-9]+$"
                },
                "tier": {
                  "type": "string",
                  "minLength": 1
                },
                "disk_size_gb": {
                  "type": "integer",
                  "minimum": 10
                },
                "availability_type": {
                  "type": "string",
                  "enum": ["ZONAL", "REGIONAL"]
                },
                "backup_enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "rabbitmq": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amqp_port",
            "management_port",
            "username",
            "vhost",
            "queue",
            "image",
            "metrics_port"
          ],
          "properties": {
            "amqp_port": {
              "$ref": "#/$defs/port"
            },
            "management_port": {
              "$ref": "#/$defs/port"
            },
            "username": {
              "$ref": "#/$defs/service_identifier"
            },
            "vhost": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:/|[A-Za-z0-9._-]+)$"
            },
            "queue": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "metrics_port": {
              "$ref": "#/$defs/port"
            }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "database", "image", "metrics_port", "exporter_image"],
          "properties": {
            "port": {
              "$ref": "#/$defs/port"
            },
            "database": {
              "type": "integer",
              "minimum": 0
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "metrics_port": {
              "$ref": "#/$defs/port"
            },
            "exporter_image": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": ["bastion", "infra", "history", "fetcher", "ui"],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "role": {
                  "const": "bastion"
                }
              },
              "required": ["role"]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    }
  },
  "$defs": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service_identifier": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "abstract_label": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "cloud": {
      "type": "string",
      "enum": ["gcp", "aws"]
    },
    "gcp_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        }
      }
    },
    "provider_string_catalog": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/abstract_label"
      },
      "additionalProperties": {
        "$ref": "#/$defs/provider_string_map"
      }
    },
    "provider_string_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "string",
          "minLength": 1
        },
        "aws": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider_image_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "$ref": "#/$defs/gcp_image"
        },
        "aws": {
          "$ref": "#/$defs/aws_image"
        }
      }
    },
    "gcp_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aws_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners", "name_pattern"],
      "properties": {
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{12}$"
          }
        },
        "name_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_gb", "type"],
      "properties": {
        "iops": {
          "description": "Provisioned AWS EBS IOPS; required when using io1 or io2.",
          "type": "integer",
          "minimum": 1
        },
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "type": {
          "$comment": "Abstract label resolved through disk_types.",
          "$ref": "#/$defs/abstract_label"
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "ansible_settings": {
      "$comment": "Selects the Linux account Ansible uses from the accounts declared in ssh_users.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ssh_user"],
      "properties": {
        "ssh_user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        }
      }
    },
    "vm_network_tags": {
      "$comment": "Provider-neutral traffic-group labels retained under the existing field name for compatibility.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bastion", "infra", "history", "fetcher", "ui"]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret provider secret IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "machine_type",
        "image",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "network_tags",
        "secret_mappings"
      ],
      "properties": {
        "role": {
          "type": "string",
        "enum": ["bastion", "infra", "history", "fetcher", "ui"]
        },
        "cloud": {
          "$comment": "Optional per-VM override; default_cloud applies when omitted.",
          "$ref": "#/$defs/cloud"
        },
        "machine_type": {
          "$comment": "Abstract label resolved through sizes.",
          "$ref": "#/$defs/abstract_label"
        },
        "image": {
          "$comment": "Abstract label resolved through images.",
          "$ref": "#/$defs/abstract_label"
        },
        "internal_ip": {
          "type": "string",
          "minLength": 1
        },
        "internal_ips": {
          "$comment": "Optional per-cloud private IP overrides; internal_ip is the fallback.",
          "$ref": "#/$defs/provider_string_map"
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/vm_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "acme_email"],
          "properties": {
            "domain": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": {
              "role": {
                "enum": ["bastion", "ui"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "bastion"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["ssh_port", "allowed_cidrs"],
            "properties": {
              "assign_public_ip": {
                "const": true
              },
              "network_tags": {
                "contains": {
                  "const": "bastion"
                }
              },
              "secret_mappings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["ssh_port"]
                },
                {
                  "required": ["allowed_cidrs"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ui"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["public_endpoint"],
            "properties": {
              "network_tags": {
                "contains": {
                  "const": "ui"
                }
              }
            }
          }
        }
      ]
    }
  }
}
