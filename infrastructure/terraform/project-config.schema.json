{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret Terraform project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "default_region",
    "clouds",
    "regions",
    "sizes",
    "disk_types",
    "images",
    "environment",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "service_ports",
    "monitoring",
    "vms",
    "database",
    "messaging"
  ],
  "properties": {
    "default_cloud": {
      "type": "string",
      "enum": ["aws", "gcp"]
    },
    "default_region": {
      "type": "string",
      "minLength": 1
    },
    "clouds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp"],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id"],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            },
            "billing_account_id": {
              "$comment": "Required only when monitoring.budget.enabled is true.",
              "type": "string",
              "pattern": "^[0-9A-Z]{6}-[0-9A-Z]{6}-[0-9A-Z]{6}$"
            }
          }
        }
      }
    },
    "regions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gcp", "aws"],
        "properties": {
          "gcp": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "zone"],
            "properties": {
              "region": {
                "type": "string",
                "minLength": 1
              },
              "zone": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "aws": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "availability_zone"],
            "properties": {
              "region": {
                "type": "string",
                "minLength": 1
              },
              "availability_zone": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sizes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gcp", "aws"],
        "properties": {
          "gcp": {
            "type": "string",
            "minLength": 1
          },
          "aws": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disk_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gcp", "aws"],
        "properties": {
          "gcp": {
            "type": "string",
            "minLength": 1
          },
          "aws": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "images": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gcp", "aws"],
        "properties": {
          "gcp": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference"],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "aws": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name_filter", "owners"],
            "properties": {
              "name_filter": {
                "type": "string",
                "minLength": 1
              },
              "owners": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{12}$"
                }
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "username", "image_sha"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vpc_cidr",
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "vpc_cidr": {
            "type": "string",
            "minLength": 1
        },
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [80, 443]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_api", "postgresql"],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "notification_email",
        "cpu",
        "disk",
        "uptime",
        "logs",
        "budget"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "notification_email": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "cpu": {
          "$ref": "#/$defs/percentage_alert"
        },
        "disk": {
          "$ref": "#/$defs/percentage_alert"
        },
        "uptime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "path", "period_seconds", "timeout_seconds"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "period_seconds": {
              "type": "integer",
              "enum": [60, 300, 600, 900]
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "error_pattern"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "error_pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "amount", "currency", "thresholds"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "thresholds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "database": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "name", "user", "port"],
        "properties": {
            "mode": {
                "type": "string",
                "enum": ["self_managed", "managed"]
            },
            "name": {
                "type": "string",
                "minLength": 1
            },
            "user": {
                "type": "string",
                "minLength": 1
            },
            "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
            },
            "managed": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "gcp": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["database_version", "tier"],
                        "properties": {
                            "database_version": {
                                "type": "string",
                                "minLength": 1
                            },
                            "tier": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    },
                    "aws": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["engine_version", "instance_class"],
                        "properties": {
                            "engine_version": {
                                "type": "string",
                                "minLength": 1
                            },
                            "instance_class": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            }
        }
    },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_name", "visibility_timeout_seconds", "max_delivery_attempts"],
      "properties": {
        "queue_name": { "type": "string", "minLength": 1 },
        "visibility_timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_delivery_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": ["bastion"],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "role": {
                  "const": "bastion"
                }
              },
              "required": ["role"]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    }
  },
  "$defs": {
    "percentage_alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_percent", "duration_seconds"],
      "properties": {
        "threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 60,
          "multipleOf": 60
        }
      }
    },
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_gb", "type"],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bastion", "infra", "history", "fetcher", "ui"]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "size",
        "region",
        "image",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "network_tags",
        "secret_mappings"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["bastion", "database", "history", "fetcher", "ui"]
        },
        "size": {
            "type": "string"
        },
        "region": {
            "type": "string"
        },
        "cloud": {
            "type": "string",
            "enum": ["gcp", "aws"]
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "internal_ip": {
          "type": "string",
          "minLength": 1
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/vm_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "acme_email"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": {
              "role": {
                "enum": ["bastion", "ui"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "bastion"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["ssh_port", "allowed_cidrs"],
            "properties": {
              "assign_public_ip": {
                "const": true
              },
              "network_tags": {
                "contains": {
                  "const": "bastion"
                }
              },
              "secret_mappings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["ssh_port"]
                },
                {
                  "required": ["allowed_cidrs"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "history"
              }
            },
            "required": ["role"]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "fetcher"
              }
            },
            "required": ["role"]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ui"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["public_endpoint"],
            "properties": {
              "network_tags": {
                "contains": {
                  "const": "ui"
                }
              }
            }
          }
        }
      ]
    }
  }
}
