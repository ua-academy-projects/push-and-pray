{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret Terraform project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cloud",
    "environment",
    "region",
    "regions",
    "image",
    "images",
    "machine_types",
    "disk_types",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "service_ports",
    "monitoring",
    "vms"
  ],
  "properties": {
    "cloud": {
      "type": "string",
      "enum": ["gcp", "aws"]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/region_entry" }
    },
    "image": {
      "description": "Default image label, resolved through the images dictionary. VMs may override.",
      "type": "string",
      "enum": ["ubuntu"]
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ubuntu"],
      "properties": {
        "ubuntu": { "$ref": "#/$defs/cloud_values" }
      }
    },
    "machine_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["micro", "small"],
      "properties": {
        "micro": { "$ref": "#/$defs/cloud_values" },
        "small": { "$ref": "#/$defs/cloud_values" }
      }
    },
    "disk_types": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economy", "balanced", "performance"],
      "properties": {
        "economy": { "$ref": "#/$defs/cloud_values" },
        "balanced": { "$ref": "#/$defs/cloud_values" },
        "performance": { "$ref": "#/$defs/cloud_values" }
      }
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "username", "image_sha"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [80, 443]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_api", "postgresql"],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notification_email", "budget_amount_usd"],
      "properties": {
        "notification_email": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "budget_amount_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpu_threshold_percent": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 80
        },
        "gcp_billing_account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{6}-[A-Za-z0-9]{6}-[A-Za-z0-9]{6}$"
        }
      }
    },
   "managed_db": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "tier", "version", "disk_size_gb"],
      "properties": {
        "enabled": { "type": "boolean" },
        "tier": { "$ref": "#/$defs/cloud_values" },
        "version": { "$ref": "#/$defs/cloud_values" },
        "disk_size_gb": { "type": "integer", "minimum": 10 },
        "db_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "db_user": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "vms": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "role": {
                  "const": "bastion"
                }
              },
              "required": ["role"]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    }
  },
  "$defs": {
    "cloud_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": { "type": "string", "minLength": 1 },
        "aws": { "type": "string", "minLength": 1 }
      }
    },
    "region_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": { "$ref": "#/$defs/placement" },
        "aws": { "$ref": "#/$defs/placement" }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "zone"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "zone": { "type": "string", "minLength": 1 }
      }
    },
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_gb", "type"],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "type": {
          "type": "string",
          "enum": ["economy", "balanced", "performance"]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "machine_type": {
      "type": "string",
      "enum": ["micro", "small"]
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bastion", "infra", "history", "fetcher", "ui"]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "machine_type",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "network_tags",
        "secret_mappings"
      ],
      "properties": {
        "cloud": {
          "description": "Cloud this VM is created on. Defaults to the root-level cloud when omitted.",
          "type": "string",
          "enum": ["gcp", "aws"]
        },
        "region": {
          "description": "Region label for this VM, resolved through the regions dictionary. Defaults to the root-level region when omitted.",
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": ["bastion", "database", "history", "fetcher", "ui"]
        },
        "machine_type": {
          "$ref": "#/$defs/machine_type"
        },
        "image": {
          "description": "Image label for this VM, resolved through the images dictionary. Defaults to the root-level image when omitted.",
          "type": "string",
          "enum": ["ubuntu"]
        },
        "internal_ip": {
          "type": "string",
          "minLength": 1
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/vm_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "acme_email"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": {
              "role": {
                "enum": ["bastion", "ui"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "bastion"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["ssh_port", "allowed_cidrs"],
            "properties": {
              "assign_public_ip": {
                "const": true
              },
              "network_tags": {
                "contains": {
                  "const": "bastion"
                }
              },
              "secret_mappings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["ssh_port"]
                },
                {
                  "required": ["allowed_cidrs"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "history"
              }
            },
            "required": ["role"]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "fetcher"
              }
            },
            "required": ["role"]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ui"
              }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["public_endpoint"],
            "properties": {
              "network_tags": {
                "contains": {
                  "const": "ui"
                }
              }
            }
          }
        }
      ]
    }
  }
}
