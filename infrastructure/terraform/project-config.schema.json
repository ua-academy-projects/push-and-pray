{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret Terraform project configuration. Cloud-neutral: VMs reference abstract size/image/disk_type/region tiers resolved per-cloud via the *_map dictionaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "region",
    "environment",
    "name_prefix",
    "size_map",
    "region_map",
    "disk_type_map",
    "image_map",
    "clouds",
    "network",
    "ssh_users",
    "registry",
    "service_ports",
    "vms"
  ],
  "properties": {
    "default_cloud": {
      "$ref": "#/$defs/cloud_name",
      "description": "Which cloud this apply targets. Single-cloud-per-apply: every VM in `vms` deploys here."
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "description": "Key into region_map. Not cross-validated by this schema — an unknown key fails loudly at `terraform plan` via a plain map lookup."
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },

    "size_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/per_cloud_string" },
      "description": "Abstract size tiers (e.g. \"small\") to native machine/instance type per cloud."
    },
    "region_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/region_entry" },
      "description": "Abstract region keys (e.g. \"eu-central\") to native region/zone per cloud."
    },
    "disk_type_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "$ref": "#/$defs/per_cloud_string" },
      "description": "Abstract disk tiers (e.g. \"balanced\") to native disk/volume type per cloud."
    },
    "image_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]*$" },
      "additionalProperties": { "$ref": "#/$defs/per_cloud_string" },
      "description": "Abstract image keys (e.g. \"ubuntu-26.04\") to native image reference per cloud. For aws this is an SSM parameter path or AMI id, resolved by the aws module — not a raw value Terraform can use directly."
    },

    "clouds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id"],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vpc_cidr"],
          "properties": {
            "vpc_cidr": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },

    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "management_subnet_cidr": { "type": "string", "minLength": 1 },
        "workload_subnet_cidr": { "type": "string", "minLength": 1 },
        "ui_public_ports": {
          "type": "array",
          "items": { "type": "integer", "enum": [80, 443] },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },

    "ssh_users": { "$ref": "#/$defs/ssh_users" },

    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "username", "image_sha"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },

    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_api", "postgresql"],
      "properties": {
        "history_api": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "postgresql": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },

    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": ["bastion"],
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
      "properties": {
        "bastion": {
          "allOf": [
            { "$ref": "#/$defs/vm" },
            {
              "properties": { "role": { "const": "bastion" } },
              "required": ["role"]
            }
          ]
        }
      },
      "additionalProperties": { "$ref": "#/$defs/vm" }
    }
  },

  "allOf": [
    {
      "if": { "properties": { "default_cloud": { "const": "gcp" } } },
      "then": { "properties": { "clouds": { "required": ["gcp"] } } }
    },
    {
      "if": { "properties": { "default_cloud": { "const": "aws" } } },
      "then": { "properties": { "clouds": { "required": ["aws"] } } }
    }
  ],

  "$defs": {
    "cloud_name": {
      "type": "string",
      "enum": ["gcp", "aws"]
    },
    "per_cloud_string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": { "type": "string", "minLength": 1 },
        "aws": { "type": "string", "minLength": 1 }
      }
    },
    "region_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "zone"],
          "properties": {
            "region": { "type": "string", "minLength": 1 },
            "zone": { "type": "string", "minLength": 1 }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "availability_zone"],
          "properties": {
            "region": { "type": "string", "minLength": 1 },
            "availability_zone": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bastion", "infra", "history", "fetcher", "ui"]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "size",
        "image",
        "disk_type",
        "disk_size_gb",
        "internal_ip",
        "assign_public_ip",
        "network_tags",
        "secret_mappings"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["bastion", "database", "history", "fetcher", "ui"]
        },
        "cloud": {
          "$ref": "#/$defs/cloud_name",
          "description": "Overrides default_cloud for this VM only. Omit to inherit default_cloud."
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "Key into size_map."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Key into image_map."
        },
        "disk_type": {
          "type": "string",
          "minLength": 1,
          "description": "Key into disk_type_map."
        },
        "disk_size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "internal_ip": {
          "type": "string",
          "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": { "$ref": "#/$defs/vm_network_tags" },
        "labels": { "$ref": "#/$defs/labels" },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings",
          "description": "Required on every VM. Use {} if this VM has no secrets to resolve."
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "acme_email"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "assign_public_ip": { "const": true } },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": { "role": { "enum": ["bastion", "ui"] } }
          }
        },
        {
          "if": {
            "properties": { "role": { "const": "bastion" } },
            "required": ["role"]
          },
          "then": {
            "required": ["ssh_port", "allowed_cidrs"],
            "properties": {
              "assign_public_ip": { "const": true },
              "network_tags": { "contains": { "const": "bastion" } },
              "secret_mappings": { "maxProperties": 0 }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["ssh_port"] },
                { "required": ["allowed_cidrs"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "role": { "const": "ui" } },
            "required": ["role"]
          },
          "then": {
            "required": ["public_endpoint"],
            "properties": {
              "network_tags": { "contains": { "const": "ui" } }
            }
          }
        }
      ]
    }
  }
}
