{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret Terraform project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "location",
    "environment",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "service_ports",
    "vms"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "stage",
        "prod"
      ]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "username",
        "image_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "ui_public_ports",
        "vpc_cidr"
      ],
      "properties": {
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              80,
              443
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "vpc_cidr": {
          "description": "CIDR range of the VPC. AWS requires one; GCP derives its network from the subnets and ignores this value.",
          "type": "string"
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_api",
        "postgresql"
      ],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": [
        "bastion"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "role": {
                  "const": "bastion"
                }
              },
              "required": [
                "role"
              ]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    },
    "location": {
      "description": "Portable location token. Terraform resolves it to a provider region and zone.",
      "type": "string",
      "enum": [
        "us-east",
        "eu-west"
      ]
    },
    "gcp": {
      "description": "Settings that exist only on GCP. Required when cloud is gcp.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "description": "Target GCP project ID.",
          "type": "string"
        }
      }
    },
    "aws": {
      "description": "Settings that exist only on AWS.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "description": "Target AWS account ID, recorded for humans.",
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "regions": {
          "description": "Regions the dynamic inventory searches for this account's instances. AWS partitions resources by region, so the inventory cannot find them without one.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "default_cloud": {
      "description": "Cloud used by every VM that does not name one of its own.",
      "type": "string",
      "enum": [
        "gcp",
        "aws"
      ]
    }
  },
  "$defs": {
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_gb",
        "type"
      ],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "type": {
          "description": "Portable disk class. Terraform resolves it per cloud.",
          "type": "string",
          "enum": [
            "standard",
            "balanced",
            "ssd"
          ]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "bastion",
          "infra",
          "history",
          "fetcher",
          "ui"
        ]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "network_tags",
        "secret_mappings",
        "size",
        "os"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "bastion",
            "database",
            "history",
            "fetcher",
            "ui"
          ]
        },
        "internal_ip": {
          "type": "string",
          "minLength": 1
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/vm_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostname",
            "acme_email"
          ],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "os": {
          "$ref": "#/$defs/os"
        },
        "cloud": {
          "$ref": "#/$defs/cloud"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": [
              "assign_public_ip"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "enum": [
                  "bastion",
                  "ui"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "bastion"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "ssh_port",
              "allowed_cidrs"
            ],
            "properties": {
              "assign_public_ip": {
                "const": true
              },
              "network_tags": {
                "contains": {
                  "const": "bastion"
                }
              },
              "secret_mappings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ssh_port"
                  ]
                },
                {
                  "required": [
                    "allowed_cidrs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "history"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "fetcher"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ui"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "public_endpoint"
            ],
            "properties": {
              "network_tags": {
                "contains": {
                  "const": "ui"
                }
              }
            }
          }
        }
      ]
    },
    "size": {
      "description": "Portable machine size. Terraform resolves it per cloud.",
      "type": "string",
      "enum": [
        "micro",
        "small",
        "medium"
      ]
    },
    "os": {
      "description": "Portable operating system token. Terraform resolves it to an image family on GCP and to an AMI name pattern on AWS.",
      "type": "string",
      "enum": [
        "ubuntu-26.04",
        "ubuntu-24.04"
      ]
    },
    "cloud": {
      "description": "Cloud a resource is created in.",
      "type": "string",
      "enum": [
        "gcp",
        "aws"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "default_cloud": {
            "const": "gcp"
          }
        },
        "required": [
          "default_cloud"
        ]
      },
      "then": {
        "required": [
          "gcp"
        ]
      }
    }
  ]
}
