{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret Terraform project configuration. Describes one k3s cluster of exactly three dual-role nodes. Cloud-neutral: VMs reference abstract size/image/disk_type/region tiers resolved per-cloud via the *_map dictionaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "managed_database",
    "region",
    "environment",
    "name_prefix",
    "size_map",
    "region_map",
    "disk_type_map",
    "image_map",
    "clouds",
    "network",
    "ssh_users",
    "registry",
    "service_ports",
    "vms",
    "rabbitmq",
    "redis",
    "kubernetes",
    "ingress",
    "secret_mappings"
  ],
  "properties": {
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email_recipients"
      ],
      "properties": {
        "email_recipients": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          },
          "description": "Operational alert email recipients. An empty list configures no email recipients."
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "logs_enabled": {
          "type": "boolean",
          "default": true
        },
        "alarms_enabled": {
          "type": "boolean",
          "default": false
        },
        "dashboard_enabled": {
          "type": "boolean",
          "default": false
        },
        "agent_metrics_enabled": {
          "type": "boolean",
          "default": false
        },
        "log_retention_days": {
          "type": "integer",
          "enum": [
            1,
            3,
            5,
            7,
            14,
            30,
            60,
            90,
            120,
            150,
            180,
            365,
            400,
            545,
            731,
            1096,
            1827,
            2192,
            2557,
            2922,
            3288,
            3653
          ],
          "default": 7
        },
        "cpu_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 80
        },
        "memory_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 85
        },
        "disk_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 85
        },
        "http_error_threshold": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "disk_fstype": {
          "type": "string",
          "minLength": 1,
          "default": "ext4"
        },
        "synthetics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "hostname": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "pattern": "^/",
              "default": "/health"
            },
            "period_minutes": {
              "type": "integer",
              "enum": [
                5,
                10,
                15,
                30,
                60
              ],
              "default": 5
            },
            "runtime_version": {
              "type": "string",
              "pattern": "^syn-nodejs-puppeteer-(1[3-9]|[2-9][0-9])\\.[0-9]+$",
              "default": "syn-nodejs-puppeteer-17.0"
            },
            "clouds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "aws",
                  "gcp",
                  "azure"
                ]
              },
              "uniqueItems": true,
              "description": "Explicit probe providers; null retains selection by VM presence."
            },
            "browser_enabled": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "application_metrics_enabled": {
          "type": "boolean",
          "default": false
        },
        "service_logs_enabled": {
          "type": "boolean",
          "default": false
        },
        "database_metrics_enabled": {
          "type": "boolean",
          "default": false
        },
        "detailed_monitoring_enabled": {
          "type": "boolean",
          "default": false
        },
        "outbox_count_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 100
        },
        "outbox_age_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 600
        },
        "rabbitmq_queue_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1000
        },
        "rabbitmq_unacked_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 100
        },
        "rabbitmq_dead_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "redis_memory_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 85
        },
        "freshness_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 28800
        },
        "database_connections_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 80
        },
        "database_free_storage_bytes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1073741824
        },
        "database_cpu_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 80
        },
        "database_disk_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 85
        }
      }
    },
    "default_cloud": {
      "$ref": "#/$defs/cloud_name",
      "description": "Which cloud this apply targets. Single-cloud-per-apply: every VM in `vms` deploys here."
    },
    "managed_database": {
      "type": "boolean",
      "description": "Required database hosting selector: true provisions managed PostgreSQL in default_cloud; false runs PostgreSQL in a database-role VM."
    },
    "database_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Key into database_profile_map; used in cloud database mode."
    },
    "database_profile_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/database_profile"
      }
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "description": "Key into region_map. Not cross-validated by this schema \u2014 an unknown key fails loudly at `terraform plan` via a plain map lookup."
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "stage",
        "prod"
      ]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "size_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/per_cloud_string"
      },
      "description": "Abstract size tiers (e.g. \"small\") to native machine/instance type per cloud."
    },
    "region_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/region_entry"
      },
      "description": "Abstract region keys (e.g. \"eu-central\") to native region/zone per cloud."
    },
    "disk_type_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/per_cloud_string"
      },
      "description": "Abstract disk tiers (e.g. \"balanced\") to native disk/volume type per cloud."
    },
    "image_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/per_cloud_image"
      },
      "description": "Abstract image keys (e.g. \"ubuntu-26.04\") to native image reference per cloud. For aws this must be an SSM parameter path starting with /, which the aws module resolves to an AMI ID. Direct AMI IDs are not supported. For azure it is the marketplace publisher/offer/sku/version."
    },
    "clouds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id"
          ],
          "properties": {
            "cloud_sql_network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allocated_cidr",
                "dns_ttl_seconds"
              ],
              "properties": {
                "allocated_cidr": {
                  "type": "string",
                  "minLength": 1
                },
                "dns_ttl_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            }
          }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subscription_id",
            "resource_group_name",
            "vnet_cidr",
            "admin_username",
            "key_vault"
          ],
          "properties": {
            "subscription_id": {
              "description": "Which subscription to deploy into. Not a credential: the token still comes from the environment or az login.",
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
            },
            "resource_group_name": {
              "description": "Resource group Terraform creates and owns. The inventory plugin scopes its discovery to it, so it is configuration rather than only an output.",
              "type": "string",
              "pattern": "^[-\\w._()]{1,90}[-\\w_()]$"
            },
            "vnet_cidr": {
              "type": "string",
              "minLength": 1
            },
            "admin_username": {
              "description": "Which ssh_users entry Azure provisions as the VM's platform administrator. Every other entry is created by cloud-init.",
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
            },
            "key_vault": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "soft_delete_retention_days",
                "purge_protection_enabled"
              ],
              "properties": {
                "name": {
                  "description": "Globally unique vault name. Omit to derive one from name_prefix, environment, subscription and resource group.",
                  "type": "string",
                  "pattern": "^[A-Za-z](?!.*--)[A-Za-z0-9-]{1,22}[A-Za-z0-9]$"
                },
                "soft_delete_retention_days": {
                  "description": "A deleted vault, and its name, stay reserved for this long.",
                  "type": "integer",
                  "minimum": 7,
                  "maximum": 90
                },
                "purge_protection_enabled": {
                  "description": "With purge protection on, a deleted vault cannot be purged early and its name is unavailable for the whole retention period.",
                  "type": "boolean"
                }
              }
            },
            "postgres_network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subnet_cidr",
                "private_dns_zone_name"
              ],
              "properties": {
                "subnet_cidr": {
                  "description": "Delegated to Microsoft.DBforPostgreSQL/flexibleServers and carrying nothing else; /28 or larger, inside vnet_cidr and not overlapping the management or workload subnet.",
                  "type": "string",
                  "minLength": 1
                },
                "private_dns_zone_name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*\\.postgres\\.database\\.azure\\.com$"
                }
              }
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vpc_cidr"
          ],
          "properties": {
            "vpc_cidr": {
              "type": "string",
              "minLength": 1
            },
            "rds_network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "primary_subnet_cidr",
                "secondary_subnet_cidr",
                "secondary_availability_zone"
              ],
              "properties": {
                "primary_subnet_cidr": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Private subnet in the node availability zone."
                },
                "secondary_subnet_cidr": {
                  "type": "string",
                  "minLength": 1
                },
                "secondary_availability_zone": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Two private subnets for the managed database. RDS requires a subnet group spanning two availability zones, and neither subnet may be the public node subnet."
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              80,
              443
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "description": "Already contains 80, so the ACME HTTP-01 solver needs no additional opening."
        }
      }
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "description": "The selected cloud's native registry: Amazon ECR, Google Artifact Registry or Azure Container Registry, chosen by default_cloud. No credentials live here.",
      "required": [
        "repository_prefix",
        "image_digests"
      ],
      "dependentRequired": {
        "github_repository": [
          "publish_tag_prefix"
        ]
      },
      "properties": {
        "repository_prefix": {
          "type": "string",
          "minLength": 1,
          "description": "Repository path prefix within the registry, e.g. \"oilscope\"."
        },
        "publish_tag_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "Git tag prefix that triggers publishing to this account, e.g. \"pavlo-v\" for tags pavlo-v1.0.0 onward. The publisher role trusts only refs/tags/<prefix>*, so branch pushes and pull requests cannot publish. The prefix names a destination, not a person: anyone who can push a matching tag can publish here."
        },
        "create": {
          "type": "boolean",
          "default": true,
          "description": "False references an existing registry instead of creating one."
        },
        "image_digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fetcher",
            "history",
            "ui",
            "database"
          ],
          "properties": {
            "fetcher": {
              "$ref": "#/$defs/image_digest"
            },
            "history": {
              "$ref": "#/$defs/image_digest"
            },
            "ui": {
              "$ref": "#/$defs/image_digest"
            },
            "database": {
              "$ref": "#/$defs/image_digest"
            }
          },
          "description": "One immutable digest per built image, named after its Dockerfile in infrastructure/docker. The database image is what the migration Job runs."
        },
        "github_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
          "description": "owner/repo allowed to publish through GitHub Actions OIDC. Omit to create no federation and publish only from an operator's machine."
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_api",
        "postgresql"
      ],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      },
      "description": "Exactly three nodes. Names are free-form; k3s-1, k3s-2 and k3s-3 are the convention. Duplicate internal_ip values are not detectable here - see docs/k3s-deployment.md."
    },
    "secret_mappings": {
      "$ref": "#/$defs/workload_secret_mappings"
    },
    "rabbitmq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "port",
        "username",
        "vhost",
        "exchange",
        "queue",
        "routing_key",
        "retry_delay_ms",
        "max_attempts",
        "timeout_seconds",
        "reconnect_seconds",
        "outbox_poll_seconds",
        "outbox_batch_size",
        "memory_mb",
        "queue_max_bytes",
        "certificate_days"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "vhost": {
          "type": "string",
          "minLength": 1
        },
        "exchange": {
          "type": "string",
          "minLength": 1
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "routing_key": {
          "type": "string",
          "minLength": 1
        },
        "retry_delay_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "reconnect_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "outbox_poll_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "outbox_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "description": "Becomes the RabbitMQ container's Kubernetes memory request and limit."
        },
        "queue_max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "certificate_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Duration of the cert-manager Certificate issued for the broker by the internal CA."
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "database",
        "key_prefix",
        "session_ttl_seconds",
        "memory_mb",
        "maxmemory_mb"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "integer",
          "minimum": 0
        },
        "key_prefix": {
          "type": "string",
          "minLength": 1
        },
        "session_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "description": "Becomes the Redis container's Kubernetes memory request and limit."
        },
        "maxmemory_mb": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "monthly_amount": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "USD"
            },
            "actual_thresholds": {
              "description": "Absolute currency amounts (in the budget's own currency) at which to notify \u2014 not fractions of monthly_amount.",
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "email_recipients": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "email"
              }
            }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "monthly_amount": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "USD"
            },
            "actual_thresholds": {
              "description": "Absolute currency amounts (in the budget's own currency) at which to notify \u2014 not fractions of monthly_amount.",
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "email_recipients": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "email"
              }
            },
            "billing_account_id": {
              "type": "string"
            }
          }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "monthly_amount": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "currency": {
              "description": "Azure bills in the subscription's own currency and the budget resource takes no currency argument; this records the expected one.",
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "USD"
            },
            "actual_thresholds": {
              "description": "Absolute currency amounts (in the budget's own currency) at which to notify \u2014 not fractions of monthly_amount.",
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "email_recipients": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "email"
              }
            },
            "start_date": {
              "description": "First of a month, UTC. Azure requires a start date and a computed one would replace the budget on every apply.",
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-01T00:00:00Z$"
            }
          }
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cloudflare DNS for the UI's public hostname. The API token comes from the CLOUDFLARE_API_TOKEN environment variable, never from this file.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "zone_name": {
          "description": "The apex zone that owns the UI hostname, e.g. \"example.com\".",
          "type": "string",
          "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
        },
        "ttl": {
          "description": "Record TTL in seconds: 1 for Cloudflare's automatic value, otherwise 60-86400.",
          "default": 60,
          "anyOf": [
            {
              "type": "integer",
              "const": 1
            },
            {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            }
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 100
        },
        "proxied": {
          "description": "Must stay false: proxying terminates TLS at Cloudflare's edge, so the ACME HTTP-01 solver on port 80 is never reached. Nothing applies this schema automatically - see docs/dns.md.",
          "type": "boolean",
          "const": false,
          "default": false
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "entry_node",
        "ssh_address_mode",
        "admin_allowed_cidrs",
        "api_endpoint",
        "pod_cidr",
        "service_cidr",
        "namespace",
        "etcd"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+\\+k3s\\d+$",
          "description": "Pinned k3s release, e.g. v1.33.1+k3s1. Ansible installs exactly this; floating channels are not used."
        },
        "entry_node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
          "description": "The one node that receives user traffic: both ingress.hostname and api_endpoint resolve to its address. Must name a key in vms, which this schema cannot check. Losing it takes down the website and the API endpoint with no automatic failover."
        },
        "ssh_address_mode": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ],
          "description": "public contacts nodes on their public addresses; private requires an existing route or VPN from the operator's machine."
        },
        "admin_allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
          },
          "description": "The only sources allowed to reach SSH and the Kubernetes API. There is no bastion; see docs/k3s-recovery.md for the break-glass path when this list stops matching reality."
        },
        "api_endpoint_mode": {
          "type": "string",
          "const": "node",
          "description": "Connect directly to node addresses without a cloud load balancer."
        },
        "api_endpoint": {
          "type": "string",
          "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$",
          "description": "Hostname clients and kubeconfig use for the Kubernetes API, and a TLS SAN on every server. There is no load balancer: it resolves to all three node addresses, so failover is client retry, not health checking."
        },
        "pod_cidr": {
          "type": "string",
          "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$",
          "description": "Overlap with service_cidr or a subnet is not detectable here and produces a half-working cluster."
        },
        "service_cidr": {
          "type": "string",
          "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "etcd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_schedule_cron",
            "snapshot_retention",
            "backup_destination"
          ],
          "properties": {
            "snapshot_schedule_cron": {
              "type": "string",
              "minLength": 9,
              "description": "Offset this per node: one schedule on all three servers makes them take the snapshot and upload cost together."
            },
            "snapshot_retention": {
              "type": "integer",
              "minimum": 1,
              "description": "Local snapshots kept per server."
            },
            "backup_destination": {
              "type": "string",
              "enum": [
                "cloud_object_storage",
                "none"
              ],
              "description": "Snapshots cover etcd only. PostgreSQL, RabbitMQ and Redis volumes need their own backups."
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "acme_email",
        "challenge_type"
      ],
      "properties": {
        "endpoint_mode": {
          "type": "string",
          "const": "node",
          "description": "Expose ingress directly on node addresses without a cloud load balancer."
        },
        "hostname": {
          "type": "string",
          "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$",
          "description": "Public hostname for the UI, and the name the ingress certificate is issued for. Resolves to all three node addresses; Traefik answers on host ports 80 and 443 on every node."
        },
        "acme_email": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "challenge_type": {
          "type": "string",
          "enum": [
            "http01",
            "dns01"
          ],
          "description": "http01 answers on port 80 and needs public DNS pointing at the ingress. dns01 is for private ingress or wildcard certificates."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "managed_database",
          "default_cloud"
        ],
        "properties": {
          "managed_database": {
            "const": true
          },
          "default_cloud": {
            "const": "aws"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "properties": {
              "aws": {
                "required": [
                  "rds_network"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "default_cloud": {
            "const": "gcp"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "required": [
              "gcp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "default_cloud": {
            "const": "aws"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "required": [
              "aws"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "default_cloud": {
            "const": "azure"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "required": [
              "azure"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "default_cloud",
          "managed_database"
        ],
        "properties": {
          "default_cloud": {
            "const": "azure"
          },
          "managed_database": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "properties": {
              "azure": {
                "required": [
                  "postgres_network"
                ]
              }
            }
          },
          "service_ports": {
            "properties": {
              "postgresql": {
                "const": 5432
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "managed_database"
        ],
        "properties": {
          "managed_database": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "database_profile",
          "database_profile_map"
        ]
      }
    },
    {
      "if": {
        "required": [
          "default_cloud",
          "managed_database"
        ],
        "properties": {
          "default_cloud": {
            "const": "gcp"
          },
          "managed_database": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "properties": {
              "gcp": {
                "required": [
                  "cloud_sql_network"
                ]
              }
            }
          },
          "service_ports": {
            "properties": {
              "postgresql": {
                "const": 5432
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "database_profile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "aws": {
          "$ref": "#/$defs/cloud_database_aws"
        },
        "gcp": {
          "$ref": "#/$defs/cloud_database_gcp"
        },
        "azure": {
          "$ref": "#/$defs/cloud_database_azure"
        }
      }
    },
    "cloud_database_azure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku_name",
        "postgres_version",
        "storage_mb",
        "storage_tier",
        "backup_retention_days",
        "high_availability",
        "standby_availability_zone"
      ],
      "properties": {
        "sku_name": {
          "type": "string",
          "pattern": "^(B|GP|MO)_Standard_[A-Za-z0-9_]+$"
        },
        "postgres_version": {
          "type": "string",
          "const": "18"
        },
        "storage_mb": {
          "type": "integer",
          "minimum": 32768
        },
        "storage_tier": {
          "type": "string",
          "enum": [
            "P4",
            "P6",
            "P10",
            "P15",
            "P20",
            "P30"
          ]
        },
        "backup_retention_days": {
          "description": "Flexible Server accepts 7-35 days; there is no one-day RDS equivalent.",
          "type": "integer",
          "minimum": 7,
          "maximum": 35
        },
        "high_availability": {
          "type": "string",
          "enum": [
            "Disabled",
            "SameZone",
            "ZoneRedundant"
          ]
        },
        "standby_availability_zone": {
          "description": "Required by ZoneRedundant high availability; null otherwise. Burstable SKUs support no high availability at all.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "1",
            "2",
            "3",
            null
          ]
        }
      }
    },
    "cloud_database_aws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_class",
        "engine_version",
        "allocated_storage_gb",
        "storage_type",
        "max_allocated_storage_gb",
        "multi_az",
        "backup_retention_days"
      ],
      "properties": {
        "instance_class": {
          "type": "string",
          "enum": [
            "db.t4g.micro",
            "db.t3.micro"
          ]
        },
        "engine_version": {
          "type": "string",
          "const": "18"
        },
        "allocated_storage_gb": {
          "type": "integer",
          "const": 20
        },
        "storage_type": {
          "type": "string",
          "const": "gp2"
        },
        "max_allocated_storage_gb": {
          "type": "integer",
          "const": 0
        },
        "multi_az": {
          "type": "boolean",
          "const": false
        },
        "backup_retention_days": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "cloud_database_gcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "disk_size_gb",
        "database_version",
        "backup_retained_count",
        "availability_type",
        "edition",
        "disk_type",
        "disk_autoresize"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "minLength": 1
        },
        "disk_size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "database_version": {
          "type": "string",
          "const": "POSTGRES_18"
        },
        "backup_retained_count": {
          "type": "integer",
          "minimum": 1
        },
        "availability_type": {
          "type": "string",
          "enum": [
            "ZONAL",
            "REGIONAL"
          ]
        },
        "edition": {
          "type": "string",
          "enum": [
            "ENTERPRISE",
            "ENTERPRISE_PLUS"
          ]
        },
        "disk_type": {
          "type": "string",
          "enum": [
            "PD_SSD",
            "PD_HDD"
          ]
        },
        "disk_autoresize": {
          "type": "boolean"
        }
      }
    },
    "cloud_name": {
      "type": "string",
      "enum": [
        "gcp",
        "aws",
        "azure"
      ]
    },
    "per_cloud_string": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gcp",
        "aws",
        "azure"
      ],
      "properties": {
        "gcp": {
          "type": "string",
          "minLength": 1
        },
        "aws": {
          "type": "string",
          "minLength": 1
        },
        "azure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "per_cloud_image": {
      "$comment": "Images are the one map whose branches are not all strings: an Azure marketplace image is addressed by four coordinates, so it has a definition of its own rather than widening per_cloud_string.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gcp",
        "aws",
        "azure"
      ],
      "properties": {
        "gcp": {
          "type": "string",
          "minLength": 1
        },
        "aws": {
          "type": "string",
          "minLength": 1
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisher",
            "offer",
            "sku",
            "version"
          ],
          "properties": {
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "offer": {
              "type": "string",
              "minLength": 1
            },
            "sku": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "region_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gcp",
        "aws",
        "azure"
      ],
      "properties": {
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "location",
            "availability_zone"
          ],
          "properties": {
            "location": {
              "type": "string",
              "minLength": 1
            },
            "availability_zone": {
              "type": "string",
              "enum": [
                "1",
                "2",
                "3"
              ]
            }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "zone"
          ],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "availability_zone"
          ],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "availability_zone": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "control-plane",
          "worker"
        ]
      },
      "description": "Both tags, on every node. Membership only: a tag installs nothing. Kubernetes role labels are applied separately by Ansible."
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "size",
        "image",
        "disk_type",
        "disk_size_gb",
        "internal_ip",
        "assign_public_ip",
        "network_tags"
      ],
      "properties": {
        "role": {
          "type": "string",
          "const": "kubernetes",
          "description": "The only role. Administrative SSH sources are configured once at kubernetes.admin_allowed_cidrs, never per VM."
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "Key into size_map."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Key into image_map."
        },
        "disk_type": {
          "type": "string",
          "minLength": 1,
          "description": "Key into disk_type_map."
        },
        "disk_size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "internal_ip": {
          "type": "string",
          "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/vm_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      },
      "description": "A Kubernetes node. Every node runs a k3s server with embedded etcd and also schedules workloads."
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Immutable image reference. Tags are never deployed."
    },
    "workload_secret_mappings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secret Manager IDs each workload may read, keyed by workload. Per-workload rather than flat so services keep separate database credentials. rabbitmq and redis are the platform services themselves, which need the credential their clients authenticate with. Names only - never values.",
      "required": [
        "history",
        "fetcher",
        "ui"
      ],
      "properties": {
        "history": {
          "$ref": "#/$defs/secret_mappings"
        },
        "fetcher": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ui": {
          "$ref": "#/$defs/secret_mappings"
        },
        "migration": {
          "$ref": "#/$defs/secret_mappings"
        },
        "rabbitmq": {
          "$ref": "#/$defs/secret_mappings"
        },
        "redis": {
          "$ref": "#/$defs/secret_mappings"
        }
      }
    }
  }
}
