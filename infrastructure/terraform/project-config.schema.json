{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OilScope multi-cloud project configuration",
  "description": "Non-secret shared configuration consumed by Terraform and Ansible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "defaults",
    "clouds",
    "environment",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "service_ports",
    "secrets_by_role",
    "vms"
  ],
  "properties": {
    "default_cloud": { "$ref": "#/$defs/cloud_name" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_profile",
        "machine_profile",
        "image_profile",
        "disk_profile"
      ],
      "properties": {
        "location_profile": { "$ref": "#/$defs/profile_name" },
        "machine_profile": { "$ref": "#/$defs/profile_name" },
        "image_profile": { "$ref": "#/$defs/profile_name" },
        "disk_profile": { "$ref": "#/$defs/profile_name" }
      }
    },
    "clouds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "allOf": [
            { "$ref": "#/$defs/cloud_catalog" },
            {
              "type": "object",
              "required": ["project_id"],
              "properties": {
                "project_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
                }
              }
            }
          ]
        },
        "aws": {
          "allOf": [
            { "$ref": "#/$defs/cloud_catalog" },
            {
              "type": "object",
              "properties": {
                "bastion_nat": { "type": "boolean" },
                "free_tier_guardrails": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": { "$ref": "#/$defs/labels" },
    "observability": { "$ref": "#/$defs/observability" },
    "ssh_users": { "$ref": "#/$defs/ssh_users" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "username", "image_sha"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vpc_cidr",
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "public_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "vpc_cidr": { "type": "string", "minLength": 1 },
        "management_subnet_cidr": { "type": "string", "minLength": 1 },
        "workload_subnet_cidr": { "type": "string", "minLength": 1 },
        "public_subnet_cidr": { "type": "string", "minLength": 1 },
        "ui_public_ports": {
          "type": "array",
          "items": { "type": "integer", "enum": [80, 443] },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_api", "postgresql"],
      "properties": {
        "history_api": { "$ref": "#/$defs/port" },
        "postgresql": { "$ref": "#/$defs/port" }
      }
    },
    "secrets_by_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "history", "fetcher", "ui"],
      "properties": {
        "database": { "$ref": "#/$defs/secret_mappings" },
        "history": { "$ref": "#/$defs/secret_mappings" },
        "fetcher": { "$ref": "#/$defs/secret_mappings" },
        "ui": { "$ref": "#/$defs/secret_mappings" }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": ["bastion"],
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
      "properties": {
        "bastion": {
          "allOf": [
            { "$ref": "#/$defs/vm" },
            {
              "properties": { "role": { "const": "bastion" } },
              "required": ["role"]
            }
          ]
        }
      },
      "additionalProperties": { "$ref": "#/$defs/vm" }
    }
  },
  "$defs": {
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "alert_email", "monthly_budget_usd", "synthetic_url"],
      "properties": {
        "enabled": { "type": "boolean" },
        "alert_email": { "type": "string", "format": "email" },
        "monthly_budget_usd": { "type": "number", "exclusiveMinimum": 0 },
        "synthetic_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "log_retention_days": { "type": "integer", "enum": [1, 3, 5, 7, 14, 30, 60, 90] }
      }
    },
    "cloud_name": {
      "type": "string",
      "enum": ["aws", "gcp"]
    },
    "profile_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "string_catalog": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "locations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "zone"],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "zone": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cloud_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locations", "machine_types", "disk_types", "images"],
      "properties": {
        "project_id": { "type": "string" },
        "locations": { "$ref": "#/$defs/locations" },
        "machine_types": { "$ref": "#/$defs/string_catalog" },
        "disk_types": { "$ref": "#/$defs/string_catalog" },
        "images": { "$ref": "#/$defs/string_catalog" },
        "bastion_nat": { "type": "boolean" },
        "free_tier_guardrails": { "type": "boolean" }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_gb"],
      "properties": {
        "size_gb": { "type": "integer", "minimum": 8 },
        "profile": { "$ref": "#/$defs/profile_name" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "ssh_users": {
      "$comment": "Linux usernames mapped to public SSH keys. Private keys are forbidden.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bastion", "infra", "history", "fetcher", "ui"]
      }
    },
    "secret_mappings": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.\/-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "network_tags"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["bastion", "database", "history", "fetcher", "ui"]
        },
        "cloud": { "$ref": "#/$defs/cloud_name" },
        "machine_profile": { "$ref": "#/$defs/profile_name" },
        "image_profile": { "$ref": "#/$defs/profile_name" },
        "internal_ip": { "type": "string", "minLength": 1 },
        "boot_disk": { "$ref": "#/$defs/boot_disk" },
        "assign_public_ip": { "type": "boolean" },
        "network_tags": { "$ref": "#/$defs/vm_network_tags" },
        "labels": { "$ref": "#/$defs/labels" },
        "ssh_port": { "$ref": "#/$defs/port" },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "acme_email"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "assign_public_ip": { "const": true } },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": { "role": { "enum": ["bastion", "ui"] } }
          }
        },
        {
          "if": {
            "properties": { "role": { "const": "bastion" } },
            "required": ["role"]
          },
          "then": {
            "required": ["ssh_port", "allowed_cidrs"],
            "properties": {
              "assign_public_ip": { "const": true },
              "network_tags": { "contains": { "const": "bastion" } }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["ssh_port"] },
                { "required": ["allowed_cidrs"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "role": { "const": "ui" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "network_tags": { "contains": { "const": "ui" } }
            }
          }
        }
      ]
    }
  }
}
