{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret, multi-cloud Terraform project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "vm_defaults",
    "clouds",
    "locations",
    "provider_mappings",
    "environment",
    "name_prefix",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "vms"
  ],
  "properties": {
    "default_cloud": {
      "$ref": "#/$defs/cloud"
    },
    "vm_defaults": {
      "$ref": "#/$defs/vm_defaults"
    },
    "clouds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "secret_version_managers"],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            },
            "secret_version_managers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(user|group|serviceAccount|principal|principalSet):.+$"
              }
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_id"],
          "properties": {
            "account_id": {
              "type": "string",
              "pattern": "^[0-9]{12}$"
            }
          }
        }
      }
    },
    "locations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/location"
      }
    },
    "provider_mappings": {
      "$ref": "#/$defs/provider_mappings"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "image_sha"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vpc_cidr",
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "enable_bastion_ssh_bootstrap",
        "ui_public_ports"
      ],
      "properties": {
        "vpc_cidr": {
          "type": "string",
          "minLength": 1
        },
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "enable_bastion_ssh_bootstrap": {
          "type": "boolean"
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [80, 443]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": ["bastion"],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            { "$ref": "#/$defs/vm" },
            {
              "type": "object",
              "properties": {
                "role": { "const": "bastion" }
              },
              "required": ["role"]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    }
  },
  "$defs": {
    "cloud": {
      "type": "string",
      "enum": ["gcp", "aws"]
    },
    "logical_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "disk_type": {
      "type": "string",
      "enum": ["standard", "balanced", "ssd"]
    },
    "vm_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "disk_type"],
      "properties": {
        "image": {
          "$ref": "#/$defs/logical_name"
        },
        "disk_type": {
          "$ref": "#/$defs/disk_type"
        }
      }
    },
    "provider_mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_types", "disk_types", "images"],
      "properties": {
        "instance_types": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/provider_instance_type"
          }
        },
        "disk_types": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": ["standard", "balanced", "ssd"]
          },
          "additionalProperties": {
            "$ref": "#/$defs/provider_disk_type"
          }
        },
        "images": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/provider_image"
          }
        }
      }
    },
    "provider_instance_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machine_type"],
          "properties": {
            "machine_type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instance_type"],
          "properties": {
            "instance_type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "provider_disk_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "type": "string",
          "enum": ["pd-standard", "pd-balanced", "pd-ssd"]
        },
        "aws": {
          "type": "string",
          "enum": ["gp2", "gp3", "io1", "io2", "standard"]
        }
      }
    },
    "provider_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ssm_parameter"],
          "properties": {
            "ssm_parameter": {
              "type": "string",
              "pattern": "^/aws/service/canonical/ubuntu/.+/ami-id$"
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcp", "aws"],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "zone"],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "availability_zone"],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "availability_zone": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret cloud secret IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "size",
        "location",
        "internal_ip",
        "assign_public_ip",
        "secret_mappings"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["bastion", "database", "history", "fetcher", "ui"]
        },
        "cloud": {
          "$ref": "#/$defs/cloud"
        },
        "image": {
          "$ref": "#/$defs/logical_name"
        },
        "disk_type": {
          "$ref": "#/$defs/disk_type"
        },
        "size": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "location": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "internal_ip": {
          "type": "string",
          "minLength": 1
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "acme_email"],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": { "const": true }
            },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": {
              "role": { "enum": ["bastion", "ui"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": { "const": "bastion" }
            },
            "required": ["role"]
          },
          "then": {
            "required": ["ssh_port", "allowed_cidrs"],
            "properties": {
              "assign_public_ip": { "const": true },
              "secret_mappings": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["ssh_port"] },
                { "required": ["allowed_cidrs"] }
              ]
            }
          }
        }
      ]
    }
  }
}
