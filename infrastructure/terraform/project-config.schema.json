{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Contract for non-secret Terraform project configuration. Cloud-neutral: VMs reference abstract size/image/disk_type/region tiers resolved per-cloud via the *_map dictionaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "default_cloud",
    "default_db",
    "region",
    "environment",
    "name_prefix",
    "size_map",
    "region_map",
    "disk_type_map",
    "image_map",
    "clouds",
    "network",
    "ssh_users",
    "registry",
    "service_ports",
    "vms",
    "rabbitmq",
    "redis"
  ],
  "properties": {
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email_recipients"
      ],
      "properties": {
        "email_recipients": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          },
          "description": "Operational alert email recipients. An empty list configures no email recipients."
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "logs_enabled": {
          "type": "boolean",
          "default": true
        },
        "alarms_enabled": {
          "type": "boolean",
          "default": false
        },
        "dashboard_enabled": {
          "type": "boolean",
          "default": false
        },
        "agent_metrics_enabled": {
          "type": "boolean",
          "default": false
        },
        "log_retention_days": {
          "type": "integer",
          "enum": [
            1,
            3,
            5,
            7,
            14,
            30,
            60,
            90,
            120,
            150,
            180,
            365,
            400,
            545,
            731,
            1096,
            1827,
            2192,
            2557,
            2922,
            3288,
            3653
          ],
          "default": 7
        },
        "cpu_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 80
        },
        "memory_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 85
        },
        "disk_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "default": 85
        },
        "http_error_threshold": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "disk_fstype": {
          "type": "string",
          "minLength": 1,
          "default": "ext4"
        },
        "synthetics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "hostname": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "pattern": "^/",
              "default": "/health"
            },
            "period_minutes": {
              "type": "integer",
              "enum": [
                5,
                10,
                15,
                30,
                60
              ],
              "default": 5
            },
            "runtime_version": {
              "type": "string",
              "pattern": "^syn-nodejs-puppeteer-(1[3-9]|[2-9][0-9])\\.[0-9]+$",
              "default": "syn-nodejs-puppeteer-17.0"
            },
            "clouds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "aws",
                  "gcp"
                ]
              },
              "uniqueItems": true,
              "description": "Explicit probe providers; null retains selection by VM presence."
            },
            "browser_enabled": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "application_metrics_enabled": {
          "type": "boolean",
          "default": false
        },
        "service_logs_enabled": {
          "type": "boolean",
          "default": false
        },
        "database_metrics_enabled": {
          "type": "boolean",
          "default": false
        },
        "detailed_monitoring_enabled": {
          "type": "boolean",
          "default": false
        },
        "outbox_count_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 100
        },
        "outbox_age_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 600
        },
        "rabbitmq_queue_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1000
        },
        "rabbitmq_unacked_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 100
        },
        "rabbitmq_dead_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "redis_memory_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 85
        },
        "freshness_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 28800
        },
        "database_connections_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 80
        },
        "database_free_storage_bytes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1073741824
        },
        "database_cpu_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 80
        },
        "database_disk_threshold_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 85
        }
      }
    },
    "default_cloud": {
      "$ref": "#/$defs/cloud_name",
      "description": "Which cloud this apply targets. Single-cloud-per-apply: every VM in `vms` deploys here."
    },
    "default_db": {
      "type": "string",
      "enum": [
        "application",
        "cloud"
      ],
      "description": "Database hosting mode: application uses PostgreSQL on the database VM; cloud uses managed PostgreSQL on the selected default_cloud."
    },
    "database_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Key into database_profile_map; used in cloud database mode."
    },
    "database_profile_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/database_profile"
      }
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "description": "Key into region_map. Not cross-validated by this schema \u2014 an unknown key fails loudly at `terraform plan` via a plain map lookup."
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "stage",
        "prod"
      ]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "size_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/per_cloud_string"
      },
      "description": "Abstract size tiers (e.g. \"small\") to native machine/instance type per cloud."
    },
    "region_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/region_entry"
      },
      "description": "Abstract region keys (e.g. \"eu-central\") to native region/zone per cloud."
    },
    "disk_type_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/per_cloud_string"
      },
      "description": "Abstract disk tiers (e.g. \"balanced\") to native disk/volume type per cloud."
    },
    "image_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/per_cloud_string"
      },
      "description": "Abstract image keys (e.g. \"ubuntu-26.04\") to native image reference per cloud. For aws this must be an SSM parameter path starting with /, which the aws module resolves to an AMI ID. Direct AMI IDs are not supported."
    },
    "clouds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id"
          ],
          "properties": {
            "cloud_sql_network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allocated_cidr",
                "dns_ttl_seconds"
              ],
              "properties": {
                "allocated_cidr": {
                  "type": "string",
                  "minLength": 1
                },
                "dns_ttl_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vpc_cidr"
          ],
          "properties": {
            "vpc_cidr": {
              "type": "string",
              "minLength": 1
            },
            "rds_network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "secondary_subnet_cidr",
                "secondary_availability_zone"
              ],
              "properties": {
                "secondary_subnet_cidr": {
                  "type": "string",
                  "minLength": 1
                },
                "secondary_availability_zone": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "ui_public_ports"
      ],
      "properties": {
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              80,
              443
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "username",
        "image_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_api",
        "postgresql"
      ],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 2,
      "required": [
        "bastion"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "role": {
                  "const": "bastion"
                }
              },
              "required": [
                "role"
              ]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    },
    "rabbitmq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_vm",
        "image",
        "port",
        "username",
        "vhost",
        "exchange",
        "queue",
        "routing_key",
        "retry_delay_ms",
        "max_attempts",
        "timeout_seconds",
        "reconnect_seconds",
        "outbox_poll_seconds",
        "outbox_batch_size",
        "memory_mb",
        "queue_max_bytes",
        "certificate_days"
      ],
      "properties": {
        "host_vm": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "vhost": {
          "type": "string",
          "minLength": 1
        },
        "exchange": {
          "type": "string",
          "minLength": 1
        },
        "queue": {
          "type": "string",
          "minLength": 1
        },
        "routing_key": {
          "type": "string",
          "minLength": 1
        },
        "retry_delay_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "reconnect_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "outbox_poll_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "outbox_batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "queue_max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "certificate_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_vm",
        "image",
        "database",
        "key_prefix",
        "session_ttl_seconds",
        "memory_mb",
        "maxmemory_mb"
      ],
      "properties": {
        "host_vm": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "integer",
          "minimum": 0
        },
        "key_prefix": {
          "type": "string",
          "minLength": 1
        },
        "session_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "maxmemory_mb": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "monthly_amount": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "USD"
            },
            "actual_thresholds": {
              "description": "Absolute currency amounts (in the budget's own currency) at which to notify \u2014 not fractions of monthly_amount.",
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "email_recipients": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "email"
              }
            }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "monthly_amount": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "USD"
            },
            "actual_thresholds": {
              "description": "Absolute currency amounts (in the budget's own currency) at which to notify \u2014 not fractions of monthly_amount.",
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "email_recipients": {
              "type": "array",
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "email"
              }
            },
            "billing_account_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cloudflare DNS for the UI's public hostname. The API token comes from the CLOUDFLARE_API_TOKEN environment variable, never from this file.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "zone_name": {
          "description": "The apex zone that owns the UI hostname, e.g. \"example.com\".",
          "type": "string",
          "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
        },
        "ttl": {
          "description": "Record TTL in seconds: 1 for Cloudflare's automatic value, otherwise 60-86400.",
          "default": 60,
          "anyOf": [
            {
              "type": "integer",
              "const": 1
            },
            {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            }
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 100
        },
        "proxied": {
          "description": "Must stay false: proxying breaks Traefik's ACME TLS-ALPN-01 challenge.",
          "type": "boolean",
          "const": false,
          "default": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "default_db",
          "default_cloud"
        ],
        "properties": {
          "default_db": {
            "const": "cloud"
          },
          "default_cloud": {
            "const": "aws"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "properties": {
              "aws": {
                "required": [
                  "rds_network"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "default_cloud": {
            "const": "gcp"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "required": [
              "gcp"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "default_cloud": {
            "const": "aws"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "required": [
              "aws"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "default_db"
        ],
        "properties": {
          "default_db": {
            "const": "cloud"
          }
        }
      },
      "then": {
        "required": [
          "database_profile",
          "database_profile_map"
        ],
        "properties": {
          "vms": {
            "additionalProperties": {
              "properties": {
                "role": {
                  "not": {
                    "const": "database"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "vms": {
            "$comment": "Reject a dictionary in which every VM has a non-database role, requiring at least one database VM in application mode.",
            "not": {
              "additionalProperties": {
                "properties": {
                  "role": {
                    "not": {
                      "const": "database"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "default_cloud",
          "default_db"
        ],
        "properties": {
          "default_cloud": {
            "const": "gcp"
          },
          "default_db": {
            "const": "cloud"
          }
        }
      },
      "then": {
        "properties": {
          "clouds": {
            "properties": {
              "gcp": {
                "required": [
                  "cloud_sql_network"
                ]
              }
            }
          },
          "service_ports": {
            "properties": {
              "postgresql": {
                "const": 5432
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "database_profile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "aws": {
          "$ref": "#/$defs/cloud_database_aws"
        },
        "gcp": {
          "$ref": "#/$defs/cloud_database_gcp"
        }
      }
    },
    "cloud_database_aws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_class",
        "engine_version",
        "allocated_storage_gb",
        "storage_type",
        "max_allocated_storage_gb",
        "multi_az",
        "backup_retention_days"
      ],
      "properties": {
        "instance_class": {
          "type": "string",
          "enum": [
            "db.t4g.micro",
            "db.t3.micro"
          ]
        },
        "engine_version": {
          "type": "string",
          "const": "18"
        },
        "allocated_storage_gb": {
          "type": "integer",
          "const": 20
        },
        "storage_type": {
          "type": "string",
          "const": "gp2"
        },
        "max_allocated_storage_gb": {
          "type": "integer",
          "const": 0
        },
        "multi_az": {
          "type": "boolean",
          "const": false
        },
        "backup_retention_days": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "cloud_database_gcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "disk_size_gb",
        "database_version",
        "backup_retained_count",
        "availability_type",
        "edition",
        "disk_type",
        "disk_autoresize"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "minLength": 1
        },
        "disk_size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "database_version": {
          "type": "string",
          "const": "POSTGRES_18"
        },
        "backup_retained_count": {
          "type": "integer",
          "minimum": 1
        },
        "availability_type": {
          "type": "string",
          "enum": [
            "ZONAL",
            "REGIONAL"
          ]
        },
        "edition": {
          "type": "string",
          "enum": [
            "ENTERPRISE",
            "ENTERPRISE_PLUS"
          ]
        },
        "disk_type": {
          "type": "string",
          "enum": [
            "PD_SSD",
            "PD_HDD"
          ]
        },
        "disk_autoresize": {
          "type": "boolean"
        }
      }
    },
    "cloud_name": {
      "type": "string",
      "enum": [
        "gcp",
        "aws"
      ]
    },
    "per_cloud_string": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gcp",
        "aws"
      ],
      "properties": {
        "gcp": {
          "type": "string",
          "minLength": 1
        },
        "aws": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "region_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gcp",
        "aws"
      ],
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "zone"
          ],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "availability_zone"
          ],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "availability_zone": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "vm_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "bastion",
          "infra",
          "history",
          "fetcher",
          "ui"
        ]
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret Secret Manager IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "size",
        "image",
        "disk_type",
        "disk_size_gb",
        "internal_ip",
        "assign_public_ip",
        "network_tags",
        "secret_mappings"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "bastion",
            "database",
            "history",
            "fetcher",
            "ui"
          ]
        },
        "cloud": {
          "$ref": "#/$defs/cloud_name",
          "description": "Overrides default_cloud for this VM only. Omit to inherit default_cloud."
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "Key into size_map."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Key into image_map."
        },
        "disk_type": {
          "type": "string",
          "minLength": 1,
          "description": "Key into disk_type_map."
        },
        "disk_size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "internal_ip": {
          "type": "string",
          "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/vm_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "secret_mappings": {
          "$ref": "#/$defs/secret_mappings",
          "description": "Required on every VM. Use {} if this VM has no secrets to resolve."
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostname",
            "acme_email"
          ],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": [
              "assign_public_ip"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "enum": [
                  "bastion",
                  "ui"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "bastion"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "ssh_port",
              "allowed_cidrs"
            ],
            "properties": {
              "assign_public_ip": {
                "const": true
              },
              "network_tags": {
                "contains": {
                  "const": "bastion"
                }
              },
              "secret_mappings": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ssh_port"
                  ]
                },
                {
                  "required": [
                    "allowed_cidrs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ui"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "public_endpoint"
            ],
            "properties": {
              "network_tags": {
                "contains": {
                  "const": "ui"
                }
              }
            }
          }
        }
      ]
    }
  }
}
