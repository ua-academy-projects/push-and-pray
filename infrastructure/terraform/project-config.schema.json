{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Non-secret project configuration shared by infrastructure and application deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "name_prefix",
    "default_cloud",
    "default_region",
    "clouds",
    "cloud_mappings",
    "common_labels",
    "ssh_users",
    "registry",
    "network",
    "service_ports",
    "vms",
    "application"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "stage",
        "prod"
      ]
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "maxLength": 20
    },
    "default_cloud": {
      "$ref": "#/$defs/cloud_name"
    },
    "default_region": {
      "$ref": "#/$defs/logical_name"
    },
    "clouds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "cloud_mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regions",
        "sizes",
        "disk_types",
        "images"
      ],
      "properties": {
        "regions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/logical_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/region_mapping"
          }
        },
        "sizes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/logical_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/string_mapping"
          }
        },
        "disk_types": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/logical_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/string_mapping"
          }
        },
        "images": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/logical_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/image_mapping"
          }
        }
      }
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "ssh_users": {
      "$ref": "#/$defs/ssh_users"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "username",
        "image_sha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "pattern": "^(?=.{1,39}$)[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "image_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Shared deployment source commit SHA. CI tags database, history, fetcher, and UI images with this same full github.sha."
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vpc_cidr",
        "management_subnet_cidr",
        "workload_subnet_cidr",
        "aws_enable_nat_gateway",
        "ui_public_ports"
      ],
      "properties": {
        "vpc_cidr": {
          "type": "string",
          "minLength": 1
        },
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "aws_enable_nat_gateway": {
          "type": "boolean"
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              80,
              443
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_api",
        "postgresql"
      ],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "monitoring": {
      "description": "Optional provider-neutral monitoring configuration.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "notification_email",
        "cpu"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "notification_email": {
          "type": "string",
          "format": "email",
          "minLength": 3
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "threshold_percent",
            "duration_minutes"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "threshold_percent": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "duration_minutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "vm_health": {
          "description": "Optional provider-native VM impairment monitoring. Support varies by cloud.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "lifecycle": {
          "description": "Optional lifecycle-state notifications translated by each cloud provider.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "notify_states"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "notify_states": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "stopped",
                  "terminated"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    },
    "vms": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "required": [
        "bastion"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "properties": {
        "bastion": {
          "allOf": [
            {
              "$ref": "#/$defs/vm"
            },
            {
              "properties": {
                "role": {
                  "const": "bastion"
                }
              },
              "required": [
                "role"
              ]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/vm"
      }
    },
    "application": {
      "description": "Application deployment settings. Terraform consumes only secret IDs for containers and IAM.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_mappings",
        "public_endpoint"
      ],
      "properties": {
        "secret_mappings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "database",
            "history",
            "fetcher",
            "ui"
          ],
          "properties": {
            "database": {
              "$ref": "#/$defs/secret_mappings"
            },
            "history": {
              "$ref": "#/$defs/secret_mappings"
            },
            "fetcher": {
              "$ref": "#/$defs/secret_mappings"
            },
            "ui": {
              "$ref": "#/$defs/secret_mappings"
            }
          }
        },
        "public_endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostname",
            "acme_email"
          ],
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$"
            },
            "acme_email": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cloud_name": {
      "type": "string",
      "enum": [
        "gcp",
        "aws"
      ]
    },
    "logical_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "string_mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "string",
          "minLength": 1
        },
        "aws": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1
    },
    "region_mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "zone"
          ],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region",
            "zone"
          ],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1
            },
            "zone": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minProperties": 1
    },
    "image_mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "family"
          ],
          "properties": {
            "project": {
              "type": "string",
              "minLength": 1
            },
            "family": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owners",
            "name_pattern"
          ],
          "properties": {
            "owners": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{12}$"
              }
            },
            "name_pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minProperties": 1
    },
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_gb",
        "type"
      ],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "type": {
          "$ref": "#/$defs/logical_name"
        }
      }
    },
    "labels": {
      "type": "object",
      "$comment": "Identity labels are managed by Terraform and cannot be overridden by user metadata.",
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          {
            "not": {
              "enum": [
                "Name",
                "application",
                "cloud",
                "environment",
                "managed_by",
                "role"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{0,63}$"
      }
    },
    "ssh_users": {
      "$comment": "Maps Linux usernames to public SSH keys. Private keys and local key-file paths are not accepted.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( .+)?$"
      }
    },
    "secret_mappings": {
      "$comment": "Maps application environment variable names to non-secret secret container IDs.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "size",
        "image",
        "boot_disk",
        "assign_public_ip"
      ],
      "properties": {
        "cloud": {
          "$ref": "#/$defs/cloud_name"
        },
        "region": {
          "$ref": "#/$defs/logical_name"
        },
        "role": {
          "type": "string",
          "enum": [
            "bastion",
            "database",
            "history",
            "fetcher",
            "ui"
          ]
        },
        "size": {
          "$ref": "#/$defs/logical_name"
        },
        "image": {
          "$ref": "#/$defs/logical_name"
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": [
              "assign_public_ip"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "enum": [
                  "bastion",
                  "ui"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "bastion"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "ssh_port",
              "allowed_cidrs"
            ],
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ssh_port"
                  ]
                },
                {
                  "required": [
                    "allowed_cidrs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ui"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
