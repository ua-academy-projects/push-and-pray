{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration",
  "description": "Versioned contract for non-secret Terraform project configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "project_id",
    "environment",
    "region",
    "zone",
    "name_prefix",
    "image_repository",
    "compose_repository_url",
    "docker_engine_version",
    "common_labels",
    "network",
    "service_ports",
    "bastion",
    "workloads"
  ],
  "properties": {
    "config_version": {
      "type": "integer",
      "const": 2
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "zone": {
      "type": "string",
      "minLength": 1
    },
    "name_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "common_labels": {
      "$ref": "#/$defs/labels"
    },
    "image_repository": {
      "type": "string",
      "pattern": "^ghcr.io/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "compose_repository_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "docker_engine_version": {
      "type": "string",
      "minLength": 1
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management_subnet_cidr", "workload_subnet_cidr"],
      "properties": {
        "management_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "workload_subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "ui_public_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [80, 443]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "service_ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_api", "postgresql"],
      "properties": {
        "history_api": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "postgresql": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "bastion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_type",
        "image",
        "boot_disk",
        "ssh_port",
        "allowed_cidrs",
        "network_tags",
        "preemptible"
      ],
      "properties": {
        "machine_type": {
          "$ref": "#/$defs/machine_type"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "network_tags": {
          "$ref": "#/$defs/bastion_network_tags"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "preemptible": {
          "type": "boolean"
        }
      }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workload"
      }
    }
  },
  "$defs": {
    "boot_disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_gb", "type"],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 10
        },
        "type": {
          "type": "string",
          "enum": ["pd-standard", "pd-balanced", "pd-ssd"]
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "machine_type": {
      "type": "string",
      "enum": ["e2-micro", "e2-small", "e2-medium", "e2-standard-2"]
    },
    "bastion_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bastion"]
      }
    },
    "workload_network_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["infra", "history", "fetcher", "ui"]
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "machine_type",
        "image",
        "internal_ip",
        "boot_disk",
        "assign_public_ip",
        "network_tags",
        "automation_role",
        "image_tag",
        "secret_ids"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["database", "history", "fetcher", "ui"]
        },
        "machine_type": {
          "$ref": "#/$defs/machine_type"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "internal_ip": {
          "type": "string",
          "minLength": 1
        },
        "boot_disk": {
          "$ref": "#/$defs/boot_disk"
        },
        "assign_public_ip": {
          "type": "boolean"
        },
        "network_tags": {
          "$ref": "#/$defs/workload_network_tags"
        },
        "automation_role": {
          "type": "string",
          "enum": ["none", "database", "fetcher", "history", "ui"]
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "image_tag": {
          "type": "string",
          "minLength": 1
        },
        "secret_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "secret_bindings": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assign_public_ip": {
                "const": true
              }
            },
            "required": ["assign_public_ip"]
          },
          "then": {
            "properties": {
              "role": {
                "const": "ui"
              }
            }
          }
        }
      ]
    }
  }
}
