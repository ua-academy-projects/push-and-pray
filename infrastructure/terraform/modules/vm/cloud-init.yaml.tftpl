#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - jq
  - netcat-openbsd

write_files:
  - path: /usr/local/sbin/oil-tracker-deploy
    permissions: '0750'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail

      role="${automation_role}"
      project_id="${project_id}"
      compose_repository_url="${compose_repository_url}"
      image_repository="${image_repository}"
      image_tag="${image_tag}"
      runtime_dir=/opt/oil-price-tracker
      compose_file="$${runtime_dir}/compose.$${role}.yaml"
      [[ "$${role}" == "none" ]] && exit 0

      install -d -o root -g root -m 0750 "$${runtime_dir}"
      curl -fsSL "$${compose_repository_url}/infrastructure/docker/compose.$${role}.yaml" -o "$${compose_file}.tmp"
      mv -f "$${compose_file}.tmp" "$${compose_file}"

      token="$(curl -fsS -H 'Metadata-Flavor: Google' \
        http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token | jq -er .access_token)"
      access_secret() {
        local secret_id="$1"
        curl -fsS \
          -H "Authorization: Bearer $${token}" \
          "https://secretmanager.googleapis.com/v1/projects/$${project_id}/secrets/$${secret_id}/versions/latest:access" |
          jq -er .payload.data |
          base64 -d
      }

      export DB_LAN_IP="${service_ips["database"]}"
      export HISTORY_LAN_IP="${service_ips["history"]}"
      export FETCHER_LAN_IP="${service_ips["fetcher"]}"
      export UI_LAN_IP="${service_ips["ui"]}"
      export IMAGE_TAG="${image_tag}"
      export IMAGE_REPOSITORY="${image_repository}"
      case "$${role}" in
        fetcher) export FETCHER_IMAGE="$${image_repository}/fetcher:$${image_tag}" ;;
        history) export HISTORY_IMAGE="$${image_repository}/history:$${image_tag}" ;;
        ui) export UI_IMAGE="$${image_repository}/ui:$${image_tag}" ;;
        database) export POSTGRES_IMAGE="ghcr.io/pgmq/pg18-pgmq:v1.12.0" ;;
      esac

      compose_env=()
%{ for environment_name, secret_id in secret_bindings ~}
      secret_value="$(access_secret ${jsonencode(secret_id)})"
      export ${environment_name}="$${secret_value}"
      compose_env+=("${environment_name}=$${secret_value}")
%{ endfor ~}

      if [[ -n "$${GHCR_USERNAME:-}" && -n "$${GHCR_TOKEN:-}" ]]; then
        printf '%s' "$${GHCR_TOKEN}" |
          docker login ghcr.io --username "$${GHCR_USERNAME}" --password-stdin >/dev/null
      fi

      if [[ "$${role}" != "database" ]]; then
        for attempt in $(seq 1 60); do
          if nc -z -w 2 "$${DB_LAN_IP}" 5432; then
            break
          fi
          [[ "$${attempt}" == 60 ]] && { echo "PostgreSQL did not become reachable" >&2; exit 1; }
          sleep 2
        done
      fi

      printf '%s\n' "$${compose_env[@]}" |
        docker compose --env-file /dev/stdin --file "$${compose_file}" \
          --project-name "petroscope-$${role}" up --detach --no-build --remove-orphans

      if [[ "$${role}" == "database" ]]; then
        for migration in 001_create_price_observations.sql 002_add_source_observed_at.sql 003_create_ui_sessions.sql 004_create_pgmq_queue.sql 005_create_published_queue_events.sql; do
          curl -fsSL "$${compose_repository_url}/database/migrations/$${migration}" -o "/tmp/$${migration}"
          docker compose --file "$${compose_file}" --project-name petroscope-database exec -T postgres \
            psql -v ON_ERROR_STOP=1 -U oil_tracker -d oil_tracker < "/tmp/$${migration}"
          rm -f "/tmp/$${migration}"
        done
      fi

  - path: /etc/systemd/system/oil-tracker-deploy.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Oil tracker role deployment
      After=docker.service network-online.target
      Wants=docker.service network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/oil-tracker-deploy
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

runcmd:
  - apt-get install -y docker.io=${docker_engine_version}
  - systemctl enable --now docker
  - install -d -o root -g root -m 0750 /opt/oil-price-tracker
  - systemctl daemon-reload
  - systemctl enable --now oil-tracker-deploy.service
