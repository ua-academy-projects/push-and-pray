#!/usr/bin/env bash
set -euo pipefail

readonly SSHD_DROP_IN_DIR="/etc/ssh/sshd_config.d"
readonly SSHD_DROP_IN="$SSHD_DROP_IN_DIR/00-oilscope-bastion.conf"

install -d -m 0755 "$SSHD_DROP_IN_DIR"

cat >"$SSHD_DROP_IN" <<'EOF'
Port ${ssh_port}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
AllowTcpForwarding yes
AllowAgentForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no
EOF

chmod 0644 "$SSHD_DROP_IN"
/usr/sbin/sshd -t

# Ubuntu 24.04 derives ssh.socket listeners from sshd_config during daemon-reload.
systemctl daemon-reload
if systemctl is-active --quiet ssh.socket; then
  systemctl restart ssh.socket
else
  systemctl restart ssh.service
fi

echo "Bastion SSH is configured on port ${ssh_port}."
