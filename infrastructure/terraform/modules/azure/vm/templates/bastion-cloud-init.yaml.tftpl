#cloud-config
write_files:
  - path: /etc/ssh/sshd_config.d/90-oilscope-port.conf
    owner: root:root
    permissions: "0644"
    content: |
      Port ${ssh_port}
runcmd:
  # Ubuntu 26.04 enables systemd socket activation by default. Disable it so
  # sshd_config's Port value controls the listener instead of ssh.socket:22.
  - [systemctl, disable, --now, ssh.socket]
  - [systemctl, enable, --now, ssh.service]
  - [systemctl, restart, ssh]
