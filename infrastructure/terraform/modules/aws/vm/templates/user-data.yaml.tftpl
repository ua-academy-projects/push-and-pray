#cloud-config
# GCP provisions ssh_users through instance metadata that the guest agent
# reads on every boot. AWS has no equivalent - this cloud-config is that
# mechanism here, run once at first boot by cloud-init.
#
# It deliberately stops at "the machine is reachable over SSH". The sshd
# policy itself - final port, key-only auth, no root login - belongs to the
# oilscope.platform.bastion Ansible role, not here.
users:
%{ for username, public_key in ssh_users ~}
  - name: ${username}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - "${public_key}"
%{ endfor ~}
