#!/usr/bin/env bash
set -euo pipefail

readonly OPERATOR_USERNAME='${operator_username}'
readonly OPERATOR_HOME="/home/$OPERATOR_USERNAME"

if ! id -u "$OPERATOR_USERNAME" >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash --user-group "$OPERATOR_USERNAME"
fi

install -d -m 0700 -o "$OPERATOR_USERNAME" -g "$OPERATOR_USERNAME" "$OPERATOR_HOME/.ssh"
cat >"$OPERATOR_HOME/.ssh/authorized_keys" <<'EOF'
${operator_public_key}
EOF
chown "$OPERATOR_USERNAME:$OPERATOR_USERNAME" "$OPERATOR_HOME/.ssh/authorized_keys"
chmod 0600 "$OPERATOR_HOME/.ssh/authorized_keys"

cat >"/etc/sudoers.d/90-oilscope-operator" <<EOF
$OPERATOR_USERNAME ALL=(ALL) NOPASSWD:ALL
EOF
chmod 0440 "/etc/sudoers.d/90-oilscope-operator"
visudo -cf "/etc/sudoers.d/90-oilscope-operator"
