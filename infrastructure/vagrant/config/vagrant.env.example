# This project uses only vagrant-qemu on Apple Silicon.
VAGRANT_BOX=cloud-image/ubuntu-24.04
VAGRANT_BOX_VERSION=20260705.0.0
VAGRANT_BOX_ARCHITECTURE=arm64

# qemu vmnet-bridged uses the macOS interface name. Usually Wi-Fi is en0.
QEMU_VMNET_INTERFACE=en0

# Dedicated VM login. The host setup script creates this project-specific
# Ed25519 key when it does not exist and writes managed SSH aliases.
SSH_ADMIN_USER=oiladmin
SSH_PRIVATE_KEY_PATH=~/.ssh/oil_tracker_ed25519

# The real local network. All VM addresses must be unique, unused and reserved
# outside the router's dynamic DHCP pool.
LAN_CIDR=192.168.88.0/24
LAN_NETMASK=255.255.255.0

# Example only. Copy the file, select four free addresses and remove comments.
DB_LAN_IP=
HISTORY_LAN_IP=
FETCHER_LAN_IP=
UI_LAN_IP=

# Development-lab database credential. Use a URL-safe value and change the default.
DB_PASSWORD=change-me

# Pinned multi-architecture container images.
POSTGRES_IMAGE=postgres:18.4-bookworm
PYTHON_IMAGE=python:3.12.13-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32
GO_IMAGE=golang:1.24.13-bookworm
GO_RUNTIME_IMAGE=debian:bookworm-slim
NODE_IMAGE=node:24.13.0-bookworm-slim
