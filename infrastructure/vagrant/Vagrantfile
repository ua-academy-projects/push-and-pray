Vagrant.configure("2") do |config|
  project_root = File.expand_path("../..", __dir__)

  provisioning_root = File.join(
    project_root,
    "infrastructure",
    "vagrant",
    "provisioning"
  )

  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_architecture = "arm64"
  config.vm.box_check_update = false
  config.vm.boot_timeout = 600

  config.vm.synced_folder project_root, "/vagrant"

  machines = [
    {
      name: "database",
      display_name: "weather-database",
      script: File.join(provisioning_root, "database.sh")
    },
    {
      name: "provider-service",
      display_name: "weather-provider-service",
      script: File.join(provisioning_root, "provider.sh")
    },
    {
      name: "backend-service",
      display_name: "weather-backend-service",
      script: File.join(provisioning_root, "backend.sh")
    },
    {
      name: "ui-service",
      display_name: "weather-ui-service",
      script: File.join(provisioning_root, "ui.sh")
    }
  ]

  host_user = ENV['USER'] || ENV['LOGNAME'] || `id -un`.strip

  ssh_key_paths = [
    File.expand_path("~/.ssh/id_ed25519.pub"),
    File.expand_path("~/.ssh/id_rsa.pub"),
    File.expand_path("~/.ssh/id_ecdsa.pub")
  ]

  host_ssh_key = ""
  ssh_key_paths.each do |key_path|
    if File.exist?(key_path)
      key_content = File.read(key_path).strip
      unless key_content.empty?
        host_ssh_key = key_content
        break
      end
    end
  end

  if host_ssh_key.empty?
    abort "No SSH public key found. Expected one of:\n~/.ssh/id_ed25519.pub\n~/.ssh/id_rsa.pub\n~/.ssh/id_ecdsa.pub"
  end

  machines.each do |machine|
    config.vm.define machine[:name] do |vm|
      vm.vm.hostname = machine[:name]

      vm.vm.provider "vmware_desktop" do |vmware|
        vmware.allowlist_verified = :disable_warning
        # Vagrant uses the bridged LAN IP for SSH
        vmware.ssh_info_public = true
        vmware.enable_vmrun_ip_lookup = true

        vmware.vmx["displayName"] = machine[:display_name]
        vmware.vmx["memsize"] = "1024"
        vmware.vmx["numvcpus"] = "1"

        vmware.vmx["ethernet0.present"] = "TRUE"
        vmware.vmx["ethernet0.connectionType"] = "bridged"
        vmware.vmx["ethernet0.vnet"] = "vmnet0"
        vmware.vmx["ethernet0.startConnected"] = "TRUE"
        vmware.vmx["ethernet0.pcislotnumber"] = "160"

        vmware.vmx["ethernet1.present"] = "FALSE"
        vmware.vmx["ethernet2.present"] = "FALSE"
        vmware.vmx["ethernet3.present"] = "FALSE"
      end

      vm.vm.provision machine[:name],
        type: "shell",
        path: machine[:script],
        env: {
          "HOST_USER" => host_user,
          "HOST_SSH_KEY" => host_ssh_key
        },
        run: "always"
    end
  end
end
