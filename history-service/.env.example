# History Service configuration.
# Copy to .env and adjust for your local PostgreSQL instance.
# Never commit a real .env file.

# SQLAlchemy connection string (sync psycopg v3 driver — see docs/architecture.md for why).
DATABASE_URL=postgresql+psycopg://skyivano:skyivano@localhost:5432/skyivano

# Log SQL statements (verbose; useful for debugging only).
DATABASE_ECHO=false

# Optional pool tuning. Safe defaults for local development.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Port the service listens on when run via `uvicorn app.main:app --port $HISTORY_SERVICE_PORT`.
HISTORY_SERVICE_PORT=8001
