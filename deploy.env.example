# Copy this file to deploy.env and check that all six LAN addresses are free.
# 192.168.10.122 is the deployment host, so the VMs need different addresses.
LAN_CIDR=192.168.10.0/24
LAN_NETMASK=255.255.255.0
# Optional exact VirtualBox adapter name. Leave empty to select it at vagrant up.
WILDLIFE_BRIDGE=
DB_HOST=192.168.10.210
BACKEND_HOST=192.168.10.211
FETCHER_HOST=192.168.10.212
UI_HOST=192.168.10.213
REDIS_HOST=192.168.10.214
LOGGING_HOST=192.168.10.215

# Linux account created on every VM for direct key-based SSH access.
VM_ADMIN_USER=wildlife

DB_NAME=wildlife
DB_USER=wildlife_user
DB_PASSWORD=wildlife_password
REDIS_PASSWORD=replace-this-with-a-long-redis-password
RABBITMQ_USER=wildlife_queue
RABBITMQ_PASSWORD=replace-this-with-a-long-rabbitmq-password
RABBITMQ_QUEUE=wildlife.refresh
INTERNAL_SERVICE_TOKEN=replace-this-with-a-long-internal-service-token
FETCHER_PUBLISH_ATTEMPTS=5
FETCHER_RETRY_DELAY_SECONDS=10
BACKEND_PROCESS_ATTEMPTS=3
BACKEND_RETRY_DELAY_SECONDS=30
SESSION_LIFETIME_DAYS=30
FLASK_SECRET_KEY=replace-this-with-another-random-value
GBIF_USER_AGENT=UkraineWildlifeTrainingApp/5.0

# Used only by deploy-all.sh when deploying to existing Ubuntu machines.
SSH_USER=ubuntu
SSH_KEY_PATH=
