{
  "default_cloud": "aws",
  "default_db": "cloud",
  "database_profile": "economy",
  "database_profile_map": {
    "economy": {
      "aws": {
        "instance_class": "db.t4g.micro",
        "engine_version": "18",
        "allocated_storage_gb": 20,
        "storage_type": "gp2",
        "max_allocated_storage_gb": 0,
        "multi_az": false,
        "backup_retention_days": 1
      },
      "gcp": {
        "tier": "db-f1-micro",
        "edition": "ENTERPRISE",
        "disk_size_gb": 10,
        "disk_type": "PD_SSD",
        "disk_autoresize": false,
        "database_version": "POSTGRES_18",
        "backup_retained_count": 1,
        "availability_type": "ZONAL"
      }
    }
  },
  "region": "eu-central",
  "environment": "dev",
  "name_prefix": "oilscope",
  "monitoring": {
    "enabled": true,
    "logs_enabled": true,
    "alarms_enabled": false,
    "dashboard_enabled": false,
    "agent_metrics_enabled": false,
    "application_metrics_enabled": false,
    "service_logs_enabled": false,
    "database_metrics_enabled": false,
    "detailed_monitoring_enabled": false,
    "email_recipients": [],
    "log_retention_days": 7,
    "cpu_threshold_percent": 80,
    "memory_threshold_percent": 85,
    "disk_threshold_percent": 85,
    "http_error_threshold": 1,
    "disk_fstype": "ext4",
    "outbox_count_threshold": 100,
    "outbox_age_seconds": 600,
    "rabbitmq_queue_threshold": 1000,
    "rabbitmq_unacked_threshold": 100,
    "rabbitmq_dead_threshold": 1,
    "redis_memory_threshold_percent": 85,
    "freshness_seconds": 28800,
    "database_connections_threshold": 80,
    "database_free_storage_bytes": 1073741824,
    "database_cpu_threshold_percent": 80,
    "database_disk_threshold_percent": 85,
    "synthetics": {
      "enabled": false,
      "hostname": "oilscope.example.com",
      "path": "/health",
      "period_minutes": 5,
      "runtime_version": "syn-nodejs-puppeteer-17.0",
      "clouds": null,
      "browser_enabled": false
    }
  },
  "size_map": {
    "micro": {
      "gcp": "e2-micro",
      "aws": "t3.micro"
    },
    "small": {
      "gcp": "e2-small",
      "aws": "t3.small"
    },
    "medium": {
      "gcp": "e2-medium",
      "aws": "t3.medium"
    },
    "large": {
      "gcp": "e2-standard-2",
      "aws": "t3.large"
    }
  },
  "region_map": {
    "eu-central": {
      "gcp": {
        "region": "europe-central2",
        "zone": "europe-central2-a"
      },
      "aws": {
        "region": "eu-central-1",
        "availability_zone": "eu-central-1a"
      }
    }
  },
  "disk_type_map": {
    "standard": {
      "gcp": "pd-standard",
      "aws": "gp3"
    },
    "balanced": {
      "gcp": "pd-balanced",
      "aws": "gp3"
    },
    "ssd": {
      "gcp": "pd-ssd",
      "aws": "io2"
    }
  },
  "image_map": {
    "ubuntu-26.04": {
      "gcp": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64",
      "aws": "/aws/service/canonical/ubuntu/server/26.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
    }
  },
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345"
    },
    "aws": {
      "vpc_cidr": "10.0.0.0/16",
      "rds_network": {
        "secondary_subnet_cidr": "10.0.2.0/24",
        "secondary_availability_zone": "eu-central-1b"
      }
    }
  },
  "network": {
    "management_subnet_cidr": "10.0.0.0/29",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [
      80,
      443
    ]
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "size": "micro",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.0.2",
      "assign_public_ip": true,
      "network_tags": [
        "bastion"
      ],
      "ssh_port": 8787,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ],
      "secret_mappings": {}
    },
    "history": {
      "role": "history",
      "size": "small",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.1.3",
      "assign_public_ip": false,
      "network_tags": [
        "history"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "oilscope-dev-history-db-password",
        "GHCR_TOKEN": "example-ghcr-token",
        "RABBITMQ_PASSWORD": "oilscope-dev-rabbitmq-password"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "size": "micro",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.1.4",
      "assign_public_ip": false,
      "network_tags": [
        "fetcher"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "oilscope-dev-fetcher-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token",
        "RABBITMQ_PASSWORD": "oilscope-dev-rabbitmq-password"
      }
    },
    "ui": {
      "role": "ui",
      "size": "micro",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.1.5",
      "assign_public_ip": true,
      "network_tags": [
        "ui"
      ],
      "secret_mappings": {
        "GHCR_TOKEN": "example-ghcr-token",
        "REDIS_PASSWORD": "oilscope-dev-redis-password"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  },
  "rabbitmq": {
    "host_vm": "history",
    "image": "rabbitmq:4.2.9-management",
    "port": 5671,
    "username": "oilscope",
    "vhost": "oilscope",
    "exchange": "prices",
    "queue": "price_observations",
    "routing_key": "observations",
    "retry_delay_ms": 30000,
    "max_attempts": 5,
    "timeout_seconds": 10,
    "reconnect_seconds": 5,
    "outbox_poll_seconds": 5,
    "outbox_batch_size": 50,
    "memory_mb": 768,
    "queue_max_bytes": 134217728,
    "certificate_days": 365
  },
  "redis": {
    "host_vm": "ui",
    "image": "redis:8.6.6",
    "database": 0,
    "key_prefix": "oilscope:session:",
    "session_ttl_seconds": 2592000,
    "memory_mb": 256,
    "maxmemory_mb": 128
  },
  "budgets": {
    "aws": {
      "enabled": false,
      "monthly_amount": 100,
      "currency": "USD",
      "actual_thresholds": [
        50,
        100
      ],
      "email_recipients": []
    },
    "gcp": {
      "enabled": false,
      "monthly_amount": 100,
      "currency": "USD",
      "actual_thresholds": [
        50,
        100
      ],
      "email_recipients": [],
      "billing_account_id": ""
    }
  },
  "cloudflare": {
    "enabled": false,
    "zone_name": "example.com",
    "ttl": 60
  }
}
