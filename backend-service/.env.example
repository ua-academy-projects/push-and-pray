# Backend Service configuration.
# Copy to .env and adjust for local development.
# Never commit a real .env file.

# --- Database (moved here from the now-retired History Service, Stage 1) ---
# SQLAlchemy connection string (sync psycopg v3 driver — see docs/architecture.md for why).
DATABASE_URL=postgresql+psycopg://skyivano:skyivano@localhost:5432/skyivano
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Fetcher Service (Stage 2) ---
# Used exclusively by POST /api/sync/trigger, proxying the UI's manual refresh button.
# The Backend never calls the Fetcher for anything else.
FETCHER_SERVICE_BASE_URL=http://localhost:8002
HTTP_TIMEOUT_SECONDS=10

# --- Freshness ---
WEATHER_DATA_MAX_AGE_MINUTES=90

# --- RabbitMQ (consumed by the separate worker process, app/worker.py -- see
# app/broker/consumer.py; not read by the FastAPI app itself) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_SYNC_QUEUE=weather.sync
RABBITMQ_SYNC_FAILURE_QUEUE=weather.sync_failure
RABBITMQ_DEAD_LETTER_EXCHANGE=weather.dlx
RABBITMQ_PREFETCH_COUNT=10

# --- Redis (UI session state only -- never weather/business data) ---
# The containerized infra/postgres stack's redis container requires --requirepass;
# include the same password here as its embedded credential (redis-py parses this
# form natively, no code change needed).
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_SESSION_TTL_SECONDS=2592000

# --- Web server ---
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173
