{
  "cloud": "gcp",
  "project_id": "example-project-12345",
  "environment": "dev",
  "region": "europe",
  "regions": {
    "europe": {
      "gcp": { "region": "europe-west1", "zone": "europe-west1-b" },
      "aws": { "region": "eu-central-1", "zone": "eu-central-1a" }
    },
    "us": {
      "gcp": { "region": "us-east1", "zone": "us-east1-b" },
      "aws": { "region": "us-east-1", "zone": "us-east-1a" }
    }
  },
  "image": "ubuntu",
  "images": {
    "ubuntu": {
      "gcp": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64",
      "aws": "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*"
    }
  },
  "machine_types": {
    "micro": { "gcp": "e2-micro", "aws": "t3.micro" },
    "small": { "gcp": "e2-small", "aws": "t3.small" }
  },
  "disk_types": {
    "economy": { "gcp": "pd-standard", "aws": "gp2" },
    "balanced": { "gcp": "pd-balanced", "aws": "gp3" },
    "performance": { "gcp": "pd-ssd", "aws": "io2" }
  },
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [80, 443]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "monitoring": {
    "notification_email": "hasdfasd@gmail.com",
    "budget_amount_usd": 1,
    "cpu_threshold_percent": 80
  },
  "managed_db": {
    "enabled": false,
    "tier": { "gcp": "db-f1-micro", "aws": "db.t3.micro" },
    "version": { "gcp": "POSTGRES_18", "aws": "18" },
    "disk_size_gb": 10
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "machine_type": "micro",
      "internal_ip": "10.0.0.4",
      "boot_disk": { "size_gb": 10, "type": "balanced" },
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    },
    "infra": {
      "role": "database",
      "machine_type": "micro",
      "internal_ip": "10.0.1.4",
      "boot_disk": { "size_gb": 10, "type": "balanced" },
      "assign_public_ip": false,
      "network_tags": ["infra"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "machine_type": "small",
      "internal_ip": "10.0.1.5",
      "boot_disk": { "size_gb": 10, "type": "balanced" },
      "assign_public_ip": false,
      "network_tags": ["history"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "cloud": "aws",
      "region": "us",
      "image": "ubuntu",
      "role": "fetcher",
      "machine_type": "micro",
      "internal_ip": "10.0.1.6",
      "boot_disk": { "size_gb": 10, "type": "economy" },
      "assign_public_ip": false,
      "network_tags": ["fetcher"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "machine_type": "micro",
      "internal_ip": "10.0.1.7",
      "boot_disk": { "size_gb": 10, "type": "balanced" },
      "assign_public_ip": true,
      "network_tags": ["ui"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
