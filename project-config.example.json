{
  "default_cloud": "gcp",
  "location": "us-east",
  "environment": "dev",

  "clouds": {
    "gcp": {
      "project_id": "example-project-12345"
    },
    "aws": {
      "account_id": "123456789012"
    }
  },

  "regions": {
    "us-east": {
      "gcp": "us-east1",
      "aws": "us-east-1"
    },
    "eu-west": {
      "gcp": "europe-west1",
      "aws": "eu-west-1"
    }
  },

  "sizes": {
    "micro": {
      "gcp": "e2-micro",
      "aws": "t2.micro"
    },
    "small": {
      "gcp": "e2-small",
      "aws": "t2.small"
    }
  },

  "disk_types": {
    "balanced": {
      "gcp": "pd-balanced",
      "aws": "gp3"
    },
    "ssd": {
      "gcp": "pd-ssd",
      "aws": "io2"
    }
  },

  "images": {
    "ubuntu-26.04": {
      "gcp": {
        "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64"
      },
      "aws": {
        "owners": [
          "099720109477"
        ],
        "name_pattern": "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*"
      }
    }
  },

  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [80, 443]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.0.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["0.0.0.0/0"]
    },
    "infra": {
      "role": "database",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["infra"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.6",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["history"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.7",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["fetcher"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.8",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["ui"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
