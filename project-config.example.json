{
  "default_cloud": "gcp",
  "location": "us-east",
  "environment": "dev",
  "secret_version_managers": [],

  "gcp": {
    "project_id": "example-project-12345"
  },


  "regions": {
    "us-east": {
      "gcp": "us-east1",
      "aws": "us-east-1"
    },
    "eu-west": {
      "gcp": "europe-west1",
      "aws": "eu-west-1"
    }
  },

  "zones": {
    "us-east": {
      "gcp": "us-east1-b",
      "aws": "us-east-1a"
    },
    "eu-west": {
      "gcp": "europe-west1-b",
      "aws": "eu-west-1a"
    }
  },

  "sizes": {
    "micro": {
      "gcp": "e2-micro",
      "aws": "t2.micro"
    },
    "small": {
      "gcp": "e2-small",
      "aws": "t2.small"
    }
  },

  "disk_types": {
    "balanced": {
      "gcp": "pd-balanced",
      "aws": "gp3"
    },
    "ssd": {
      "gcp": "pd-ssd",
      "aws": "io2"
    }
  },

  "images": {
    "ubuntu-26.04": {
      "gcp": {
        "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64"
      },
      "aws": {
        "owners": [
          "099720109477"
        ],
        "name_pattern": "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*"
      }
    }
  },

  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "ansible": {
    "ssh_user": "example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "monitoring": {
    "enabled": true,
    "metrics_interval_seconds": 60,
    "log_retention_days": 7,
    "alert_email": "example-operator@example.com",
    "ui_health_path": "/health",
    "thresholds": {
      "cpu_percent": 85,
      "memory_percent": 85,
      "disk_percent": 85
    }
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "database_connectivity": {
      "aws": {
        "us-east": [
          {
            "availability_zone": "us-east-1a",
            "cidr": "10.0.2.0/28"
          },
          {
            "availability_zone": "us-east-1b",
            "cidr": "10.0.3.0/28"
          }
        ],
        "eu-west": [
          {
            "availability_zone": "eu-west-1a",
            "cidr": "10.0.2.0/28"
          },
          {
            "availability_zone": "eu-west-1b",
            "cidr": "10.0.3.0/28"
          }
        ]
      },
      "gcp": {
        "private_service_cidr": "10.10.0.0/24"
      }
    },
    "ui_public_ports": [80, 443]
  },
  "services": {
    "history": {
      "port": 8001
    },
    "database": {
      "port": 5432,
      "name": "oil_tracker",
      "username": "oil_tracker",
      "password_secret_id": "example-db-password",
      "ssl_mode": "require",
      "aws": {
        "engine_version": "17",
        "instance_class": "db.t4g.micro",
        "allocated_storage_gb": 20,
        "storage_type": "gp3",
        "multi_az": false,
        "backup_retention_days": 1
      },
      "gcp": {
        "database_version": "POSTGRES_17",
        "tier": "db-f1-micro",
        "disk_size_gb": 10,
        "availability_type": "ZONAL",
        "backup_enabled": false
      }
    },
    "rabbitmq": {
      "amqp_port": 5672,
      "management_port": 15672,
      "username": "oil_tracker",
      "vhost": "oil_tracker",
      "queue": "price_observations",
      "image": "rabbitmq:4-management",
      "metrics_port": 15692
    },
    "redis": {
      "port": 6379,
      "database": 0,
      "image": "redis:8-alpine",
      "metrics_port": 9121,
      "exporter_image": "oliver006/redis_exporter:v1.89.0-alpine"
    }
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.0.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["0.0.0.0/0"]
    },
    "infra": {
      "role": "infra",
      "machine_type": "small",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["infra"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "RABBITMQ_PASSWORD": "example-rabbitmq-password",
        "REDIS_PASSWORD": "example-redis-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.6",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["history"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "RABBITMQ_PASSWORD": "example-rabbitmq-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.7",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["fetcher"],
      "secret_mappings": {
        "RABBITMQ_PASSWORD": "example-rabbitmq-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "machine_type": "micro",
      "image": "ubuntu-26.04",
      "internal_ip": "10.0.1.8",
      "internal_ips": {
        "aws": "10.0.0.5"
      },
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["ui"],
      "secret_mappings": {
        "REDIS_PASSWORD": "example-redis-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "domain": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
