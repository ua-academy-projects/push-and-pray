{
  "default_cloud": "gcp",
  "region": "eu-central",
  "environment": "dev",
  "name_prefix": "oilscope",
  "monitoring": {
    "enabled": true,
    "logs_enabled": true,
    "alarms_enabled": false,
    "dashboard_enabled": false,
    "agent_metrics_enabled": false,
    "application_metrics_enabled": false,
    "service_logs_enabled": false,
    "database_metrics_enabled": false,
    "detailed_monitoring_enabled": false,
    "email_recipients": [],
    "log_retention_days": 7,
    "cpu_threshold_percent": 80,
    "memory_threshold_percent": 85,
    "disk_threshold_percent": 85,
    "http_error_threshold": 1,
    "disk_fstype": "ext4",
    "outbox_count_threshold": 100,
    "outbox_age_seconds": 600,
    "rabbitmq_queue_threshold": 1000,
    "rabbitmq_unacked_threshold": 100,
    "rabbitmq_dead_threshold": 1,
    "redis_memory_threshold_percent": 85,
    "freshness_seconds": 28800,
    "database_connections_threshold": 80,
    "database_free_storage_bytes": 1073741824,
    "database_cpu_threshold_percent": 80,
    "database_disk_threshold_percent": 85,
    "synthetics": {
      "enabled": false,
      "hostname": "oilscope.example.com",
      "path": "/health",
      "period_minutes": 5,
      "runtime_version": "syn-nodejs-puppeteer-17.0",
      "clouds": null,
      "browser_enabled": false
    }
  },
  "size_map": {
    "micro": {
      "gcp": "e2-micro",
      "aws": "t3.micro",
      "azure": "Standard_B1ms"
    },
    "small": {
      "gcp": "e2-small",
      "aws": "t3.small",
      "azure": "Standard_B2s"
    },
    "medium": {
      "gcp": "e2-medium",
      "aws": "t3.medium",
      "azure": "Standard_B2ms"
    },
    "large": {
      "gcp": "e2-standard-2",
      "aws": "t3.large",
      "azure": "Standard_B4ms"
    }
  },
  "region_map": {
    "eu-central": {
      "gcp": {
        "region": "europe-central2",
        "zone": "europe-central2-a"
      },
      "aws": {
        "region": "eu-central-1",
        "availability_zone": "eu-central-1a"
      },
      "azure": {
        "location": "germanywestcentral",
        "availability_zone": "1"
      }
    }
  },
  "disk_type_map": {
    "standard": {
      "gcp": "pd-standard",
      "aws": "gp3",
      "azure": "Standard_LRS"
    },
    "balanced": {
      "gcp": "pd-balanced",
      "aws": "gp3",
      "azure": "StandardSSD_LRS"
    },
    "ssd": {
      "gcp": "pd-ssd",
      "aws": "io2",
      "azure": "Premium_LRS"
    }
  },
  "image_map": {
    "ubuntu-26.04": {
      "gcp": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64",
      "aws": "/aws/service/canonical/ubuntu/server/26.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
      "azure": {
        "publisher": "Canonical",
        "offer": "ubuntu-26_04-lts",
        "sku": "server",
        "version": "latest"
      }
    }
  },
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345"
    },
    "aws": {
      "vpc_cidr": "10.0.0.0/16"
    },
    "azure": {
      "subscription_id": "00000000-0000-0000-0000-000000000000",
      "resource_group_name": "oilscope-dev-rg",
      "vnet_cidr": "10.0.0.0/16",
      "admin_username": "example-operator",
      "key_vault": {
        "soft_delete_retention_days": 7,
        "purge_protection_enabled": false
      }
    }
  },
  "network": {
    "workload_subnet_cidr": "10.0.1.0/24",
    "ui_public_ports": [
      80,
      443
    ]
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository_prefix": "oilscope",
    "github_repository": "example-org/example-repo",
    "publish_tag_prefix": "example-v",
    "image_digests": {
      "fetcher": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "history": "sha256:123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0",
      "ui": "sha256:23456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef01",
      "database": "sha256:3456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012"
    }
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "vms": {
    "k3s-1": {
      "role": "kubernetes",
      "size": "small",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 60,
      "internal_ip": "10.0.1.21",
      "assign_public_ip": true,
      "network_tags": [
        "control-plane",
        "worker"
      ]
    },
    "k3s-2": {
      "role": "kubernetes",
      "size": "small",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 60,
      "internal_ip": "10.0.1.22",
      "assign_public_ip": true,
      "network_tags": [
        "control-plane",
        "worker"
      ]
    },
    "k3s-3": {
      "role": "kubernetes",
      "size": "small",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 60,
      "internal_ip": "10.0.1.23",
      "assign_public_ip": true,
      "network_tags": [
        "control-plane",
        "worker"
      ]
    }
  },
  "secret_mappings": {
    "history": {
      "POSTGRES_PASSWORD": "example-db-password",
      "RABBITMQ_PASSWORD": "oilscope-dev-rabbitmq-password"
    },
    "fetcher": {
      "POSTGRES_PASSWORD": "example-db-password",
      "OILPRICEAPI_KEY": "example-api-key",
      "RABBITMQ_PASSWORD": "oilscope-dev-rabbitmq-password"
    },
    "ui": {
      "REDIS_PASSWORD": "oilscope-dev-redis-password"
    },
    "migration": {
      "POSTGRES_PASSWORD": "example-db-password"
    }
  },
  "kubernetes": {
    "version": "v1.36.4+k3s1",
    "entry_node": "k3s-1",
    "ssh_address_mode": "public",
    "admin_allowed_cidrs": [
      "192.0.2.10/32"
    ],
    "api_endpoint": "api.oilscope.example.com",
    "api_endpoint_mode": "node",
    "pod_cidr": "10.42.0.0/16",
    "service_cidr": "10.43.0.0/16",
    "namespace": "oilscope",
    "etcd": {
      "snapshot_schedule_cron": "0 */6 * * *",
      "snapshot_retention": 28,
      "backup_destination": "cloud_object_storage"
    }
  },
  "ingress": {
    "endpoint_mode": "node",
    "hostname": "oilscope.example.com",
    "acme_email": "example-operator@example.com",
    "challenge_type": "http01"
  },
  "rabbitmq": {
    "image": "rabbitmq:4.2.9-management",
    "port": 5671,
    "username": "oilscope",
    "vhost": "oilscope",
    "exchange": "prices",
    "queue": "price_observations",
    "routing_key": "observations",
    "retry_delay_ms": 30000,
    "max_attempts": 5,
    "timeout_seconds": 10,
    "reconnect_seconds": 5,
    "outbox_poll_seconds": 5,
    "outbox_batch_size": 50,
    "memory_mb": 768,
    "queue_max_bytes": 134217728,
    "certificate_days": 365
  },
  "redis": {
    "image": "redis:8.6.6",
    "database": 0,
    "key_prefix": "oilscope:session:",
    "session_ttl_seconds": 2592000,
    "memory_mb": 256,
    "maxmemory_mb": 128
  },
  "managed_database": false,
  "managed_kubernetes": false,
  "budgets": {
    "aws": {
      "enabled": false,
      "monthly_amount": 100,
      "currency": "USD",
      "actual_thresholds": [
        50,
        100
      ],
      "email_recipients": []
    },
    "gcp": {
      "enabled": false,
      "monthly_amount": 100,
      "currency": "USD",
      "actual_thresholds": [
        50,
        100
      ],
      "email_recipients": [],
      "billing_account_id": ""
    },
    "azure": {
      "enabled": false,
      "monthly_amount": 100,
      "currency": "USD",
      "actual_thresholds": [
        50,
        100
      ],
      "email_recipients": [],
      "start_date": "2026-10-01T00:00:00Z"
    }
  },
  "cloudflare": {
    "enabled": false,
    "zone_name": "example.com",
    "ttl": 60
  },
  "headlamp": {
    "enabled": false,
    "hostname": "headlamp.example.com",
    "namespace": "headlamp",
    "auth_mode": "oidc",
    "replicas": 1,
    "session_ttl_seconds": 28800,
    "oidc": {
      "issuer_url": "https://identity.example.com/realms/example",
      "client_id": "oilscope-headlamp",
      "client_secret_secret_id": "oilscope-headlamp-oidc",
      "scopes": "openid,email,profile,groups",
      "username_claim": "email",
      "username_prefix": "oidc:",
      "groups_claim": "groups",
      "groups_prefix": "oidc:",
      "allowed_groups": [
        "oilscope-operators"
      ],
      "allowed_users": []
    },
    "overview": {
      "application_url": "https://oilscope.example.com",
      "stale_after_seconds": 120,
      "links": [
        {
          "label": "CloudWatch dashboard",
          "url": "https://example.com/replace-with-your-cloudwatch-dashboard"
        },
        {
          "label": "Deployment guide",
          "url": "https://example.com/replace-with-your-documentation"
        }
      ],
      "components": [
        {
          "name": "ui",
          "kind": "Deployment",
          "label": "UI"
        },
        {
          "name": "history",
          "kind": "Deployment",
          "label": "History"
        },
        {
          "name": "fetcher",
          "kind": "Deployment",
          "label": "Fetcher"
        },
        {
          "name": "rabbitmq",
          "kind": "StatefulSet",
          "label": "RabbitMQ"
        },
        {
          "name": "redis",
          "kind": "StatefulSet",
          "label": "Redis"
        }
      ]
    }
  }
}
