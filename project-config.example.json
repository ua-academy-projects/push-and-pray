{
  "default_cloud": "gcp",
  "default_region": "europe",
  "tailscale": {
    "enabled": false,
    "manage_policy": false
  },
  "zone_id": "example",
  "clouds": {
    "gcp": {
        "project_id": "example-id",
        "billing_account_id": "000000-000000-000000"
    },
    "azure": {
      "subscription_id": "00000000-0000-0000-0000-000000000000"
    }
  },
  "environment": "dev",
  "regions": {
    "europe": {
        "gcp": {
            "region": "example",
            "zone": "example"
        },
        "aws": {
            "region": "example",
            "availability_zone": "example"
        },
        "azure": {
          "location": "polandcentral",
          "zone": "1"
        }
    }
  },
  "sizes": {
    "small": {
        "gcp": "e2-micro",
        "aws": "t3.micro",
        "azure": "Standard_F1als_v7"
    },
    "infra": {
        "gcp": "e2-small",
        "aws": "t3.small",
        "azure": "Standard_F1as_v7"
    }
  },
  "disk_types": {
    "balanced": {
      "gcp": "pd-balanced",
      "aws": "gp3",
      "azure": "StandardSSD_LRS"
    }
  },
  "images": {
    "ubuntu-2604": {
      "gcp": {
        "reference": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64"
      },
      "aws": {
        "name_filter": "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*",
        "owners": ["099720109477"]
      },
      "azure": {
        "publisher": "Canonical",
        "offer": "ubuntu-26_04-lts",
        "sku": "server",
        "version": "latest"
      }
    }
  },
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "example-docker.pkg.dev/example-id/oilscope",
    "username": "example-operator",
    "image_tag": "xintaro"
  },
  "network": {
    "gcp": {
      "vpc_cidr": "10.10.0.0/16",
      "management_subnet_cidr": "10.10.0.0/24",
      "workload_subnet_cidr": "10.10.1.0/24"
    },
    "aws": {
      "vpc_cidr": "10.20.0.0/16",
      "management_subnet_cidr": "10.20.0.0/24",
      "workload_subnet_cidr": "10.20.1.0/24",
      "managed_database_subnet_cidr": "10.20.2.0/24",
      "database_subnets": [],
      "eks_private_subnets": [
        { "cidr": "10.20.10.0/24", "availability_zone": "example-a" },
        { "cidr": "10.20.11.0/24", "availability_zone": "example-b" }
      ],
      "eks_public_subnets": [
        { "cidr": "10.20.20.0/24", "availability_zone": "example-a" },
        { "cidr": "10.20.21.0/24", "availability_zone": "example-b" }
      ]
    },
    "azure": {
      "vpc_cidr": "10.30.0.0/16",
      "management_subnet_cidr": "10.30.0.0/24",
      "workload_subnet_cidr": "10.30.1.0/24",
      "managed_database_subnet_cidr": "10.30.2.0/24"
    },
    "ui_public_ports": [443]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432,
    "rabbitmq": 5672,
    "redis": 6379
  },
  "monitoring": {
    "enabled": true,
    "notification_email": "example-operator@example.com",
    "cpu": {
      "threshold_percent": 80,
      "duration_seconds": 300
    },
    "disk": {
      "threshold_percent": 85,
      "duration_seconds": 600
    },
    "uptime": {
      "enabled": true,
      "path": "/",
      "period_seconds": 60,
      "timeout_seconds": 10
    },
    "logs": {
      "enabled": true,
      "error_pattern": "(?i)(error|exception|critical)"
    },
    "budget": {
      "enabled": true,
      "amount": 10,
      "currency": "USD",
      "thresholds": [0.5, 0.9, 1.0]
    }
  },
  "database": {
    "mode": "self_managed",
    "name": "oil_tracker",
    "user": "oil_tracker",
    "port": 5432,
    "managed": {
      "gcp": {
        "database_version": "POSTGRES_15",
        "tier": "db-f1-micro"
      },
      "aws": {
        "engine_version": "15",
        "instance_class": "db.t3.micro"
      },
      "azure": {
        "version": "16",
        "sku_name": "B_Standard_B1ms"
      }
    }
  },
  "messaging": {
    "queue_name": "price_observations",
    "visibility_timeout_seconds": 60,
    "max_delivery_attempts": 5,
    "rabbitmq": {
      "image": "rabbitmq:4.3.4-management",
      "username": "oil_tracker",
      "vhost": "oil_tracker",
      "exchange": "oil.price.events",
      "routing_key": "prices.observed"
    }
  },
  "sessions": {
    "ttl_seconds": 2592000,
    "redis_image": "redis:8.2.8-bookworm"
  },
  "kubernetes": {
    "enabled": true,
    "mode": "k3s",
    "k3s_version": "v1.32.3+k3s1",
    "artifact_repository": "oilscope",
    "github_repository": "example-org/push-and-pray",
    "eks": {
      "version": "1.35",
      "public_access_cidrs": ["192.0.2.10/32"],
      "administrator_principal_arns": ["arn:aws:iam::123456789012:role/example-operator"],
      "node_instance_type": "t3.medium",
      "public_endpoint": { "hostname": "oilscope.example.com", "acme_email": "example-operator@example.com" }
    },
    "gke": {
      "version": "1.35",
      "public_access_cidrs": ["192.0.2.10/32"],
      "node_machine_type": "e2-medium",
      "pod_range_cidr": "10.11.0.0/16",
      "service_range_cidr": "10.12.0.0/20",
      "public_endpoint": { "hostname": "oilscope.example.com", "acme_email": "example-operator@example.com" }
    },
    "namespace": "oilscope",
    "secrets": {
      "POSTGRES_PASSWORD": "example-db-password",
      "RABBITMQ_PASSWORD": "example-rabbitmq-password",
      "REDIS_PASSWORD": "example-redis-password",
      "OILPRICEAPI_KEY": "example-api-key",
      "CLOUDFLARE_API_TOKEN": "example-cloudflare-api-token"
    }
  },
  "service_placement": {
    "gcp": { "infrastructure_host": "k3s-server" },
    "aws": { "infrastructure_host": "k3s-server" },
    "azure": { "infrastructure_host": "k3s-server" }
  },
  "vms": {
    "bastion-gcp": {
      "role": "bastion",
      "size": "small",
      "region": "europe",
      "cloud": "gcp",
      "image": "ubuntu-2604",
      "internal_ip": "10.10.0.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    },
    "k3s-server-gcp": {
      "role": "k3s_server",
      "size": "infra",
      "region": "europe",
      "image": "ubuntu-2604",
      "cloud": "gcp",
      "internal_ip": "10.10.1.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["k3s-server"],
      "secret_mappings": {},
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    },
    "bastion-aws": {
      "role": "bastion",
      "size": "small",
      "region": "europe",
      "cloud": "aws",
      "image": "ubuntu-2604",
      "internal_ip": "10.20.0.5",
      "boot_disk": { "size_gb": 10, "type": "balanced" },
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    },
    "k3s-server-aws": {
      "role": "k3s_server",
      "size": "infra",
      "region": "europe",
      "cloud": "aws",
      "image": "ubuntu-2604",
      "internal_ip": "10.20.1.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["k3s-server"],
      "secret_mappings": {},
      "public_endpoint": { "hostname": "oilscope.example.com", "acme_email": "example-operator@example.com" }
    },
    "bastion-azure": {
      "role": "bastion", "size": "small", "region": "europe", "cloud": "azure", "image": "ubuntu-2604",
      "internal_ip": "10.30.0.5", "boot_disk": { "size_gb": 10, "type": "balanced" }, "assign_public_ip": true,
      "network_tags": ["bastion"], "secret_mappings": {}, "ssh_port": 8787, "allowed_cidrs": ["192.0.2.10/32"]
    },
    "k3s-server-azure": {
      "role": "k3s_server", "size": "infra", "region": "europe", "cloud": "azure", "image": "ubuntu-2604",
      "internal_ip": "10.30.1.4", "boot_disk": { "size_gb": 10, "type": "balanced" }, "assign_public_ip": false,
      "network_tags": ["k3s-server"], "secret_mappings": {},
      "public_endpoint": { "hostname": "oilscope.example.com", "acme_email": "example-operator@example.com" }
    }
  }
}
