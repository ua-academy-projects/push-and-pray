{
  "environment": "dev",
  "name_prefix": "oilscope",
  "common_labels": {
    "application": "oilscope",
    "managed_by": "terraform",
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "default_cloud": "gcp",
  "default_location": "europe",
  "vm_defaults": {
    "image": "ubuntu-24.04",
    "disk_type": "balanced"
  },
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345"
    },
    "aws": {
      "account_id": "123456789012"
    }
  },
  "locations": {
    "europe": {
      "gcp": {
        "region": "europe-west1",
        "zone": "europe-west1-b"
      },
      "aws": {
        "region": "eu-central-1",
        "availability_zone": "eu-central-1a"
      }
    },
    "north_america": {
      "gcp": {
        "region": "us-central1",
        "zone": "us-central1-a"
      },
      "aws": {
        "region": "us-east-1",
        "availability_zone": "us-east-1a"
      }
    },
    "europe_west": {
      "gcp": {
        "region": "europe-west2",
        "zone": "europe-west2-a"
      },
      "aws": {
        "region": "eu-west-2",
        "availability_zone": "eu-west-2a"
      }
    },
    "asia_pacific": {
      "gcp": {
        "region": "asia-southeast1",
        "zone": "asia-southeast1-a"
      },
      "aws": {
        "region": "ap-southeast-1",
        "availability_zone": "ap-southeast-1a"
      }
    }
  },
  "provider_mappings": {
    "instance_types": {
      "micro": {
        "gcp": {
          "machine_type": "e2-micro"
        },
        "aws": {
          "instance_type": "t3.micro"
        }
      },
      "small": {
        "gcp": {
          "machine_type": "e2-small"
        },
        "aws": {
          "instance_type": "t3.small"
        }
      },
      "medium": {
        "gcp": {
          "machine_type": "e2-medium"
        },
        "aws": {
          "instance_type": "t3.medium"
        }
      },
      "large": {
        "gcp": {
          "machine_type": "e2-standard-2"
        },
        "aws": {
          "instance_type": "t3.large"
        }
      }
    },
    "disk_types": {
      "standard": {
        "gcp": "pd-standard",
        "aws": "standard"
      },
      "balanced": {
        "gcp": "pd-balanced",
        "aws": "gp3"
      },
      "ssd": {
        "gcp": "pd-ssd",
        "aws": "gp2"
      }
    },
    "images": {
      "ubuntu-24.04": {
        "gcp": {
          "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
        },
        "aws": {
          "ssm_parameter": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
        }
      },
      "ubuntu-22.04": {
        "gcp": {
          "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts"
        },
        "aws": {
          "ssm_parameter": "/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id"
        }
      }
    }
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "enable_bastion_ssh_bootstrap": false,
    "ui_public_ports": [80, 443]
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.0.4",
      "assign_public_ip": true,
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    },
    "infra": {
      "role": "database",
      "cloud": "gcp",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.1.4"
    },
    "history": {
      "role": "history",
      "size": "small",
      "location": "europe",
      "internal_ip": "10.0.1.5"
    },
    "fetcher": {
      "role": "fetcher",
      "cloud": "aws",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.1.6"
    },
    "ui": {
      "role": "ui",
      "cloud": "aws",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.1.7",
      "assign_public_ip": true,
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    },
    "bastion-aws": {
      "role": "bastion",
      "cloud": "aws",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.0.4",
      "assign_public_ip": true,
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    }
  }
}
