{
  "default_cloud": "gcp",
  "environment": "dev",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "bastion": {
    "ssh_port": 8787,
    "allowed_cidrs": ["192.0.2.10/32"]
  },
  "network": {
    "ui_public_ports": [443]
  },
  "observability": {
    "alert_email": "ops@example.com"
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432,
    "amqp": 5672,
    "redis": 6379
  },
  "database": {
    "mode": "self-hosted",
    "engine_version": "17",
    "size": "small",
    "storage_gb": 20,
    "name": "oil_tracker",
    "username": "oil_tracker",
    "backup_retention_days": 1,
    "deletion_protection": false
  },
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345",
      "region": "europe-west1",
      "zone": "europe-west1-b",
      "subnets": {
        "management": "10.0.0.0/29",
        "workload": "10.0.1.0/26",
        "database": ["10.0.2.0/28"]
      },
      "machine_sizes": {
        "tiny": "e2-micro",
        "small": "e2-small",
        "medium": "e2-medium",
        "large": "e2-standard-2"
      },
      "database_sizes": {
        "small": "db-f1-micro",
        "medium": "db-g1-small",
        "large": "db-custom-2-7680"
      },
      "disk_types": {
        "standard": "pd-standard",
        "balanced": "pd-balanced",
        "fast": "pd-ssd"
      },
      "images": {
        "ubuntu-lts": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64"
      },
      "secret_version_managers": ["serviceAccount:example-ci@example-project-12345.iam.gserviceaccount.com"],
      "billing_account": "012345-6789AB-CDEF01",
      "budget_usd": 50
    },
    "aws": {
      "region": "eu-central-1",
      "zone": "eu-central-1a",
      "network_cidr": "10.1.0.0/16",
      "subnets": {
        "management": "10.1.0.0/28",
        "workload": "10.1.1.0/26",
        "database": ["10.1.2.0/28", "10.1.3.0/28"]
      },
      "machine_sizes": {
        "tiny": "t3.micro",
        "small": "t3.small",
        "medium": "t3.medium",
        "large": "t3.large"
      },
      "database_sizes": {
        "small": "db.t4g.micro",
        "medium": "db.t4g.small",
        "large": "db.t4g.medium"
      },
      "disk_types": {
        "standard": "standard",
        "balanced": "gp3",
        "fast": "io2"
      },
      "images": {
        "ubuntu-lts": "ami-0123456789abcdef0"
      },
      "secret_version_managers": ["arn:aws:iam::123456789012:role/example-ci"],
      "budget_usd": 20
    }
  },
  "vms": {
    "infra": {
      "role": "infra",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.2",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["infra"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "RABBITMQ_PASSWORD": "example-broker-password",
        "REDIS_PASSWORD": "example-cache-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "size": "small",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.3",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["history"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "RABBITMQ_PASSWORD": "example-broker-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["fetcher"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "RABBITMQ_PASSWORD": "example-broker-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["ui"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "REDIS_PASSWORD": "example-cache-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
