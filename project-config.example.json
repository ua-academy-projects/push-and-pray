{
  "environment": "dev",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "default_cloud": "gcp",
  "vm_defaults": {
    "image": "ubuntu-24.04",
    "disk_type": "balanced"
  },
  "sizes": {
    "micro": {
      "cpu": 2,
      "memory_gb": 1,
      "boot_disk_size_gb": 10
    },
    "small": {
      "cpu": 2,
      "memory_gb": 2,
      "boot_disk_size_gb": 10
    }
  },
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345",
      "secret_version_managers": []
    },
    "aws": {
      "account_id": "123456789012"
    }
  },
  "locations": {
    "europe": {
      "gcp": {
        "region": "europe-west1",
        "zone": "europe-west1-b"
      },
      "aws": {
        "region": "eu-central-1",
        "availability_zone": "eu-central-1a"
      }
    }
  },
  "provider_mappings": {
    "instance_types": {
      "micro": {
        "gcp": {
          "machine_type": "e2-micro"
        },
        "aws": {
          "instance_type": "t3.micro"
        }
      },
      "small": {
        "gcp": {
          "machine_type": "e2-small"
        },
        "aws": {
          "instance_type": "t3.small"
        }
      }
    },
    "disk_types": {
      "balanced": {
        "gcp": "pd-balanced",
        "aws": "gp3"
      }
    },
    "images": {
      "ubuntu-24.04": {
        "gcp": {
          "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
        },
        "aws": {
          "ssm_parameter": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
        }
      }
    }
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [80, 443]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.0.4",
      "assign_public_ip": true,
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    },
    "infra": {
      "role": "database",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.1.4",
      "assign_public_ip": false,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "size": "small",
      "location": "europe",
      "internal_ip": "10.0.1.5",
      "assign_public_ip": false,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.1.6",
      "assign_public_ip": false,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "size": "micro",
      "location": "europe",
      "internal_ip": "10.0.1.7",
      "assign_public_ip": true,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
