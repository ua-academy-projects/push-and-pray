{
  "environment": "dev",
  "name_prefix": "oilscope",
  "default_cloud": "gcp",
  "default_region": "europe",
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345"
    },
    "aws": {}
  },
  "cloud_mappings": {
    "regions": {
      "europe": {
        "gcp": {
          "region": "europe-west1",
          "zone": "europe-west1-b"
        },
        "aws": {
          "region": "eu-central-1",
          "zone": "eu-central-1a"
        }
      }
    },
    "sizes": {
      "small": {
        "gcp": "e2-micro",
        "aws": "t3.micro"
      },
      "medium": {
        "gcp": "e2-small",
        "aws": "t3.small"
      }
    },
    "disk_types": {
      "balanced": {
        "gcp": "pd-balanced",
        "aws": "gp3"
      }
    },
    "images": {
      "ubuntu_26_04": {
        "gcp": {
          "project": "ubuntu-os-cloud",
          "family": "ubuntu-2604-lts-amd64"
        },
        "aws": {
          "owners": [
            "099720109477"
          ],
          "name_pattern": "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*"
        }
      }
    }
  },
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "aws_enable_nat_gateway": false,
    "ui_public_ports": [
      80,
      443
    ]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "size": "small",
      "image": "ubuntu_26_04",
      "internal_ip": "10.0.0.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ]
    },
    "infra": {
      "role": "database",
      "size": "small",
      "image": "ubuntu_26_04",
      "internal_ip": "10.0.1.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "size": "medium",
      "image": "ubuntu_26_04",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "size": "small",
      "image": "ubuntu_26_04",
      "internal_ip": "10.0.1.6",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "size": "small",
      "image": "ubuntu_26_04",
      "internal_ip": "10.0.1.7",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
