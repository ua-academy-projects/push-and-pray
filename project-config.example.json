{
  "config_version": 3,
  "project_id": "example-project-12345",
  "environment": "dev",
  "region": "europe-west1",
  "zone": "europe-west1-b",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "terraform": {
    "backend": {
      "bucket": "example-project-12345-tfstate",
      "prefix": "oilscope/dev"
    }
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "management_subnet_cidr": "10.0.0.0/29",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [80, 443]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "machine_type": "e2-micro",
      "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
      "internal_ip": "10.0.0.2",
      "boot_disk": {
        "size_gb": 10,
        "type": "pd-balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "bastion"
      ],
      "automation_role": "none",
      "secret_mappings": {},
      "ssh_port": 2222,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ],
      "preemptible": false
    },
    "infra": {
      "role": "database",
      "machine_type": "e2-micro",
      "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
      "internal_ip": "10.0.1.2",
      "boot_disk": {
        "size_gb": 10,
        "type": "pd-balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "infra"
      ],
      "automation_role": "database",
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password"
      },
      "preemptible": false
    },
    "history": {
      "role": "history",
      "machine_type": "e2-small",
      "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
      "internal_ip": "10.0.1.3",
      "boot_disk": {
        "size_gb": 10,
        "type": "pd-balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "history"
      ],
      "automation_role": "history",
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password"
      },
      "preemptible": false
    },
    "fetcher": {
      "role": "fetcher",
      "machine_type": "e2-micro",
      "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
      "internal_ip": "10.0.1.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "pd-balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "fetcher"
      ],
      "automation_role": "fetcher",
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key"
      },
      "preemptible": false
    },
    "ui": {
      "role": "ui",
      "machine_type": "e2-micro",
      "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "pd-balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "ui"
      ],
      "automation_role": "ui",
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password"
      },
      "preemptible": false
    }
  }
}
