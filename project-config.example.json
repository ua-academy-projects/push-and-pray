          "ubuntu-2404": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
          "ubuntu-2204": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts"
        },
        "america-east": {
          "ubuntu-2404": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64",
