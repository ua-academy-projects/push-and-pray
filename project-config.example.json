        "europe-west": {
          "ubuntu-2404": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
          "ubuntu-2204": "/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id"
        },
        "europe-central": {
          "ubuntu-2404": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
          "ubuntu-2204": "/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id"
        },
        "america-east": {
          "ubuntu-2404": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
          "ubuntu-2204": "/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id"
        },
        "america-west": {
          "ubuntu-2404": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
          "ubuntu-2204": "/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id"
        },
        "asia-southeast": {
          "ubuntu-2404": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id",
          "ubuntu-2204": "/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id"
        }
      },
      "network": {
        "management_subnet_cidr": "10.0.0.0/28",
        "workload_subnet_cidr": "10.0.1.0/26",
        "vpc_cidr": "10.0.0.0/16"
      }
    },
    "azure": {
      "subscription_id": null,
      "regions": {
        "default": "westeurope",
        "europe-west": "westeurope",
        "europe-central": "germanywestcentral",
        "america-east": "eastus",
        "america-west": "westus2",
        "asia-southeast": "southeastasia"
      },
      "zones": {
        "default": "1",
        "europe-west": "1",
        "europe-central": "1",
        "america-east": "1",
        "america-west": "1",
        "asia-southeast": "1"
      },
      "machine_types": {
        "micro": "Standard_F1als_v7",
        "small": "Standard_F2als_v7"
      },
      "disk_types": {
        "balanced": "StandardSSD_LRS"
      },
      "images": {
        "default": {
          "ubuntu-2404": "Canonical:ubuntu-24_04-lts:server:latest",
          "ubuntu-2204": "Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest"
        },
        "europe-west": {
          "ubuntu-2404": "Canonical:ubuntu-24_04-lts:server:latest",
          "ubuntu-2204": "Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest"
        },
        "europe-central": {
          "ubuntu-2404": "Canonical:ubuntu-24_04-lts:server:latest",
          "ubuntu-2204": "Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest"
        },
        "america-east": {
          "ubuntu-2404": "Canonical:ubuntu-24_04-lts:server:latest",
          "ubuntu-2204": "Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest"
        },
        "america-west": {
          "ubuntu-2404": "Canonical:ubuntu-24_04-lts:server:latest",
          "ubuntu-2204": "Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest"
        },
        "asia-southeast": {
          "ubuntu-2404": "Canonical:ubuntu-24_04-lts:server:latest",
          "ubuntu-2204": "Canonical:0001-com-ubuntu-server-jammy:22_04-lts-gen2:latest"
        }
      },
      "network": {
        "management_subnet_cidr": "10.2.0.0/28",
        "workload_subnet_cidr": "10.2.1.0/26",
        "vnet_cidr": "10.2.0.0/16"
      }
    }
  },
  "environment": "dev",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/29",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [
      80,
      443
    ]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432,
    "rabbitmq": 5672
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "machine_type": "micro",
      "image": "ubuntu-2404",
      "internal_ip": "10.0.0.2",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "bastion"
      ],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ],
      "internal_ips": {
        "aws": "10.0.0.10",
        "azure": "10.2.0.10",
        "gcp": "10.1.0.10"
      }
    },
    "k3s-server-1": {
      "role": "k3s",
      "k3s_role": "server",
      "k3s_bootstrap": true,
      "machine_type": "small",
      "image": "ubuntu-2404",
      "internal_ip": "10.0.1.10",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "k3s",
        "k3s-server"
      ],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "RABBITMQ_PASSWORD": "example-rabbitmq-password",
        "REDIS_PASSWORD": "example-redis-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "internal_ips": {
        "aws": "10.0.1.10",
        "azure": "10.2.1.10",
        "gcp": "10.1.1.10"
      }
    },
    "k3s-server-2": {
      "role": "k3s",
      "k3s_role": "server",
      "k3s_bootstrap": false,
      "machine_type": "small",
      "image": "ubuntu-2404",
      "internal_ip": "10.0.1.11",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "k3s",
        "k3s-server"
      ],
      "secret_mappings": {},
      "internal_ips": {
        "aws": "10.0.1.11",
        "azure": "10.2.1.11",
        "gcp": "10.1.1.11"
      }
    },
    "k3s-server-3": {
      "role": "k3s",
      "k3s_role": "server",
      "k3s_bootstrap": false,
      "machine_type": "small",
      "image": "ubuntu-2404",
      "internal_ip": "10.0.1.12",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": [
        "k3s",
        "k3s-server"
      ],
      "secret_mappings": {},
      "internal_ips": {
        "aws": "10.0.1.12",
        "azure": "10.2.1.12",
        "gcp": "10.1.1.12"
      }
    },
    "k3s-agent-1": {
      "role": "k3s",
      "k3s_role": "agent",
      "k3s_bootstrap": false,
      "machine_type": "micro",
      "image": "ubuntu-2404",
      "internal_ip": "10.0.1.13",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": [
        "k3s",
        "k3s-agent",
        "k3s-ingress"
      ],
      "secret_mappings": {},
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      },
      "internal_ips": {
        "aws": "10.0.1.13",
        "azure": "10.2.1.13",
        "gcp": "10.1.1.13"
      }
    }
  },
  "database": {
    "cloud": "gcp",
    "kubernetes_region": "default"
  },
  "tailscale": {
    "enabled": false,
    "manage_policy": false,
    "tag": "tag:oilscope",
    "auth_key_expiry_seconds": 3600
  },
  "headlamp": {
    "enabled": false
  },
  "technitium": {
    "enabled": false,
    "configure_coredns": true
  },
  "homepage": {
    "enabled": false
  }
}
