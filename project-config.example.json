{
  "default_cloud": "gcp",
  "environment": "dev",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "network": {
    "ui_public_ports": [80, 443]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "clouds": {
    "gcp": {
      "project_id": "example-project-12345",
      "region": "europe-west1",
      "zone": "europe-west1-b",
      "subnets": {
        "management": "10.0.0.0/29",
        "workload": "10.0.1.0/26"
      },
      "machine_sizes": {
        "tiny": "e2-micro",
        "small": "e2-small",
        "medium": "e2-medium",
        "large": "e2-standard-2"
      },
      "disk_types": {
        "standard": "pd-standard",
        "balanced": "pd-balanced",
        "fast": "pd-ssd"
      },
      "images": {
        "ubuntu-lts": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64"
      }
    },
    "aws": {
      "region": "eu-central-1",
      "zone": "eu-central-1a",
      "subnets": {
        "management": "10.1.0.0/28",
        "workload": "10.1.1.0/26"
      },
      "machine_sizes": {
        "tiny": "t3.micro",
        "small": "t3.small",
        "medium": "t3.medium",
        "large": "t3.large"
      },
      "disk_types": {
        "standard": "standard",
        "balanced": "gp3",
        "fast": "io2"
      },
      "images": {
        "ubuntu-lts": "ami-0123456789abcdef0"
      }
    }
  },
  "vms": {
    "bastion-gcp": {
      "role": "bastion",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.0.2",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    },
    "bastion-aws": {
      "cloud": "aws",
      "role": "bastion",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.1.0.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "secret_mappings": {},
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"]
    },
    "infra": {
      "role": "database",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.2",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["infra"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "size": "small",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.3",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["history"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.4",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": false,
      "network_tags": ["fetcher"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "size": "tiny",
      "image": "ubuntu-lts",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10,
        "type": "balanced"
      },
      "assign_public_ip": true,
      "network_tags": ["ui"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
