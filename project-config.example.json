{
  "default_cloud": "gcp",
  "region": "eu-central",
  "environment": "dev",
  "name_prefix": "oilscope",

  "size_map": {
    "micro":  { "gcp": "e2-micro",      "aws": "t3.micro" },
    "small":  { "gcp": "e2-small",      "aws": "t3.small" },
    "medium": { "gcp": "e2-medium",     "aws": "t3.medium" },
    "large":  { "gcp": "e2-standard-2", "aws": "t3.large" }
  },

  "region_map": {
    "eu-central": {
      "gcp": { "region": "europe-central2", "zone": "europe-central2-a" },
      "aws": { "region": "eu-central-1", "availability_zone": "eu-central-1a" }
    }
  },

  "disk_type_map": {
    "standard": { "gcp": "pd-standard", "aws": "gp3" },
    "balanced": { "gcp": "pd-balanced", "aws": "gp3" },
    "ssd":      { "gcp": "pd-ssd",      "aws": "io2" }
  },

  "image_map": {
    "ubuntu-26.04": {
      "gcp": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64",
      "aws": "/aws/service/canonical/ubuntu/server/26.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
    }
  },

  "clouds": {
    "gcp": { "project_id": "example-project-12345" },
    "aws": { "vpc_cidr": "10.0.0.0/16" }
  },

  "network": {
    "management_subnet_cidr": "10.0.0.0/29",
    "workload_subnet_cidr": "10.0.1.0/26",
    "ui_public_ports": [80, 443]
  },

  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },

  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_sha": "0123456789abcdef0123456789abcdef01234567"
  },

  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },

  "vms": {
    "bastion": {
      "role": "bastion",
      "size": "micro",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.0.2",
      "assign_public_ip": true,
      "network_tags": ["bastion"],
      "ssh_port": 8787,
      "allowed_cidrs": ["192.0.2.10/32"],
      "secret_mappings": {}
    },
    "infra": {
      "role": "database",
      "size": "micro",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.1.2",
      "assign_public_ip": false,
      "network_tags": ["infra"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "history": {
      "role": "history",
      "size": "small",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.1.3",
      "assign_public_ip": false,
      "network_tags": ["history"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "fetcher": {
      "role": "fetcher",
      "size": "micro",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.1.4",
      "assign_public_ip": false,
      "network_tags": ["fetcher"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "OILPRICEAPI_KEY": "example-api-key",
        "GHCR_TOKEN": "example-ghcr-token"
      }
    },
    "ui": {
      "role": "ui",
      "size": "micro",
      "image": "ubuntu-26.04",
      "disk_type": "balanced",
      "disk_size_gb": 10,
      "internal_ip": "10.0.1.5",
      "assign_public_ip": true,
      "network_tags": ["ui"],
      "secret_mappings": {
        "POSTGRES_PASSWORD": "example-db-password",
        "GHCR_TOKEN": "example-ghcr-token"
      },
      "public_endpoint": {
        "hostname": "oilscope.example.com",
        "acme_email": "example-operator@example.com"
      }
    }
  }
}
