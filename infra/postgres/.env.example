# infra/postgres stack configuration (Postgres + Redis + RabbitMQ).
# Copy to .env and adjust for local development.
# Never commit a real .env file.

# --- PostgreSQL ---
POSTGRES_USER=skyivano
POSTGRES_PASSWORD=changeme
POSTGRES_DB=skyivano
POSTGRES_TEST_DB=skyivano_test

# --- Redis (UI session state only -- see docs/architecture.md) ---
REDIS_PASSWORD=changeme

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=skyivano
RABBITMQ_DEFAULT_PASS=changeme
