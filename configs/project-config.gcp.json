{
  "schema_version": 1,
  "cloud_provider": "gcp",
  "data_profile": "managed",
  "deployment_runtime": "compose",
  "default_cloud": "gcp",
  "manage_db": true,
  "defaults": {
    "location_profile": "primary",
    "machine_profile": "micro",
    "image_profile": "ubuntu",
    "disk_profile": "balanced",
    "architecture": "amd64"
  },
  "clouds": {
    "gcp": {
      "project_id": "shiphappens-dev",
      "locations": {
        "primary": {
          "region": "europe-west1",
          "zone": "europe-west1-b"
        }
      },
      "machine_types": {
        "micro": "e2-micro",
        "small": "e2-small"
      },
      "disk_types": {
        "balanced": "pd-balanced",
        "standard": "pd-standard",
        "ssd": "pd-ssd"
      },
      "images": {
        "ubuntu": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2404-lts-amd64"
      }
    },
    "aws": {
      "locations": {
        "primary": {
          "region": "eu-west-1",
          "zone": "eu-west-1a"
        }
      },
      "machine_types": {
        "micro": "t3.micro",
        "small": "t3.small"
      },
      "disk_types": {
        "balanced": "gp3",
        "standard": "gp2",
        "ssd": "io2"
      },
      "images": {
        "ubuntu": "ubuntu-lts"
      },
      "bastion_nat": true,
      "free_tier_guardrails": true
    }
  },
  "environment": "dev",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "observability": {
    "enabled": true,
    "alert_email": "o.m.zakip@gmail.com",
    "monthly_budget_usd": 20,
    "synthetic_url": "https://shiphappens.pp.ua",
    "log_retention_days": 14
  },
  "ssh_users": {
    "ubuntu": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOuHUOVp9DXJqpuqtPrw012XyiKWhMpJmZ5ZU8Fadmmd dadayaalex@gmail.com"
  },
  "registry": {
    "repository": "ghcr.io/ua-academy-projects/push-and-pray",
    "username": "example-operator",
    "image_sha": "7075d4610949ab6852c90e2ac63a50d2ec4c3a41"
  },
  "network": {
    "vpc_cidr": "10.0.0.0/16",
    "management_subnet_cidr": "10.0.0.0/28",
    "workload_subnet_cidr": "10.0.1.0/26",
    "public_subnet_cidr": "10.0.2.0/28",
    "ui_public_ports": [
      80,
      443
    ],
    "database_subnet_cidrs": [
      "10.0.3.0/28",
      "10.0.4.0/28"
    ],
    "database_availability_zones": [
      "eu-west-1a",
      "eu-west-1b"
    ],
    "database_private_service_cidr": "10.10.0.0/24"
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432,
    "rabbitmq": 5672,
    "redis": 6379
  },
  "secrets_by_role": {
    "database": {
      "POSTGRES_PASSWORD": "db-password"
    },
    "history": {
      "POSTGRES_PASSWORD": "db-password",
      "RABBITMQ_PASSWORD": "rabbitmq-password",
      "REDIS_PASSWORD": "redis-password"
    },
    "fetcher": {
      "POSTGRES_PASSWORD": "db-password",
      "RABBITMQ_PASSWORD": "rabbitmq-password",
      "OILPRICEAPI_KEY": "oilpriceapi-key"
    },
    "ui": {
      "POSTGRES_PASSWORD": "db-password",
      "REDIS_PASSWORD": "redis-password"
    }
  },
  "vms": {
    "bastion": {
      "role": "bastion",
      "internal_ip": "10.0.0.4",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": true,
      "network_tags": [
        "bastion"
      ],
      "ssh_port": 8787,
      "allowed_cidrs": [
        "192.0.2.10/32"
      ]
    },
    "history": {
      "role": "history",
      "machine_profile": "small",
      "internal_ip": "10.0.1.5",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": false,
      "network_tags": [
        "history"
      ]
    },
    "fetcher": {
      "role": "fetcher",
      "internal_ip": "10.0.1.6",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": false,
      "network_tags": [
        "fetcher"
      ]
    },
    "ui": {
      "role": "ui",
      "internal_ip": "10.0.1.7",
      "boot_disk": {
        "size_gb": 10
      },
      "assign_public_ip": true,
      "network_tags": [
        "ui"
      ],
      "public_endpoint": {
        "hostname": "shiphappens.pp.ua",
        "acme_email": "o.m.zakip@gmail.com"
      }
    }
  },
  "database": {
    "cloud": "gcp",
    "engine": "postgres",
    "engine_version": "POSTGRES_16",
    "database_name": "oil_tracker",
    "username": "oil_tracker",
    "password_secret_id": "db-password",
    "port": 5432,
    "generation": "2026-09",
    "backup_on_delete": false,
    "backups_enabled": false,
    "deletion_protection": false,
    "restore": null,
    "aws": {
      "instance_class": "db.t4g.micro",
      "allocated_storage_gb": 20,
      "multi_az": false
    },
    "gcp": {
      "tier": "db-f1-micro",
      "disk_size_gb": 10,
      "availability_type": "ZONAL"
    }
  },
  "managed_services": {
    "rabbitmq_username": "oil_tracker",
    "rabbitmq_vhost": "oil_tracker",
    "rabbitmq_queue": "history.price-observations",
    "redis": {
      "source_image": "redis:7.4.6-alpine@sha256:3b73847e72874be07e6657b129a94761662b79bc0f679273757d4218573b2a98",
      "target_tag": "7.4.6-alpine-3b73847e7287"
    },
    "rabbitmq": {
      "source_image": "rabbitmq:4.1.4-management-alpine@sha256:5cbd7145b0306399ad68422c3350b6cbd1bb95704b39f5896480e5b6d4238a04",
      "target_tag": "4.1.4-management-alpine-5cbd7145b030"
    }
  }
}
