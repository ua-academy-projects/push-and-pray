# API Fetcher container
API_FETCHER_HOST=127.0.0.1
API_FETCHER_PORT=8000
INTERNAL_API_TOKEN=change-me
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=300

# History Service container
BACKEND_SERVICE_HOST=127.0.0.1
BACKEND_SERVICE_PORT=8081
DATABASE_URL=postgres://rates:rates@127.0.0.1:5432/rates?sslmode=disable
STARTUP_BACKFILL_ENABLED=true
STARTUP_BACKFILL_MAX_DAYS=365
STARTUP_BACKFILL_BATCH_SIZE=20

# RabbitMQ contracts
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EVENTS_EXCHANGE=rates.events
RABBITMQ_OBSERVATIONS_QUEUE=rates.observations
RABBITMQ_OBSERVATION_ROUTING_KEY=observation.collected
RABBITMQ_COMMANDS_EXCHANGE=rates.commands
RABBITMQ_COMMANDS_QUEUE=rates.fetch.commands
RABBITMQ_COMMAND_ROUTING_KEY=backfill.requested

# Redis remains on the messaging VM and must never store rate observations
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# UI container
UI_HOST=127.0.0.1
UI_PORT=3000
UI_HTTPS_HOST_PORT=8443

# Shared logging
LOG_LEVEL=INFO

# Optional explicit target for scripts/backfill-year.sh
API_FETCHER_URL=
