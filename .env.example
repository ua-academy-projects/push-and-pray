OILPRICEAPI_KEY=replace-me
DATA_PROVIDER=oilpriceapi
FETCH_CRON_HOURS=0,6,12,18
FETCH_TIMEZONE=UTC
FETCH_ON_STARTUP=true
REQUEST_TIMEOUT_SECONDS=15

DATABASE_URL=postgresql+psycopg://oil_tracker:change-me@127.0.0.1:5432/oil_tracker
HISTORY_SERVICE_URL=http://127.0.0.1:8001

# pgmq keeps the queue inside PostgreSQL; amqp moves it to RabbitMQ.
QUEUE_BACKEND=pgmq
PGMQ_QUEUE=price_observations
PGMQ_VISIBILITY_TIMEOUT_SECONDS=60
PGMQ_POLL_INTERVAL_SECONDS=1
PGMQ_MAX_ATTEMPTS=5
AMQP_URL=amqp://oil_tracker:change-me@127.0.0.1:5672/oil_tracker
AMQP_EXCHANGE=oil.price.events
AMQP_QUEUE=history.price-observations
AMQP_ROUTING_KEY=prices.observed
AMQP_MAX_ATTEMPTS=5

# postgres keeps UI sessions inside PostgreSQL; redis moves them to Redis.
SESSION_BACKEND=postgres
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false
LISTEN_ADDRESS=:8002
LOG_LEVEL=INFO
