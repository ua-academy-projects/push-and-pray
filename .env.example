# Network
AIRAWARE_NETWORK_PREFIX=192.168.18
AIRAWARE_NETMASK=255.255.255.0
AIRAWARE_BRIDGE_ADAPTER=Intel(R) Wi-Fi 6 AX200 160MHz

# PostgreSQL
AIRAWARE_DB_NAME=airaware
AIRAWARE_DB_USER=airaware_user
AIRAWARE_DB_PASSWORD=replace-me

# Redis
AIRAWARE_REDIS_PASSWORD=replace-me

# RabbitMQ
AIRAWARE_RABBITMQ_USER=airaware
AIRAWARE_RABBITMQ_PASSWORD=replace-me
AIRAWARE_RABBITMQ_VHOST=airaware

# Frontend
AIRAWARE_FLASK_SECRET_KEY=replace-me

# SSH
AIRAWARE_SSH_USER=airaware
AIRAWARE_SSH_PUBLIC_KEY_PATH=path-to-public-key