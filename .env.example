OILPRICEAPI_KEY=replace-me
DATA_PROVIDER=oilpriceapi
FETCH_CRON_HOURS=0,6,12,18
FETCH_TIMEZONE=UTC
FETCH_ON_STARTUP=true
REQUEST_TIMEOUT_SECONDS=15

DATABASE_URL=postgresql+psycopg://oil_tracker:change-me@127.0.0.1:5432/oil_tracker
HISTORY_SERVICE_URL=http://127.0.0.1:8001
RABBITMQ_URL=amqp://oil_tracker:change-me@127.0.0.1:5672/oil_tracker
RABBITMQ_EXCHANGE=oil.price.events
RABBITMQ_QUEUE=history.price-observations
RABBITMQ_ROUTING_KEY=prices.observed
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SECURE=false
LISTEN_ADDRESS=:8002
LOG_LEVEL=INFO
