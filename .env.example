# Backend bind address used by start-all.sh
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Exact browser origin allowed by Backend CORS
UI_ORIGIN=http://127.0.0.1:3000
# Internal Backend -> History connection
HISTORY_SERVICE_URL=http://127.0.0.1:8081
HISTORY_SERVICE_TOKEN=change-me
# Public providers; CoinGecko key is optional but recommended
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
# Backend background collection; minimum effective interval is 60 seconds
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=300
# Owned and used only by History service/migration tooling
DATABASE_URL=postgres://rates:rates@127.0.0.1:5432/rates?sslmode=disable
HISTORY_HOST=127.0.0.1
HISTORY_PORT=8081
# Static UI server started by start-all.sh
UI_HOST=127.0.0.1
UI_PORT=3000
# Optional annual provider backfill during automatic startup
BACKFILL_YEAR_ON_START=0
LOG_LEVEL=INFO
# Local orchestration settings used only by scripts/start-all.sh
POSTGRES_BIN_DIR=/opt/homebrew/opt/postgresql@16/bin
SERVICE_CHECK_TIMEOUT_SECONDS=1
SERVICE_START_ATTEMPTS=40
SERVICE_START_INTERVAL_SECONDS=0.25
SERVICE_STOP_ATTEMPTS=20
SERVICE_STOP_INTERVAL_SECONDS=0.25
