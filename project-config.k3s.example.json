{
  "$schema": "./project-config.schema.json",
  "environment": "dev",
  "deployment_mode": "k3s",
  "default_cloud": "gcp",
  "default_location": "stockholm",
  "name_prefix": "oilscope",
  "common_labels": {
    "project": "example-oil-price-tracker",
    "team": "example-team"
  },
  "ssh_users": {
    "example-operator": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyOnly000000000000000 example-operator"
  },
  "registry": {
    "repository": "ghcr.io/example-org/example-project",
    "username": "example-operator",
    "image_tag": "v1.0.0"
  },
  "database": {
    "mode": "self_managed"
  },
  "k3s": {
    "version": "v1.37.0+k3s1",
    "api_server": {
      "internal_ip": "10.20.1.5",
      "port": 6443
    },
    "cluster_cidr": "10.42.0.0/16",
    "service_cidr": "10.43.0.0/16",
    "cluster_dns": "10.43.0.10",
    "flannel_backend": "vxlan",
    "application": {
      "namespace": "oilscope",
      "hostname": "oilscope.example.com",
      "acme_email": "example-operator@example.com"
    },
    "data_services": {
      "postgresql": {
        "instances": 2,
        "storage_gb": 10
      }
    },
    "secret_mappings": {
      "POSTGRES_PASSWORD": "example-db-password",
      "OILPRICEAPI_KEY": "example-api-key",
      "GHCR_TOKEN": "example-ghcr-token"
    }
  },
  "network": {
    "vpc_cidr": "10.20.0.0/16",
    "public_subnet_cidr": "10.20.0.0/24",
    "private_subnet_cidr": "10.20.1.0/24",
    "ui_public_ports": [80, 443]
  },
  "service_ports": {
    "history_api": 8001,
    "postgresql": 5432
  },
  "bastion": {
    "machine_type": "micro",
    "image": "ubuntu_2604",
    "internal_ip": "10.20.0.4",
    "boot_disk": {
      "size_gb": 10,
      "disk_type": "general_purpose"
    },
    "ssh_port": 8787,
    "allowed_cidrs": ["192.0.2.10/32"]
  },
  "vms": {
    "server-1": {
      "machine_type": "small",
      "image": "ubuntu_2604",
      "internal_ip": "10.20.1.10",
      "boot_disk": {
        "size_gb": 32,
        "disk_type": "performance"
      },
      "assign_public_ip": false,
      "tags": ["k3s-server"],
      "secret_mappings": {
        "K3S_TOKEN": "example-k3s-token"
      }
    },
    "server-2": {
      "machine_type": "small",
      "image": "ubuntu_2604",
      "internal_ip": "10.20.1.11",
      "boot_disk": {
        "size_gb": 32,
        "disk_type": "performance"
      },
      "assign_public_ip": false,
      "tags": ["k3s-server"],
      "secret_mappings": {
        "K3S_TOKEN": "example-k3s-token"
      }
    },
    "server-3": {
      "machine_type": "small",
      "image": "ubuntu_2604",
      "internal_ip": "10.20.1.12",
      "boot_disk": {
        "size_gb": 32,
        "disk_type": "performance"
      },
      "assign_public_ip": false,
      "tags": ["k3s-server"],
      "secret_mappings": {
        "K3S_TOKEN": "example-k3s-token"
      }
    },
    "agent-1": {
      "machine_type": "small",
      "image": "ubuntu_2604",
      "internal_ip": "10.20.1.20",
      "boot_disk": {
        "size_gb": 32,
        "disk_type": "general_purpose"
      },
      "assign_public_ip": false,
      "tags": ["k3s-agent"],
      "secret_mappings": {
        "K3S_TOKEN": "example-k3s-token"
      }
    },
    "agent-2": {
      "machine_type": "small",
      "image": "ubuntu_2604",
      "internal_ip": "10.20.1.21",
      "boot_disk": {
        "size_gb": 32,
        "disk_type": "general_purpose"
      },
      "assign_public_ip": false,
      "tags": ["k3s-agent"],
      "secret_mappings": {
        "K3S_TOKEN": "example-k3s-token"
      }
    }
  },
  "cloud_settings": {
    "gcp": {
      "project_id": "example-project-12345"
    }
  },
  "locations": {
    "west-europe": {
      "gcp": {
        "region": "europe-west4",
        "zone": "europe-west4-a"
      },
      "aws": {
        "region": "eu-west-3",
        "zone": "eu-west-3a"
      },
      "azure": {
        "region": "westeurope"
      }
    },
    "stockholm": {
      "gcp": {
        "region": "europe-north2",
        "zone": "europe-north2-b"
      },
      "aws": {
        "region": "eu-north-1",
        "zone": "eu-north-1a"
      },
      "azure": {
        "region": "swedencentral"
      }
    },
    "ohio": {
      "gcp": {
        "region": "us-east5",
        "zone": "us-east5-a"
      },
      "aws": {
        "region": "us-east-2",
        "zone": "us-east-2a"
      },
      "azure": {
        "region": "eastus",
        "zone": "1"
      }
    },
    "mexico": {
      "gcp": {
        "region": "northamerica-south1",
        "zone": "northamerica-south1-a"
      },
      "aws": {
        "region": "mx-central-1",
        "zone": "mx-central-1a"
      },
      "azure": {
        "region": "mexicocentral",
        "zone": "2"
      }
    }
  },
  "machine_types": {
    "micro": {
      "gcp": "e2-micro",
      "aws": "t3.micro",
      "azure": "Standard_B2ats_v2"
    },
    "small": {
      "gcp": "e2-small",
      "aws": "t3.small",
      "azure": "Standard_B2als_v2"
    },
    "medium": {
      "gcp": "e2-medium",
      "aws": "t3.medium",
      "azure": "Standard_B2as_v2"
    }
  },
  "images": {
    "ubuntu_2404": {
      "gcp": {
        "project": "ubuntu-os-cloud",
        "family": "ubuntu-2404-lts-amd64"
      },
      "aws": {
        "ssm_parameter": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
      },
      "azure": {
        "publisher": "Canonical",
        "offer": "ubuntu-24_04-lts",
        "sku": "server",
        "version": "latest"
      }
    },
    "ubuntu_2604": {
      "gcp": {
        "project": "ubuntu-os-cloud",
        "family": "ubuntu-2604-lts-amd64"
      },
      "aws": {
        "ssm_parameter": "/aws/service/canonical/ubuntu/server/26.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
      },
      "azure": {
        "publisher": "Canonical",
        "offer": "ubuntu-26_04-lts",
        "sku": "server",
        "version": "latest"
      }
    }
  },
  "disk_types": {
    "general_purpose": {
      "gcp": {
        "type": "pd-balanced"
      },
      "aws": {
        "type": "gp3"
      },
      "azure": {
        "type": "StandardSSD_LRS"
      }
    },
    "performance": {
      "gcp": {
        "type": "pd-ssd"
      },
      "aws": {
        "type": "io2",
        "iops": 7000
      },
      "azure": {
        "type": "Premium_LRS"
      }
    }
  }
}
